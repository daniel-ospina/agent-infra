#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# agent-infra version gate — block commits if .agent-infra-version is behind
AGENT_INFRA_MANIFEST="${AGENT_INFRA_PATH:-}/manifest.json"
VERSION_FILE=".agent-infra-version"

check_version() {
  if [ -z "${AGENT_INFRA_PATH:-}" ]; then
    echo "[agent-infra] AGENT_INFRA_PATH not set — skipping version gate"
    return 0
  fi
  if [ ! -f "$AGENT_INFRA_MANIFEST" ]; then
    echo "[agent-infra] manifest.json not found at $AGENT_INFRA_MANIFEST — skipping version gate"
    return 0
  fi
  if [ ! -f "$VERSION_FILE" ]; then
    echo "[agent-infra] .agent-infra-version not found — skipping version gate (first time?)"
    return 0
  fi

  PINNED=$(cat "$VERSION_FILE" | tr -d '[:space:]')
  CURRENT=$(node -e "console.log(require('$AGENT_INFRA_MANIFEST').version)" | tr -d '[:space:]')

  if [ "$PINNED" != "$CURRENT" ]; then
    echo ""
    echo "⛔ [agent-infra] Version mismatch!"
    echo "   Pinned (.agent-infra-version): $PINNED"
    echo "   Current (manifest.json):       $CURRENT"
    echo "   Run: cd $AGENT_INFRA_PATH && node bin/agent-infra.js update"
    echo "   Or update .agent-infra-version to match."
    echo ""
    exit 1
  fi
  echo "[agent-infra] Version gate: $CURRENT ✓"
}

check_version

# #254 Task 0 — authoring-time frontmatter gate for staged SKILL.md files
# (pi's real loader; throws/drop-via-description/BOM). SKIPs visibly when pi
# is not installed — a missing local pi must not block commits.
if command -v node >/dev/null 2>&1 && [ -f scripts/check-staged-skill-frontmatter.mjs ]; then
  node scripts/check-staged-skill-frontmatter.mjs || exit 1
fi

# #341 — cost-config drift guard (shipped configs only; the live pass runs at
# sync.sh). Blocks commits that revert the deepseek clamp or the settings
# compaction/retry contract.
if [ -f scripts/check-cost-config.sh ]; then
  bash scripts/check-cost-config.sh --shipped-only || exit 1
fi

# #498/#502 — pi-config extension-farm parity gate (issue #95 invariant):
# every extensions/ top-level entry except *.test.ts must be farm-wired into
# pi-bootstrap/pi-config/extensions (single source of truth) AND listed in
# manifest.json files.extensions.entries (consumer ship-list, #502). Blocks
# commits that add an extension without wiring it — unwired extensions ship on
# NO machine and unlisted ones reach NO consumer. Repo-tree only; no live
# ~/.pi/agent dependency.
if [ -f scripts/check-pi-config-extensions.sh ]; then
  bash scripts/check-pi-config-extensions.sh || exit 1
fi

# Only run lint-staged if this is a Node.js project (has package.json)
if [ -f package.json ] && command -v npx >/dev/null 2>&1; then
  npx lint-staged
fi
