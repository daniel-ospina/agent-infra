# Resend (email outreach)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# SERP Scraping — use in order: Oxylabs trial → Serper trial → SerpAPI free
SERPAPI_KEY=your_serpapi_key
OXYLABS_USERNAME=your_username
OXYLABS_PASSWORD=your_password
SERPER_API_KEY=your_serper_key

# Google APIs
GOOGLE_API_KEY=your_google_api_key

# Google Search Console (GSC) — required for gsc_* MCP tools
# (gsc_query_analytics, gsc_near_ranking, gsc_low_ctr, gsc_page_opportunities, gsc_inspect_url)
# Setup guide: see README.md in this directory → "Setup".
#
# IMPORTANT: OAuth app publishing status must be "In production" (NOT "Testing").
# Testing mode causes Google to revoke the refresh token after 7 days.
#
# These are LOCAL secrets — never commit this file (it is gitignored).
# They live only in this file (mcp-servers/seo-intelligence/.env).
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
# Generate via: cd "$AGENT_INFRA_PATH/mcp-servers/seo-intelligence" && npm run auth:search-console
GOOGLE_REFRESH_TOKEN=obtain_via_auth_script

# HubSpot
HUBSPOT_SERVICE_KEY=your_hubspot_key

# Defaults — set per deployment. Leave DEFAULT_GEO_LOCATION empty to disable geo bias.
DEFAULT_SITE_URL=https://example.com
DEFAULT_GEO_LOCATION=
