 const CONTEXT_SAFETY_TOKENS = 4096;
 const MIN_MAX_TOKENS = 1;
 
+/**
+ * Smallest output budget worth asking for.
+ *
+ * Below this a response cannot be a usable answer, so the request goes out with this budget
+ * instead and the PROVIDER rejects it if the prompt really is too long. That trade is
+ * deliberate: a provider rejection is a loud, recoverable `stopReason: "error"` that the
+ * overflow path already handles, whereas asking for a single token produces
+ * `stopReason: "length"` with `output: 1` — a turn that looks normal, is accounted as a
+ * normal turn, and leaves the session alive but unable to ever reply again.
+ *
+ * The headroom behind this is measured, not assumed: pi's own ceiling
+ * (`contextWindow - CONTEXT_SAFETY_TOKENS`) sits far below what providers accept — one of our
+ * routes served a 988,202-token prompt while pi was asking for 1 token. Overshooting the
+ * context-derived budget by at most this many tokens is therefore rejected only when the
+ * request genuinely exceeds the provider's limit, which is the outcome we want.
+ */
+export const MIN_USABLE_MAX_TOKENS = 1024;
+
 export function clampMaxTokensToContext(model: Model<Api>, context: TranscriptContext, maxTokens: number): number {
 	if (model.contextWindow <= 0) return Math.max(MIN_MAX_TOKENS, maxTokens);
 	const available = model.contextWindow - estimateContextTokens(context).tokens - CONTEXT_SAFETY_TOKENS;
-	return Math.min(maxTokens, Math.max(MIN_MAX_TOKENS, available));
+	// No usable output budget left against pi's own estimate: ask for the floor and let the
+	// provider reject an over-long request. Never silently ask for a single token.
+	if (available < MIN_USABLE_MAX_TOKENS) {
+		return Math.max(MIN_MAX_TOKENS, Math.min(maxTokens, MIN_USABLE_MAX_TOKENS));
+	}
+	return Math.min(maxTokens, available);
 }
 
