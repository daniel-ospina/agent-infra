node_modules/
dist/
*.log
.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# worktrees (parallel agent isolation)
.worktrees/

# a lane's per-worktree interpreter. Created by `uv sync` / `python -m venv` inside the worktree,
# so it is a local build artifact: unignored it sat one `git add` from being committed.
.venv/

# #907 — scripts/daily-backup.sh writes RDB snapshots of the fleet's graph here. An RDB dump
# is a data artifact, never source: leaving it unignored puts it one `git add` from being
# committed into a public repo.
backups/

# hub hygiene (#338): transient e2e artifacts + husky runtime —
# these kept the M4 hub gate permanently active from the hub cwd
# rift-debug e2e nested clone (temp-dir origin)
clone/
# transient e2e markers (tmp/e2e-*)
tmp/
# husky v9 runtime dir (mirrors tortoise .gitignore)
.husky/_/

# drift-check test fixtures — the version pin is test state, never committed
# (tests/drift/run.sh writes it; consumers commit their own real pins)
tests/fixtures/drift/*/.agent-infra-version

# #254 — oracle drift-lock runtime timestamp (dev-machine cron state)
.last-oracle-run
scripts/heartbeats/

# #10220 (owner ruling 2026-10-28): a lane's MANDATORY per-lane report — "every lane writes
# WORKTREE-REPORT.md before it exits", and its files "are gitignored and never committed"
# (`docs/ops/disk-reaper.md`; `IGNORED_LANE_EVIDENCE` in `scripts/pi-reap-worktrees.sh`). Committing
# one is not merely untidy: the report is per-LANE state (it names one worktree and one branch), so in
# a repo that ships no `tools/worktree_report.py` — this one — `lane-report-gate.sh` reads its mere
# PRESENCE as `UNMEASURABLE reason=report-present-but-repo-ships-no-consumer`, an arm `lane-merge.sh`
# classifies as a BOX fault: it spends no fix round, and no lane can clear it by pushing. Measured:
# #4048 committed one to main on 2026-11-12 and every subsequent PR refused at rc=7 with no remedy.
.worktree-report/
WORKTREE-REPORT.md
