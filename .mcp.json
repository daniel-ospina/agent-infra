{
  "mcpServers": {
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      },
      "lazy": true,
      "idleTimeoutMs": 900000,
      "purpose": "Semantic search (Exa) — scholarly/semantic/entity discovery",
      "whenToLoad": "on demand — semantic/scholarly/prospect discovery only (#419)",
      "cost": "one light process; Perplexity is the primary source"
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@brave/brave-search-mcp-server"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "lazy": true,
      "purpose": "Web search (Brave)",
      "whenToLoad": "on demand",
      "cost": "one npx process"
    },
    "playwright-browser": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "lazy": true,
      "idleTimeoutMs": 900000,
      "purpose": "Browser automation (navigate/click/screenshot)",
      "whenToLoad": "verify/UX phases only",
      "cost": "~170MB pair while loaded"
    },
    "gemini": {
      "command": "npx",
      "args": [
        "-y",
        "@houtini/gemini-mcp"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      },
      "lazy": true,
      "purpose": "Image generation (Gemini)",
      "whenToLoad": "image/carousel tasks",
      "cost": "one npx process"
    },
    "tortoise": {
      "command": "python3",
      "args": [
        "-m",
        "tortoise.mcp_server"
      ],
      "cwd": "${TORTOISE_HOME:-${HOME}/Documents/GitHub/tortoise}",
      "env": {
        "PYTHONPATH": "${TORTOISE_HOME:-${HOME}/Documents/GitHub/tortoise}",
        "TORTOISE_DB_URI": "docker://:@localhost:16379/tortoise"
      }
    }
  }
}
