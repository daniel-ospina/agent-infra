[Unit]
# pr-doctor-trigger — the harness's REPAIR service (agent-infra#2700, child C5).
#
# WHY THIS UNIT EXISTS. The repair actuator was TIMER-driven. `pr-doctor` ran on a schedule, so it
# only saw the fleet at the instant the timer fired: a PR that turned red one second after a pass
# waited out the whole interval with no worker on it. On the Mac that interval was
# `StartInterval 1800`, measured — so the expected wait for a worker on a freshly-red PR was 900 s
# and the worst case 1800 s, for a repair whose own cost is one pass. THE LEAD WAS NOT THE REPAIR.
# IT WAS THE TIMER.
#
# So the service runs `scripts/pr-doctor-trigger.py`, NOT `pr-doctor.py` and not a shell loop: the
# trigger reads the PR surface with one `gh pr list` per `--poll` and starts the existing doctor the
# moment the surface changes. The old cadence is kept as `--backstop 1800` — deliberately, because
# some work is only visible on a clock (a check that never reports, a worker that dies silently, a
# stale claim) — but it is now the BACKSTOP rather than the thing that decides when work happens.
#
# ⛔ THE TRIGGER DECIDES NOTHING. It starts the doctor; the doctor owns every repair, every refusal
# and every budget. A unit that ran the trigger AND a doctor would be two actuators.
Description=eldato pr-doctor trigger — event-driven repair for the open PR surface (agent-infra#2700)
Documentation=https://github.com/daniel-ospina/agent-infra/blob/main/scripts/pr-doctor-trigger.py
# The trigger's first tick makes a `gh` call; offline that fails and the trigger LOGS it rather than
# pretending the surface is quiet, so this is ordering, not a hard dependency.
After=network-online.target
Wants=network-online.target
# ⛔ THE START LIMIT IS NAMED EXPLICITLY, because systemd's DEFAULT CANNOT FIRE HERE. The default
# window is 10 s and at most one start per RestartSec can occur, so `5-in-10s` is unreachable: a box
# that cannot start this for a CONFIGURATION reason (no `gh` auth, a missing trigger, a bad repo
# dir) would restart every RestartSec forever, re-reading GitHub on every attempt, with the failure
# living only in a journal. 3 failures in 5 minutes is a configuration fault and must converge to
# `failed`, which is what an operator can see and act on.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User={{USER}}
# HOME is the real home: the doctor's state dir (`~/.pi/agent/state`), its dispatch register and the
# fleet's `gh` auth all live there. A unit that reset HOME would run a doctor with no memory of what
# it already dispatched.
Environment=HOME={{HOME}}
Environment=PATH={{PATH}}
# The repo whose PR surface is watched. `pr-doctor` hardcodes its repo today (`REPO` at the top of
# `scripts/pr-doctor.py`); the lane that ports the seam (`fix/2700-objective-repo`) makes these three
# the ACTUAL input, and `pr-doctor`'s classifier reads `OBJECTIVE_REPO` at EXEC time — so the service
# carries the repo as an `Environment=` line rather than leaving it to whichever file happens to be
# checked out. That is the measured #2700 defect: the classifier asking about TORTOISE's check-runs
# with AGENT-INFRA SHAs (`422 No commit found for SHA` on all 58 PRs, every PR UNREADABLE, pass
# refused). The trigger exports the same three for its child, so this unit and the trigger agree.
Environment=GH_REPO={{GH_REPO}}
Environment=PR_DOCTOR_REPO={{GH_REPO}}
Environment=PR_DOCTOR_REPO_DIR={{REPO_DIR}}
Environment=OBJECTIVE_REPO={{GH_REPO}}
# ExecStart runs the TRIGGER. `--backstop 1800` is the demoted timer; `--poll` is the lead (a change
# is noticed within one poll) and `--debounce` is the coalescing window (a push fires several
# `updatedAt` moves; they must produce ONE pass, not five). `--state-dir` holds the lock and the
# remembered fingerprint, so a restart resumes rather than re-reading the surface as cold... except
# on the very first start, where COLD deliberately owes exactly one pass.
ExecStart={{PYTHON}} {{TRIGGER}} --repo {{GH_REPO}} --repo-dir {{REPO_DIR}} --poll {{POLL}} --debounce {{DEBOUNCE}} --backstop 1800 --max {{MAX}} --state-dir {{STATE_DIR}}
# ⛔ `always`, NOT `on-failure`. The measured case is an ORDERLY exit: the loop is stopped, or the
# process exits 0 on a `--once` invocation, and nothing came back — `on-failure` reproduces that
# defect byte for byte (#2402). `Restart=always` restarts on a crash, a kill AND a clean exit.
Restart=always
RestartSec={{RESTART_SEC}}
# `process`, not `mixed`: the doctor's workers are spawned through tmux and must NOT be SIGKILLed by
# this unit's cgroup when the trigger is restarted. Those workers are lanes in their own right.
# ⚠️ NAMED RESIDUAL, not a claim of mutual exclusion: `KillMode=process` signals only the main
# process, so a doctor that is mid-pass when the unit is restarted CAN outlive it (the trigger's
# flock dies with the trigger), and the next start may run a doctor of its own beside the old one.
# The mitigations are outside this unit: the doctor re-reads its per-PR state before acting, so a
# duplicate pass does not duplicate a worker, and the trigger's lock still prevents two TRIGGERS.
# "`mixed` would close it and is refused because it would SIGKILL every tmux lane on the box (#2402).
KillMode=process
TimeoutStopSec=30
# A trigger must never be quiet: journald keeps every `no change`, `throttled`, `DOCTOR-FAILED` and
# `PR-SURFACE-UNREADABLE` line with the exit status. No StandardOutput=null.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy={{WANTED_BY}}
