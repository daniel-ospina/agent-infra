[Unit]
# Every 20 minutes — the same cadence the macOS job uses (com.eldato.ai-drainer,
# StartInterval=1200), so the two platforms have ONE documented cadence and not two.
#
# ⛔ OnUnitActiveSec, NOT OnCalendar: the drainer holds its lock until the LANE it started dies, so a
# calendar tick can land mid-lane and skip. That is correct behaviour (a skip, logged as one), but a
# monotonic 20-minute interval measured from the LAST ACTIVATION keeps the next tick a fixed distance
# from the last real attempt instead of drifting into a burst of skipped ticks after a long lane.
Description=eldato ai-drainer every 20 minutes

[Timer]
OnBootSec=10min
OnUnitActiveSec=20min
# Persistent=true would re-run a missed tick after a reboot — but `on-unit-active` timers have no
# persistent stamp to restore, so it is deliberately NOT set (and setting it would be a claim this
# timer cannot keep).
Unit=eldato-ai-drainer.service

[Install]
WantedBy=timers.target
