[Unit]
# eldato disk reaper — the one scheduled pass over the three disk sinks (#2032).
#
# WHY A TIMER AND NOT A CONTROLLER TICK. The cell's controller loop already runs the package-cache
# pass hourly, but the venv and worktree classes were never on any clock: worktrees were reaped by a
# launchd job that only exists on macOS, and lane venvs had no periodic owner at all (agent-infra
# #1932). Disk exhaustion is the second reason the cloud cells stopped working — at ~97% used a
# `git worktree add` or `uv sync` fails, so a healthy controller cannot spawn a lane. A scheduler the
# bring-up installs is what makes the reaper run on a box nobody is logged into.
Description=eldato disk reaper — bound uv caches, reap dead lane venvs and merged worktrees
Documentation=https://github.com/daniel-ospina/agent-infra/blob/main/docs/ops/disk-reaper.md
After=local-fs.target
# A reaper must never hold up a boot or a login, and it must not be a reason to keep a box up.
DefaultDependencies=no

[Service]
Type=oneshot
User={{USER}}
Environment=HOME={{HOME}}
Environment=PATH={{PATH}}
Environment=DISK_REAPER_STATE_DIR={{STATE_DIR}}
Environment=DISK_REAPER_REPOS={{REPOS}}
Environment=DISK_REAPER_WT_AGED_DAYS={{AGED_DAYS}}
# The bounded-execution helper is PINNED for the same reason the delegates are: it is resolved from
# `$(dirname $0)/lib/`, and that arm is empty when the script is fed through a pipe (the macOS
# launcher does that, under TCC). A pin is authoritative and fails CLOSED at startup if it is gone,
# which is what a deletion tool wants.
Environment=BOUNDED_LIB={{BOUNDED_LIB}}
# ⛔ THE DELEGATES ARE PINNED TO THE INSTALLED COPY, not left to $HOME. find_delegate prefers
# $HOME/.pi/agent/scripts, so a unit whose HOME happens to contain an older farmed copy silently ran
# THAT policy instead of the one installed beside this unit — measured on pi-cell-3, where the
# worktree class failed with "not a git repository: /tmp/cell-t3" against a stale copy while the
# freshly-installed one was never consulted. A pin is authoritative and fails CLOSED if it is gone,
# which is the behaviour a deletion tool wants.
Environment=CACHE_REAPER={{REAPER_DIR}}/pi-cache-reap.sh
Environment=VENV_REAPER={{REAPER_DIR}}/reap-lane-venvs.sh
Environment=WORKTREE_REAPER={{REAPER_DIR}}/pi-reap-worktrees.sh
# The scheduled entry point is disk-reaper-run.sh; pin what it execs, so the wrapper's own
# location is never load-bearing (on the Darwin arm it runs under `bash -s`, where BASH_SOURCE
# is unset and it could not resolve a sibling).
Environment=DISK_REAPER={{REAPER_DIR}}/disk-reaper.sh
# The worktree owner must ask GitHub which PRs are open before it may delete anything.
# #2354: the scheduled pass queries the REAL gh (scripts/disk-reaper-run.sh), not the interactive
# pacing shim, so this bound only has to cover a slow API — not the shim's shared-slot wait. If the
# query still cannot answer, the class FAILS CLOSED (a checkout with an open PR is never guessed at)
# and the supervisor shows which class failed.
Environment=REAP_WT_GH_TIMEOUT=120
# #2542: the two owners of the classes that actually filled the cells (abandoned /tmp worktrees, and
# surplus copies of the same runner install). Pinned for the same reason as the three above.
Environment=ABANDONED_WT_REAPER={{REAPER_DIR}}/reap-abandoned-worktrees.sh
Environment=DUP_INSTALL_REAPER={{REAPER_DIR}}/reap-duplicate-installs.sh
# Never compete with a lane for CPU or I/O: the pass is a background sweep, not a deadline.
Nice=10
IOSchedulingClass=idle
# The pass writes its own bounded log under DISK_REAPER_STATE_DIR; journald keeps the exit status.
# {{MODE_FLAG}} is the ARMING DECISION, rendered by the installer (--apply by default; --report-only
# renders --dry-run). It is a placeholder and not a literal so that disarming this box is one
# documented verb instead of a hand-edit of an installed unit that the next bring-up silently reverts.
ExecStart=/bin/bash {{REAPER}} {{MODE_FLAG}}
# A pass that exits 3 (a class FAILED CLOSED — a delegate is missing, a probe could not answer, a
# cache could not be verified) or 4 (a class completed but at least one removal FAILED) must not look
# like success to `systemctl start`.
# ⛔ AND NEITHER MAY 5. An earlier directive also listed 4 and 5 as success, which made two real
# outcomes GREEN: 4 = "at least one removal FAILED" and 5 = "a class reported work it would do, so the
# condition is still present". Measured consequence (2026-10-18): the estate carried a "succeeding"
# hourly reaper on cells whose disks were at 94-96% used. An exit code that a unit file reclassifies as
# success is a silent failure, and a silent failure is the bug.
#
# 6 IS THE ONE GREEN NON-ZERO CODE, and it is deliberately narrow: a DELEGATE DEFERRED the pass — it
# ran, declined to act, and claimed nothing (another pass holds the lock, or a live tool holds the
# cache: pi-cache-reap.sh's 4 and 7). That is the routine state of a busy cell (#2036), so it must not
# go red hourly or the operator learns to ignore `systemctl --failed`. ⛔ It is NOT a delegate's 3:
# in all three owners 3 means "I could not do the work" (fail-closed), which stays RED — mapping 3 to
# green would make a permanently inert reaper read as a succeeding hourly job, the very inert-enforcer
# shape this unit exists to remove. Nothing is hidden by 6 either: the pass record still carries
# `ok=0 rc=6 verdict_<class>=deferred`, and `cloud-cell-supervisor.sh status` prints `⏸ … DEFERRED`
# (with `⛔` reserved for 3/4, and for a deferral whose record has gone stale — a dead timer must not
# read as a routine pause).
# ⚠️ 5 is NOT listed for the ARMED unit. It runs `--apply`, where a class over its bound is ranked with
# a fail-closed class and the pass exits 3 — listing 5 there would whitelist a condition that cannot
# occur on a healthy apply pass and would mask it if it ever did (the #2156 false-PASS shape). It IS
# listed for a `--report-only` render, where 5 is the pass saying "here is the work I would do": a dry
# run that finds work did its whole job, so reddening the unit for it would be a false red. That is why
# the accepted set is rendered as {{MODE_SUCCESS_EXIT}} rather than hard-coded.
# ⚠️ This deliberately does NOT follow issue #2036's literal proposal of `SuccessExitStatus=0 5 6`.
SuccessExitStatus={{MODE_SUCCESS_EXIT}}
# Auditability: journald keeps the pass's stdout/stderr with the exit status, and the pass ALSO
# writes $DISK_REAPER_STATE_DIR/disk-reaper.status (per-class bytes reclaimed) plus its bounded log.
# No `StandardOutput=null` and no `-` prefix on ExecStart: a reaper must never be quiet.
