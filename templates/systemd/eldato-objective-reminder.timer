[Unit]
# Every 10 minutes, the same cadence as the macOS LaunchAgent (com.eldato.objective-reminder,
# StartInterval 600) so both platforms carry ONE reminder policy and a doc does not have to say
# "10 minutes on a Mac, something else on a cell".
#
# ⛔ NOT `OnCalendar=*:0/10` (wall-clock aligned). A cell's controller and lanes wake in a 240 s cycle;
# an aligned minute puts this pass on top of whatever else fired there. `OnUnitActiveSec` measures from
# the last pass, which is what "every 10 minutes" means for a reminder.
#
# ⛔ Persistent=false ON PURPOSE. A reminder is only useful while an agent is alive to read it: replaying
# one on boot would deliver a stale objective into a box that has not yet started a lane, and the pass
# would log UNSENT for a surface that does not exist yet. (The disk reaper sets Persistent=true for the
# opposite reason: its work is cumulative and must not be skipped.)
Description=eldato objective reminder every 10 minutes

# ⛔ `OnUnitActiveSec` NEEDS A FIRST REFERENCE OR IT NEVER FIRES. It is defined as "relative to when the
# unit the timer unit is activating was LAST ACTIVATED" (systemd.timer(5)); on a service that has never
# been activated there is nothing to measure from, so `next_elapse=infinity` and the timer sits `active
# (elapsed)` forever without ever running. Measured on cmux 2026-11-17: this timer's service had NEVER
# started (`ExecMainStartTimestamp=` empty, zero journal entries, `NextElapseUSecMonotonic=infinity`),
# while `eldato-harness-apply.timer` — a different unit that is the only member of the set carrying an
# initial-elapse directive — was visibly firing (`list-timers` LAST 15:40:33Z, NEXT 15:50:53Z, ~10 min
# cadence). So boot anchors the FIRST elapse and
# `OnUnitActiveSec` carries the cadence from each pass (still not wall-clock aligned, per the note above).
[Timer]
OnBootSec=10min
OnUnitActiveSec=10min
AccuracySec=30s
RandomizedDelaySec=60
Persistent=false
Unit=eldato-objective-reminder.service

[Install]
WantedBy=timers.target
