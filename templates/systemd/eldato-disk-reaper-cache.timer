[Unit]
# Every 10 minutes, and it is cheap when it is not needed: the pass measures free space first and runs
# no class at all while the box is above its threshold, so a tick costs one `df`.
#
# ⛔ THE CADENCE IS THE FIX, NOT A PREFERENCE (agent-infra#4168). The measured failure was a runner
# install's `.cache` reaching **40.7 GB** (and 50.1 GB on another cell) while an HOURLY pass reclaimed
# 187 MB — a cache grows at a WRITE RATE, so a pass that only runs hourly can never hold the reserve
# that decides the box's runner ceiling (`per_runner_disk_mb ≈ 8409`, `DISK_RESERVE_MB = 20480`: at
# 2–8 GB free `by_disk` pins the ceiling to 1). 10 minutes is ~1/6 of the smallest measured write
# burst, and the per-pass cap keeps a run bounded, so the frequency costs a `df` and nothing else.
# Persistent=true: a cell that was suspended or rebooted runs one pass as soon as it comes back
# instead of waiting out a whole interval while its disk is already below the trigger.
Description=eldato disk reaper — runner-cache size-triggered pass (every 10 minutes)

[Timer]
OnCalendar=*:0/10
AccuracySec=60s
RandomizedDelaySec=30
Persistent=true
Unit=eldato-disk-reaper-cache.service

[Install]
WantedBy=timers.target
