[Unit]
# eldato ci runner starvation — detect and heal a starved CI runner pool (agent-infra#2875).
#
# WHY THIS IS SCHEDULED AND NOT A LINE IN THE BRING-UP. The 2026-10-27 incident had 10 runners
# online, 0 busy, 46 runs queued, and NO instrument noticed — a starved queue and a busy queue look
# identical in every dashboard. The detector is `queued>0 AND busy==0`, persistent over 3 samples
# ~2 min apart; the timer below provides the ~2 min spacing. The healer it runs reads GitHub
# directly, restarts systemd units directly, and only delegates re-registration to
# `ci_runner_pool.sh` — so it does not depend on the runner pool it repairs.
Description=eldato ci runner starvation — detect and heal a starved pool
# It reads GitHub. This ordering only avoids a guaranteed first-tick failure on a box that boots
# disconnected. ⛔ A FAILED READ IS NOT A PASS: the healer exits 2 (cannot-measure) on an unreadable
# GitHub read, so a disconnected boot goes RED and heals on the next tick.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{USER}}
Environment=HOME={{HOME}}
Environment=PATH={{PATH}}
Environment=STARVE_REPO={{STARVE_REPO}}
Environment=STARVE_STATE_DIR={{STATE_DIR}}
# The healer's own state/log dir (streak, filed marker, inbox record, log) — one record, not two.
# A bounded pass: one sample, at most one ladder (labels -> restart -> reconcile -> file+shout).
TimeoutStartSec=600
Nice=10
IOSchedulingClass=idle
# ⛔ NO `-` PREFIX ON ExecStart: a pass that cannot run must go RED, not be swallowed. The unit's
# colour is the only surface that reaches an operator who is not tailing a log.
ExecStart=/bin/bash {{HEALER}}
# ⛔ ONLY 0 IS GREEN. Exit 2 (cannot-measure, fail-closed) and 4 (starved AND not healed — filed and
# visible) are the states this whole feature exists to surface; greening them would hide them.
SuccessExitStatus=0
