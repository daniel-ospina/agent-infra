[Unit]
# Every 5 minutes, the same cadence as the macOS LaunchAgent (com.eldato.controller-watchdog,
# StartInterval 300) — one watchdog policy on both platforms.
#
# ⛔ 5 MINUTES, NOT 30 SECONDS. The datum the pass reads (`$O/heartbeat`) only moves once per controller
# cycle (240 s), so a tighter timer re-reads the same instant and can only add noise. At this cadence a
# wedge is detected within ~13-18 minutes of starting, which is bounded by the supervisor's own 780 s
# staleness limit plus one pass.
#
# ⛔ Persistent=false. A pass missed while the box was down is not work to replay: on the next tick the
# heartbeat's age is already the answer, and replaying a pass from before a reboot would date the
# controller from a state that no longer exists.
Description=eldato controller watchdog every 5 minutes

# ⛔ `OnUnitActiveSec` ALONE IS INERT — IT HAS NO FIRST REFERENCE. The directive is defined as
# "relative to when the unit the timer unit is activating was LAST ACTIVATED" (systemd.timer(5)), and this
# service has never been activated, so there is no reference to measure from: `next_elapse=infinity`,
# `LastTriggerUSec=` empty, and the timer never fires — while `systemctl` still reports it
# `active (elapsed)`. Measured on cmux 2026-11-17 (18 h after the timer was enabled), against a LIVE
# control on the same box:
#   eldato-controller-watchdog.timer  NextElapseUSecMonotonic=infinity  LastTriggerUSec=  service NEVER started
#   eldato-objective-reminder.timer   NextElapseUSecMonotonic=infinity  LastTriggerUSec=  service NEVER started
#   eldato-harness-apply.timer        CONTROL: `list-timers` LAST 15:40:33Z, NEXT 15:50:53Z (~10 min cadence)
# ⛔ THE CONTROL IS NOT "IDENTICAL EXCEPT FOR ITS ANCHOR" — it is a different unit with a different Unit=,
# cadence and RandomizedDelaySec. What is true and load-bearing is narrower, and qualified so a reader who
# lists the directory does not find it falsified: OF THE THREE TIMERS COMPARED ON THIS BOX, this control is
# the one carrying an initial-elapse directive; across the shipped set 5 of the 7 repeating templates
# already had one and exactly these 2 did not. It visibly fires, and the only setting that can produce
# `infinity` is that directive (`AccuracySec`/`Persistent`/`RandomizedDelaySec` cannot — they shape WHEN a
# scheduled pass lands, not whether one is ever scheduled). Quote its `list-timers` LAST/NEXT, never its
# `NextElapseUSecMonotonic`: that field is monotonic-since-BOOT (18h33m here) and reads like "fires every
# 18 h". That is precisely the "watchdog with no clock" this unit's own service description exists to end
# — so the first elapse is anchored to boot, and `OnUnitActiveSec` carries the 5-minute cadence from each pass.
[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
AccuracySec=30s
RandomizedDelaySec=45
Persistent=false
Unit=eldato-controller-watchdog.service

[Install]
WantedBy=timers.target
