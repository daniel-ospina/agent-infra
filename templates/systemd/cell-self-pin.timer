[Unit]
# cell self-pin's clock — every {{INTERVAL_MIN}} minutes, measured from the last pass
# (`OnUnitActiveSec`) rather than from the wall clock (agent-infra #3194, #2700 C5).
#
# ⛔ WHY A MONOTONIC TIMER AND NOT `OnCalendar=*:0/N`. `OnCalendar` can only express a value that
# divides the hour: 10 is fine and 7 renders `*:0/7`, which fires at :00 :07 :14 … :56 and then waits
# FOUR minutes for the next hour — a cadence the unit states and does not keep. `OnUnitActiveSec` is
# exactly the number the operator asked for, whatever it is.
#
# ⛔ `Persistent=` IS DELIBERATELY ABSENT. It only means anything for `OnCalendar=` timers (run the
# missed passes after a suspension); on a monotonic timer it is ignored, and writing it would claim a
# catch-up behaviour that does not happen. The reboot case is covered by `OnBootSec` below.
#
# ⛔ AND THE PASS IS A NO-OP WHEN IT IS ALREADY CURRENT (exit 0), so the cadence costs one `git fetch`
# per tick on a converged box — that is what makes a 10-minute interval honest rather than a redeploy
# every 10 minutes.
Description=cell self-pin every {{INTERVAL_MIN}} minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec={{INTERVAL_MIN}}min
AccuracySec=30s
# Spread the fleet's ticks so four boxes do not fetch at the same second.
RandomizedDelaySec=45
Unit=cell-self-pin.service

[Install]
WantedBy=timers.target
