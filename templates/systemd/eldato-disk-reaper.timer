[Unit]
# Hourly, for the same reason the package-cache bound is hourly: the sinks grow continuously (a lane
# per dispatch, an env per lane) and the failure is a THRESHOLD, not an age. Persistent=true means a
# cell that was suspended or rebooted runs one pass as soon as it comes back instead of waiting out a
# whole interval at 97% used.
Description=eldato disk reaper hourly pass

[Timer]
OnCalendar=hourly
RandomizedDelaySec=300
Persistent=true
Unit=eldato-disk-reaper.service

[Install]
WantedBy=timers.target
