<?xml version="1.0" encoding="UTF-8"?>
<!-- agent-infra-plist-version: 0.1.0 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- hub-state-check (#1484): every 6h verify the shared main checkout stays
         on main+clean; on FAIL, open/comment one deduped GitHub issue with the
         sanctioned recovery command. Canonical script:
         agent-infra/scripts/checkout-hygiene/hub-state-check.sh (installed to
         ~/.pi/agent/scripts/checkout-hygiene/ — the corruption-canary
         convention). Tortoise only: agent-infra is the #99 in-main-work repo
         and is exempt from the hub discipline (its dirt is normal).
         Rendered by scripts/install-launchd.sh (#304) — placeholders only, no
         machine-specific paths. TORTOISE_REPO is injected as an environment
         variable (launchd does not inherit the shell); script defaults handle
         the fallback when it is empty. -->
    <key>Label</key>
    <string>com.eldato.hub-state-check</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>bash</string>
        <string>{{HOME}}/.pi/agent/scripts/checkout-hygiene/hub-state-check.sh</string>
        <string>--gh-report</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{PATH}}</string>
        <key>TORTOISE_REPO</key>
        <string>{{TORTOISE_REPO}}</string>
    </dict>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>StandardOutPath</key>
    <string>/tmp/hub-state-check.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hub-state-check.log</string>
</dict>
</plist>
