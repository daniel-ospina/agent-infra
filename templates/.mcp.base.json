{
  "mcpServers": {
    "seo-intelligence": {
      "command": "${AGENT_INFRA_PATH}/mcp-servers/seo-intelligence/node_modules/.bin/tsx",
      "args": [
        "server.ts"
      ],
      "cwd": "${AGENT_INFRA_PATH}/mcp-servers/seo-intelligence",
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      },
      "lazy": true,
      "idleTimeoutMs": 900000,
      "purpose": "Perplexity Search API + SERP + GSC + HubSpot + Places (24 tools). RUNG 1 of the research skill's tool ladder — ~$0.005/query flat, never the $5-40 chat models",
      "whenToLoad": "research/search tasks FIRST (prefer over web_search); also GSC, SERP, Places and HubSpot tasks. NOTE: requires a one-time `npm install` in mcp-servers/seo-intelligence per checkout, or the entry fails to spawn",
      "cost": "~$0.005/query flat; zero cost while sleeping (lazy)"
    },
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      },
      "lazy": true,
      "idleTimeoutMs": 900000,
      "purpose": "Semantic search (Exa) — scholarly/semantic/entity discovery",
      "whenToLoad": "on demand — semantic/scholarly/prospect discovery only (#419)",
      "cost": "one light process; Perplexity is the primary source"
    },
    "tortoise": {
      "command": "${TORTOISE_HOME:-${HOME}/Documents/GitHub/tortoise}/.venv/bin/python3",
      "args": [
        "-m",
        "tortoise.mcp_server"
      ],
      "cwd": "${TORTOISE_HOME:-${HOME}/Documents/GitHub/tortoise}",
      "env": {
        "PYTHONPATH": "${TORTOISE_HOME:-${HOME}/Documents/GitHub/tortoise}",
        "TORTOISE_DB_URI": "docker://:@127.0.0.1:16379/tortoise"
      },
      "purpose": "Memory graph (Tortoise) — cross-session knowledge",
      "whenToLoad": "always (core)",
      "cost": "one python process (venv has fastmcp)"
    },
    "playwright-browser": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "lazy": true,
      "idleTimeoutMs": 900000,
      "purpose": "Browser automation (navigate/click/screenshot)",
      "whenToLoad": "verify/UX phases only",
      "cost": "~170MB pair while loaded"
    },
    "gemini": {
      "command": "npx",
      "args": [
        "-y",
        "@houtini/gemini-mcp"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      },
      "lazy": true,
      "purpose": "Image generation (Gemini)",
      "whenToLoad": "image/carousel tasks",
      "cost": "one npx process"
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@brave/brave-search-mcp-server"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "lazy": true,
      "purpose": "Web search (Brave)",
      "whenToLoad": "on demand",
      "cost": "one npx process"
    }
  }
}
