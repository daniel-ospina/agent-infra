<?xml version="1.0" encoding="UTF-8"?>
<!-- Watchdog template. Rendered by install.sh (which substitutes the install dir and HOME); do not
     load this file itself — launchd would see unrendered placeholders.

     WHY IT EXISTS: a controller that is REMOVED (a persistent-disable verb, or a failed bootstrap)
     cannot be restarted by KeepAlive, so a second agent has to notice and put it back. See
     watchdog.sh. ⛔ Nothing here writes a Disabled override: the watchdog and the installer use
     enable/bootout/bootstrap only, because the override is the state this agent exists to repair.

     ⛔ Every path here is a placeholder, never a literal. A hardcoded /Users/<someone> in a shipped
     plist is the defect that stopped the cloud cells dispatching: they loaded a plist naming a
     directory that does not exist on a cell, launchd started nothing, and no error reached the
     fleet. (Writing a placeholder name in THIS comment is refused by install.sh's post-render
     token check — which is the check doing its job, so the names are spelled out there, not here.) -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eldato.orchestrator-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__O__/watchdog.sh</string>
  </array>

  <!-- RunAtLoad: act right after login. StartInterval: launchd runs it once a minute, and the script
       exits immediately unless the controller is gone — so a healthy box pays one launchctl probe a
       minute and nothing else. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>__O__/logs/watchdog.out</string>
  <key>StandardErrorPath</key>
  <string>__O__/logs/watchdog.err</string>

  <!-- launchd passes no shell environment. The watchdog resolves the loop's plist and its log from
       HOME/$O, so both must be stated here or it would look under launchd's default HOME and find
       nothing — then log to a path nobody reads. PATH is left to launchd's default because every
       external command the script runs lives in /bin or /usr/bin: /bin/bash (the interpreter),
       launchctl, awk, cat, date, id, mkdir, ps, sleep and tail. `printf` and `kill` are shell builtins.
       (This list is what the next added dependency gets checked against, so it names the real set —
       an earlier version listed grep and sed, which the script no longer runs.) -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>O</key>
    <string>__O__</string>
  </dict>
</dict>
</plist>
