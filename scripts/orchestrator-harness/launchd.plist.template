<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eldato.orchestrator-loop</string>
  <!-- ⛔ THE PROGRAM IS A LAUNCHER, NOT orch-loop.sh DIRECTLY (measured 2026-10-18).
       A launchd job on this Mac CANNOT READ THE PRODUCT CHECKOUT: macOS TCC protects
       ~/Documents, so a launchd-born /bin/bash gets EPERM on the whole tree (not just on its
       cwd — `cd` into the repo succeeds and every read inside it still fails, which is why
       `git` answered "Unable to read current working directory: Operation not permitted" and
       every candidate was refused with "could not build claim commit"). install.sh already
       documents this class for the gh shim. The Full Disk Access grant on this box is attached
       to the **tmux binary**, so launchd starts the controller as a tmux pane command and it
       inherits that grant. Do not "simplify" this back to orch-loop.sh: it installs clean and
       then silently refuses every dispatch. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__O__/launchd-controller.sh</string>
  </array>

  <!-- RunAtLoad: start on login. KeepAlive: relaunch if the controller exits.
       The loop is idempotent — .orch.lock makes a second instance exit immediately. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__O__/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__O__/logs/launchd.err</string>

  <!-- launchd gives no shell env, so EVERY binary the daemon shells out to must be on this
       PATH. It is rendered by install.sh from the directories the binaries ACTUALLY resolve to
       (__PATH__), not hardcoded, because a wrong PATH here does not fail loudly — see the
       OPEN_N note in install.sh: the loop reads an empty queue and idles. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HOME</key>
    <string>__HOME__</string>

    <!-- target -->
    <key>OR</key>
    <string>__OR__</string>
    <key>REPO</key>
    <string>__REPO__</string>
    <key>O</key>
    <string>__O__</string>

    <!-- drain scope: auto (count rule) | own (pin own-only) | broad (pin broad).
         A fleet runs exactly ONE broad box; the rest pin own (README section 5). -->
    <key>SCOPE</key>
    <string>__SCOPE__</string>

    <!-- concurrency limits; the swap gate, not MAX_LANES, is what throttles an 8 GB box
         (README section 4). MAX_LANES is rendered from the installer's own core probe — 2.5x the
         CPU count (25 on a 10-core box) — because capacity, not a lane count, is the ceiling;
         pin it explicitly to override, and check swap headroom before raising it by hand. -->
    <key>MAX_LOAD</key>
    <string>__MAX_LOAD__</string>
    <key>MAX_LANES</key>
    <string>__MAX_LANES__</string>
    <key>MAX_REVIEW</key>
    <string>__MAX_REVIEW__</string>
    <key>MERGE_PRIORITY_AT</key>
    <string>__MERGE_PRIORITY_AT__</string>
    <key>MAX_FIX</key>
    <string>__MAX_FIX__</string>
    <key>MAX_FIX_TRIES</key>
    <string>__MAX_FIX_TRIES__</string>
    <key>MIN_SWAP_FREE</key>
    <string>__MIN_SWAP_FREE__</string>
    <key>MIN_MEM_FREE_MB</key>
    <string>__MIN_MEM_FREE_MB__</string>
    <key>BATCH</key>
    <string>__BATCH__</string>
    <key>CYC</key>
    <string>__CYC__</string>
  </dict>
</dict>
</plist>
