#!/usr/bin/env bash
# harness-up — ONE entry point that brings the harness up, takes it down, and answers its status.
#
#   ./scripts/harness-up [up]        # resolve the pin -> verify it is the dir the controller READS
#                                    # -> MEASURE this box's capacity (fork headroom, then disk, then
#                                    # load) -> self-tests -> start every component in dependency
#                                    # order. Running it twice is a NO-OP: a controller already on this
#                                    # run's tree is left alone
#   ./scripts/harness-up down        # stop the stack (delegated; nothing invented here)
#   ./scripts/harness-up status      # what is EXECUTING, is the loop alive, is PLACEMENT healthy
#                                    # (fork -> disk -> load), how many lanes and whether they are
#                                    # advancing, this tree's self-test, and what it would do NEXT —
#                                    # then ONE verdict. STATUS HEALS by default (see --no-heal).
#                                    # It also prints the ROLE table: one MEASURED line per role
#                                    # (controller/apply/watchdog/reminder/doctor) — RUNNING, FAILED,
#                                    # DEAD, NEVER-INSTALLED or DANGLING, with the artefact's own last
#                                    # error line. A unit file is never evidence that a role runs.
#   ./scripts/harness-up roles       # the same role table, read-only (status also heals)
#   ./scripts/harness-up heal        # RE-DRIVE what is dead: install what is missing, start what is
#                                    # stopped, and name what it could NOT fix (exit 1 — never a
#                                    # silent 0). Nothing is re-driven by guesswork: a role that
#                                    # cannot be read is reported, not repaired, and a DANGLING unit
#                                    # (its program or cwd no longer exists) is reported with the path.
#   ./scripts/harness-up logs <role> [n]   # the role's OWN log (n lines, default 40)
#   ./scripts/harness-up dispatch <role> [pass]  # run ONE role once, in the FOREGROUND: no session,
#                                    # no scheduler, the role's own argv and its own output. `doctor`
#                                    # takes a pass name (reap|doctor|merge|hygiene).
#   The five roles, their units on each platform, and which of them has a unit at all — the table in
#   `scripts/orchestrator-harness/README.md` §6.1 — is declared in ONE place:
#   `harness-roles.sh`, sourced by this file. `up` INSTALLS the roles the box is configured for
#   (`HR_ROLES`, else `$O/harness-roles.conf`, else the platform default) and REFUSES before writing
#   anything when a role's program or working directory does not exist — the `/tmp`-cwd shape that
#   killed a unit every ten minutes cannot be installed from here.
#
#   Flags: --harness <dir> --repo <agent-infra checkout> --ref <git-ref> --pin <file> --pin-dir <dir> -o <dir>
#          --no-fetch --skip-selftest --timeout <secs> --plain [--no-heal|--heal]
#          ⛔ `--repo` is THE HARNESS CHECKOUT (the repo the pin commit and `--ref` are commits OF), NOT the
#          repo the controller drains: that one is `REPO=<work repo>` in the environment, and it is left
#          alone. On a cell the two differ (harness=agent-infra, work=tortoise) — see the TWO repos block.
#          Without `--repo` the harness resolves from `HARNESS_REPO` (env, then this machine's `ENV_FILE`)
#          and then the launcher's OWN checkout; a candidate that is not a checkout ROOT is skipped.
#          An unusable `--repo` REFUSES, naming the value; an unusable inherited candidate is skipped.
#   Capacity knobs (all MEASUREMENTS, none a cap), in the order they bind:
#     fork headroom  HU_FORK_RESERVE (default: the instrument's own `min_fork_headroom` — 200 today)
#                    and HU_FORK_PER_LANE (40 tasks a lane's process tree holds) — read FIRST, before
#                    any probe that must fork, because a box can fork nothing at 0.32x load (#2293)
#                    while load and disk both read healthy;
#     disk           HU_DISK_PER_LANE_MB (1100), HU_DISK_FLOOR_MB (500);
#     load           HU_LOAD_PER_CPU (800 → 8.00 load per cpu, equal to capacity.sh's
#                    CAP_LPC_CEILING), HU_LOAD_PER_LANE (400 → 4.00 load units).
#   HARNESS_UP_MAX_LANES is REPORTED AND IGNORED as a ceiling — a fixed cap is not a measurement.
#
# Exit: 0 HEALTHY · 1 DEGRADED · 2 BROKEN (start refused / cannot-verify) · 3 REFUSED before start.
#
# ── WHY THIS EXISTS (the owner's two named gaps) ──────────────────────────────────────────────────
# 1. "The harness is a pile of scripts that each deploy and activate themselves." Bringing a box up
#    was N commands in an order an operator had to remember, on two platforms with different
#    mechanisms, and every one of them had its own preconditions and its own failure vocabulary.
# 2. "Cells drift from main silently." Nothing compared, per box, the set of harness scripts the
#    RUNNING controller actually uses against the same paths at origin/main.
#
# ── WHAT THIS FILE IS NOT (each is a recorded decision, not an omission) ──────────────────────────
# ⛔ IT IS NOT A SECOND FLEET AUTHORITY. `scripts/orchestrator-bringup.sh` already owns the fleet
#    inventory (`lib/fleet-inventory.sh`) and the platform start verbs; `scripts/cloud-cell-supervisor.sh`
#    owns pin/seed/controller/doctor; `scripts/orchestrator-harness/install.sh` owns the Mac's
#    deployment. This file COMPOSES them and adds only the three things none of them had: the pin
#    identity check below, a fail-closed self-test gate, and one verdict. Deleting any of them is out
#    of scope — every one keeps working exactly as it does today.
# ⛔ IT DOES NOT RE-DERIVE DEFAULTS IN THE CHILD. A tmux server does NOT inherit the caller's
#    exports: the tmux server's environment is captured when the SERVER starts, so an `export` in the
#    shell that typed `start` reaches the client and never the session. That is why every delegation
#    below passes its configuration as an `env VAR=…` PREFIX on the command string — inside the
#    process — rather than relying on this shell's ambient environment. That omission is what made
#    the refresh re-pin into `$CELL_HOME/harness` (a worktree nobody read) on a live cell (#2216).
# ⛔ PORTABILITY IS PART OF THE CONTRACT (macOS + these Linux cells). No `timeout`/`gtimeout` (GNU
#    coreutils; absent on macOS) — bounds use `perl -e 'alarm …'`, the same bound `admin-merge.sh`
#    already applies. No `pgrep -c` (BSD pgrep has no -c) — process reads use `ps`, like
#    `lib/fleet-inventory.sh`. No plain `gh auth token` (rc=142 hang measured on these images) — any
#    gh probe goes through `hu_bounded`.
# ⛔ ALL OF THOSE DIFFERENCES LIVE IN ONE SHIM (`>>> shim`), and nowhere else. A BSD-vs-GNU difference
#    spelled twice is a difference that will be fixed once: `mktemp -d` needs a TEMPLATE on macOS and
#    the launcher called it without one, so every Apple run died at the temp-dir line while Linux
#    stayed green — found only on the Mac, which is the class the shim removes. The shim's OS answer is
#    injectable (`HARNESS_UP_OS`), so the Darwin arm is EXERCISED by a Linux suite instead of being
#    trusted until an operator discovers otherwise.
#
# ── WHAT THIS FILE ADDS ON TOP OF THE ONE LAUNCHER (agent-infra#2286's brief) ────────────────────
# 1. `exec` — a row that reads the RUNNING controller's own argv, resolves the tree it is executing and
#    compares that tree's COMMIT with the pin. Every other row reads a RECORD or the CONFIGURED dir;
#    none of them can see a process running code the records never named — `~/.cache/orc/main-orch-loop.sh`,
#    a hand-launched old worktree, a stale second pin (records OK, process elsewhere). Its census is
#    therefore ANY `*/orch-loop.sh` on the box (`hu_any_ctrl_pids`), not the two paths `loop`/`up` scope
#    to: that is the difference between "is THIS deployment running" and "WHAT is running".
# 2. `launchd` — on macOS, whether the job is LOADED and whether it HAS A PROCESS. `ps` alone cannot
#    tell "not loaded" from "loaded and crashed" from "loaded, running", and only the first is fixed
#    by loading it (label `com.eldato.orchestrator-loop`, install.sh:131).
# 3. `up` IS IDEMPOTENT, AND IDEMPOTENT IS NOT A RESTART. `orchestrator-bringup.sh start` REFUSES a
#    second controller for the same repo+state dir, so a second `up` on a healthy box reported FAILED.
#    The repair is NOT stop-then-start: a healthy supervisor is deliberately never cycled (its ADOPT
#    arm says why) and a pin advance must never kill in-flight work (#2216, #2278). A live controller
#    executing THIS run's tree is therefore left alone and named `ALREADY UP`.
# 4. `capacity` — the lane ceiling is MEASURED (load and free disk, read at the moment of the decision
#    and printed with the number) and never a constant. `HARNESS_UP_MAX_LANES` is REPORTED AND IGNORED
#    as a ceiling; when the box cannot be measured the decision REFUSES rather than substituting a
#    fixed number, because a cap is not a measurement.
#
# ── THE PIN IDENTITY CHECK (the reason `up` cannot simply `exec install.sh`) ─────────────────────
# A pin is TWO records and they can disagree: `HARNESS-PIN` names a COMMIT, and `HARNESS_PIN_FILE`
# names the DIRECTORY the controller execs. A refresh run with the wrong pin root writes a worktree
# under `$CELL_HOME/harness/<sha12>` while the runtime reads something else entirely — the re-pin
# reports success and advances nothing (#2216's own measured warning). So `up` refuses unless
#     dirname(HARNESS_PIN_FILE) == HARNESS_PIN_DIR/<sha12(commit in HARNESS-PIN)>/scripts/orchestrator-harness
# and that directory is readable and carries `orch-loop.sh`. On a box with no pin machinery at all the
# check is SKIPPED WITH A REASON — never silently OK.
# ⛔ A MAC IS NO LONGER SUCH A BOX (agent-infra#2231). Every Mac used to be, because the pin records
# were CELL-ONLY: the Mac's launchd program was `$O/orch-loop.sh`, a copy, so there was nothing to
# compare. `install.sh` now writes and enforces the same two records the cells use, and the pair
# (`.harness-path`, `$HOME/.pi/agent/state/HARNESS-PIN`) is what this check reads on BOTH platforms —
# so the skip below is for a box that has never been installed, not for "the Mac".
set -uo pipefail

SELF_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF="$SELF_PATH/$(basename "${BASH_SOURCE[0]}")"

log_line()  { printf '%s\n' "$*"; }
warn() { printf 'harness-up: %s\n' "$*" >&2; }
die()  { local m="$1" rc="${2:-3}"; printf 'harness-up: %s\n' "$m" >&2; exit "$rc"; }

usage() { # <exit-code>
  sed -n '2,/^set -uo pipefail$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//; $d'
  exit "${1:-0}"
}

VERB="${HARNESS_UP_FORCED_VERB:-}"; PLAIN=0; FETCH=1; SELFTEST=1; HEAL=1
A_HARNESS=""; A_REPO=""; A_REPO_SEEN=0; A_REF=""; A_PIN=""; A_PINDIR=""; A_O=""
A_ROLE=""; REST_ARGS=""
BOUND="${HARNESS_UP_TIMEOUT:-900}"
while [ $# -gt 0 ]; do
  case "$1" in
    heal|roles)
        if [ -n "${HARNESS_UP_FORCED_VERB:-}" ] && [ "${HARNESS_UP_FORCED_VERB}" != "$1" ]; then
          die "$1 refused: this entry point is $HARNESS_UP_FORCED_VERB" 2
        fi
        VERB="$1"; shift ;;
    dispatch|logs)
        if [ -n "${HARNESS_UP_FORCED_VERB:-}" ] && [ "${HARNESS_UP_FORCED_VERB}" != "$1" ]; then
          die "$1 refused: this entry point is $HARNESS_UP_FORCED_VERB" 2
        fi
        VERB="$1"; shift
        # ⛔ THE ROLE OPERAND IS NAMED HERE, NOT DISCOVERED LATER: `dispatch` with no role would
        # otherwise dispatch nothing and exit 0 — the exact "succeeded while doing nothing" shape.
        [ $# -ge 1 ] || die "$VERB needs a role (known: controller apply watchdog reminder doctor)" 2
        A_ROLE="$1"; shift
        if [ "$VERB" = dispatch ]; then REST_ARGS="$*"; set --; fi ;;
    up|down|status)
        # ⛔ THE WRAPPER'S VERB IS NOT OVERRIDABLE. `scripts/harness-down up` used to REPLACE `down`
        # with `up` — a wrapper that runs the opposite verb of its own name turns a one-keystroke
        # mistake into the destructive direction. A wrapper exports HARNESS_UP_FORCED_VERB; a
        # positional verb that disagrees is refused, never silently honoured.
        if [ -n "${HARNESS_UP_FORCED_VERB:-}" ] && [ "${HARNESS_UP_FORCED_VERB}" != "$1" ]; then
          die "$1 refused: this entry point is $HARNESS_UP_FORCED_VERB (it is scripts/harness-$HARNESS_UP_FORCED_VERB); a second verb would run the wrong one" 2
        fi
        VERB="$1"; shift ;;
    --harness)             [ $# -ge 2 ] || die "--harness needs a path"; A_HARNESS="$2"; shift 2 ;;
    --repo)                [ $# -ge 2 ] || die "--repo needs a path"; A_REPO="$2"; A_REPO_SEEN=1; shift 2 ;;
    --ref)                 [ $# -ge 2 ] || die "--ref needs a git ref"; A_REF="$2"; shift 2 ;;
    --pin)                 [ $# -ge 2 ] || die "--pin needs a file"; A_PIN="$2"; shift 2 ;;
    --pin-dir)             [ $# -ge 2 ] || die "--pin-dir needs a path"; A_PINDIR="$2"; shift 2 ;;
    -o|--o)                [ $# -ge 2 ] || die "-o needs a path"; A_O="$2"; shift 2 ;;
    --no-fetch)            FETCH=0; shift ;;
    --skip-selftest)       SELFTEST=0; shift ;;
    --no-heal)             HEAL=0; shift ;;
    --heal)                HEAL=1; shift ;;
    --timeout)             [ $# -ge 2 ] || die "--timeout needs seconds"; BOUND="$2"; shift 2 ;;
    --plain)               PLAIN=1; shift ;;
    -h|--help)             usage 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
done
[ -n "$VERB" ] || VERB="up"
case "$BOUND" in ''|*[!0-9]*) die "--timeout/HARNESS_UP_TIMEOUT must be a positive integer, got '$BOUND'" ;; esac
[ "$BOUND" -gt 0 ] || die "--timeout/HARNESS_UP_TIMEOUT must be a positive integer, got '$BOUND'"

# ── helpers (extracted verbatim by scripts/harness-cohesion.test.sh) ─────────────────────────────
# >>> helpers
# ══ >>> shim — THE ONE PLACE A PLATFORM DIFFERENCE MAY LIVE ══════════════════════════════════════
# One function per QUESTION (not per platform), so macOS and a Linux cell cannot drift into two
# answers to the same question. Every caller in this file goes through one of these.
# `HARNESS_UP_OS` pins the OS answer (Darwin|Linux) — the seam that lets a Linux suite exercise the
# macOS arm, exactly as `HU_PS`/`DRIFT_PS` let a suite supply a process table. `HU_NCPU` and
# `HU_LOADAVG_FILE` are the same kind of seam: a test cannot change the box it runs on.

# hp_os — which OS's userland this run answers to.
hp_os() {
  case "${HARNESS_UP_OS:-}" in Darwin|Linux) printf '%s\n' "$HARNESS_UP_OS"; return 0 ;; esac
  uname -s 2>/dev/null
}

# hp_mktemp_d — a temp dir. ⛔ BSD `mktemp` REQUIRES A TEMPLATE: `mktemp -d` with no argument is a
# usage error on macOS (GNU mktemp invents one), so the template is part of the call on BOTH
# platforms. This is the whole reason the shim exists — the untemplated call was a Mac-only death.
hp_mktemp_d() { mktemp -d "${TMPDIR:-/tmp}/harness-up.XXXXXXXX" 2>/dev/null; }

# hp_stat_mtime <file> — mtime as an epoch. ⛔ THE TWO `stat` DIALECTS DO NOT JUST DIFFER, ONE OF THEM
# ANSWERS WRONGLY ON THE OTHER'S GROUND: GNU `stat -f %m <file>` prints the whole FILESYSTEM block to
# stdout and exits 1, so an `||` fallback's epoch APPENDS to that block — every age then reads UNKNOWN
# and a healthy Linux cell reports VERDICT: BROKEN right after a successful start (measured by the
# #2231 verifier). Hence GNU FIRST, then a NUMERIC GUARD after each attempt (BSD `-c` prints usage and
# exits 1, which is at least silent, but the guard is what makes the order irrelevant).
hp_stat_mtime() { # <file> — epoch; rc=1 when it cannot be read
  local t=""
  t="$(stat -c %Y "${1:-}" 2>/dev/null)"
  case "$t" in ''|*[!0-9]*) t="$(stat -f %m "${1:-}" 2>/dev/null)" ;; esac
  case "$t" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$t"
}

# hp_ncpu — the CPU count. ⛔ ASK THE PLATFORM'S OWN PROBE FIRST, because the two disagree about what
# exists: `nproc` is GNU/Linux-only (absent on macOS) and `sysctl hw.ncpu` is macOS's answer (many Linux
# kernels ship it too). `getconf` is the POSIX floor. A count that is not a positive integer is NOT a
# count: `$(( 10#x * 10 ))` on junk is an error, and a 0 ceiling would mean "nothing can run".
hp_ncpu() {
  local n=""
  if [ -n "${HU_NCPU:-}" ]; then n="$HU_NCPU"; else
    case "$(hp_os)" in
      Darwin) if command -v sysctl >/dev/null 2>&1; then n="$(sysctl -n hw.ncpu 2>/dev/null)"; fi ;;
      *)      if command -v nproc >/dev/null 2>&1; then n="$(nproc 2>/dev/null)"; fi ;;
    esac
    case "$n" in ''|*[!0-9]*) if command -v sysctl >/dev/null 2>&1; then n="$(sysctl -n hw.ncpu 2>/dev/null)"; fi ;; esac
    case "$n" in ''|*[!0-9]*) n="$(getconf _NPROCESSORS_ONLN 2>/dev/null)" ;; esac
  fi
  case "$n" in ''|*[!0-9]*) return 1 ;; esac
  [ "$n" -ge 1 ] 2>/dev/null || return 1
  printf '%s' "$n"
}

# hp_load1_c — the 1-minute load average in HUNDREDTHS (bash 3.2 has no floats, so every comparison
# in this file is integer — the same scaling `scripts/orchestrator-harness/capacity.sh` uses on a
# cell). macOS: `sysctl -n vm.loadavg` prints `{ 1.23 4.56 7.89 }`; Linux: /proc/loadavg's first field.
# `HU_LOADAVG_FILE` is the fixture seam (a suite cannot change the box's load).
hp_load1_c() {
  local raw="" f=""
  case "$(hp_os)" in
    Linux)
      f="${HU_LOADAVG_FILE:-/proc/loadavg}"
      [ -r "$f" ] && raw="$(awk 'NR==1{print $1; exit}' "$f" 2>/dev/null)" ;;
    *)
      if [ -n "${HU_LOADAVG_FILE:-}" ] && [ -r "$HU_LOADAVG_FILE" ]; then
        raw="$(awk 'NR==1{print $1; exit}' "$HU_LOADAVG_FILE" 2>/dev/null)"
      fi ;;
  esac
  # ⛔ ONE FALLBACK, NOT A PLATFORM BRANCH: `sysctl -n vm.loadavg` answers the same question on a Linux
  # kernel that has /proc masked (a hardened container) as it does on macOS, so it is tried when the
  # primary read produced nothing — rather than a second per-platform arm that could disagree.
  case "$raw" in ''|*[!0-9.]*)
    raw="$(sysctl -n vm.loadavg 2>/dev/null | tr -d '{}' | awk '{print $1; exit}')" ;;
  esac
  case "$raw" in ''|*[!0-9.]*) return 1 ;; esac
  printf '%s' "$(awk -v v="$raw" 'BEGIN{ if (v+0 < 0) exit 1; printf "%d", v*100 }')" || return 1
}

# hp_disk_free_mb <path> — free MiB on the filesystem holding <path>. `df -Pk` is POSIX and its 4th
# column is 1KiB blocks on BOTH platforms, and the column is VALIDATED rather than trusted (a locale-,
# wrap- or column-shifted `df` would otherwise hand back a string `[ -lt ]` errors on). Same probe as
# `scripts/orchestrator-harness/spawn-gate.sh:200-202` — the dispatch gate's floor is read below, so
# the two instruments must read the disk the same way.
hp_disk_free_mb() { # <path>
  local mb=""
  mb="$(df -Pk "${1:-.}" 2>/dev/null | awk 'NR==2 && $4 ~ /^[0-9]+$/ {printf "%d\n", $4 / 1024}')"
  case "$mb" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$mb"
}

# hp_fork_headroom — how many MORE tasks this box could create right now, and against WHICH limit.
# ⛔ THIS IS A DIFFERENT QUESTION FROM LOAD, AND IT IS ASKED FIRST (agent-infra#2293). A box at 0.32x
# load can be unable to spawn ANYTHING: fork() and clone() fail with EAGAIN when a hard TASK LIMIT is
# reached, and no load average, free-disk or memory reading can see it. Measured shapes: a fork storm
# (the gh-shim recursion of #2304: 3.4k processes, load 74 on 4 vCPU), and cgroup `pids.max` on a
# shared host, which binds long before the box's own load ceiling does (measured on this Linux box
# 2026-10-22: cgroup pids 1295/4692 — 3397 spare — against an RLIMIT_NPROC of 15641 and a
# threads-max of 31282, i.e. the cgroup was 4x tighter than the kernel's own limit and 8x tighter
# than the per-user one).
# The reading is (limit − used) for EACH limit that applies, and the SMALLEST wins — a headroom
# averaged across limits would report the loosest one and kill the spawn.
#   Linux  threads-max   (system-wide threads)          used = live threads
#          RLIMIT_NPROC  (threads for this uid)         used = live threads owned by this uid
#          cgroup pids.max (v2 /v2-path/pids.max, v1 pids/pids.max) used = pids.current  ← exact
#   macOS  kern.maxproc / kern.maxprocperuid (processes) used = live processes (all / this uid)
#          RLIMIT_NPROC  (`ulimit -u`, what a shell actually gets)
# Process/thread counts come from ONE `ps` read per shape, and `HU_PS` is the same process-table seam
# `hu_pids` uses. `HU_FORK_LIMITS_FILE` (lines of `source limit used`) is the fixture seam: a suite
# cannot change the box's real limits, and the refusal path is only testable if it can supply them.
# rc=0 a measured answer on stdout (`headroom=<n> source=<name> used=<n> limit=<n>`)
# rc=1 nothing could be measured — and an unmeasured fork limit is NOT unlimited headroom.
hp_fork_headroom() {
  local f="${HU_FORK_LIMITS_FILE:-}" bh="" bs="" bu="" bl=""
  # _take <source> <limit> <used> — keep the tightest. Bash's dynamic scoping is what lets this see
  # the caller's locals; it is re-defined per call, never left behind for another function to use.
  _take() {
    local lim="${2:-}" used="${3:-}" h
    case "$lim" in ''|*[!0-9]*) return 0 ;; esac
    case "$used" in ''|*[!0-9]*) return 0 ;; esac
    [ "$lim" -ge 1 ] 2>/dev/null || return 0
    h=$(( lim - used )); [ "$h" -lt 0 ] && h=0
    if [ -z "$bh" ] || [ "$h" -lt "$bh" ]; then bh="$h"; bs="${1:-unknown}"; bu="$used"; bl="$lim"; fi
  }
  if [ -n "$f" ]; then
    [ -r "$f" ] || return 1
    # shellcheck disable=SC2034 # `_take` reads these through BASH_REMATCH-free positional args
    while read -r s l u; do _take "$s" "$l" "$u"; done < "$f"
  else
    local ps_cmd="${HU_PS:-ps}" n_all="" n_uid="" uid="" rl="" tm="" cg=""
    uid="$(id -u 2>/dev/null)" || uid=""
    # Threads on Linux (RLIMIT_NPROC and threads-max both count TASKS there), processes on macOS.
    # ⛔ A FAILED OR EMPTY PROCESS READ IS NOT "ZERO TASKS USED" (review P1): with an absent/failing
    # `ps`, `wc -l` gave 0 and awk's `END{c+0}` gave 0, so `used=0` and the probe answered
    # `headroom=<full limit> rc=0` — "I could not look" spent as "there is room", the exact rule this
    # function exists to enforce. Empty now means UNMEASURED, and no limit is taken from it.
    _count() { # <cmd…> -> a positive integer, or empty
      local v; v="$("$@" 2>/dev/null)" || { printf ''; return 0; }
      # ⛔ STRIP WHITESPACE FIRST: BSD `wc -l` PADS its count to a column ("     300"), so the digit
      # test below rejected a perfectly good reading and every Darwin process count came back EMPTY.
      # On a box whose only working source was `kern.maxproc`, `n_all` empty meant that limit was
      # never taken, and with no uid count either the probe REFUSED outright — "could not look" on a
      # Mac that could be measured. Measured 2026-10-24 (bash 3.2.57, macOS): the (G) arm refused with
      # every one of ulimit/threads-max/cgroup/maxproc reported "unreadable" against a stub table of
      # 300 processes. `${v//[[:space:]]/}` is bash 3.2-safe and adds no pipe.
      v="${v//[[:space:]]/}"
      case "$v" in ''|0|*[!0-9]*) printf '' ;; *) printf '%s' "$v" ;; esac
    }
    case "$(hp_os)" in
      Linux)
        n_all="$(_count sh -c "$ps_cmd -eLo pid= 2>/dev/null | wc -l")"
        [ -n "$uid" ] && n_uid="$(_count sh -c "$ps_cmd -eLo uid= 2>/dev/null | awk -v u='$uid' '\$1==u{c++} END{print c+0}'")" ;;
      *)
        n_all="$(_count sh -c "$ps_cmd -e -o pid= 2>/dev/null | wc -l")"
        [ -n "$uid" ] && n_uid="$(_count sh -c "$ps_cmd -e -o uid= 2>/dev/null | awk -v u='$uid' '\$1==u{c++} END{print c+0}'")" ;;
    esac
    # RLIMIT_NPROC: `ulimit -u` prints `unlimited` on a box with no limit, which is not a number.
    rl="$(ulimit -u 2>/dev/null)"
    case "$rl" in ''|*[!0-9]*) rl="" ;; esac
    if [ -n "$rl" ] && [ -n "$n_uid" ]; then _take rlimit-nproc "$rl" "$n_uid"; fi
    case "$(hp_os)" in
      Linux)
        tm="$(cat /proc/sys/kernel/threads-max 2>/dev/null)"
        case "$tm" in ''|*[!0-9]*) tm="" ;; esac
        if [ -n "$tm" ] && [ -n "$n_all" ]; then _take threads-max "$tm" "$n_all"; fi
        # cgroup pids: v2 is `<mount><self cgroup path>/pids.{max,current}`, v1 is
        # `<mount>/pids/pids.{max,current}`. `max` in the limit file means unlimited, not 0.
        cg="$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null | head -1)"
        for _p in "/sys/fs/cgroup${cg}" "/sys/fs/cgroup/pids"; do
          [ -r "$_p/pids.max" ] || continue
          local _mx _cu
          _mx="$(cat "$_p/pids.max" 2>/dev/null)"; _cu="$(cat "$_p/pids.current" 2>/dev/null)"
          case "$_mx" in ''|max|*[!0-9]*) continue ;; esac
          _take cgroup-pids "$_mx" "$_cu"
        done ;;
      Darwin)
        local _mp _mpu
        _mp="$(sysctl -n kern.maxproc 2>/dev/null)"; _mpu="$(sysctl -n kern.maxprocperuid 2>/dev/null)"
        case "$_mp" in ''|*[!0-9]*) _mp="" ;; esac
        case "$_mpu" in ''|*[!0-9]*) _mpu="" ;; esac
        if [ -n "$_mp" ] && [ -n "$n_all" ]; then _take kern-maxproc "$_mp" "$n_all"; fi
        if [ -n "$_mpu" ] && [ -n "$n_uid" ]; then _take kern-maxprocperuid "$_mpu" "$n_uid"; fi ;;
    esac
  fi
  [ -n "$bh" ] || return 1
  printf 'headroom=%s source=%s used=%s limit=%s' "$bh" "${bs:-unknown}" "${bu:-?}" "${bl:-?}"
  return 0
}

# hp_proc_argv <pid> — the process's argv, ONE TOKEN PER LINE. Linux reads /proc/<pid>/cmdline (exact,
# NUL-separated, so a path with a space survives); macOS has no /proc, so `ps -o command=` is the
# portable read on both — it renders argv SPACE-JOINED, which is why a script path containing a space
# cannot be recovered here and the caller reports UNKNOWN rather than guessing a fragment.
hp_proc_argv() {
  local pid="${1:-}" out=""
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  if [ "$(hp_os)" = Linux ] && [ -r "/proc/$pid/cmdline" ]; then
    out="$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null)"
    case "$out" in *[![:space:]]*) printf '%s\n' "$out"; return 0 ;; esac
  fi
  out="$(${HU_PS:-ps} -p "$pid" -o command= 2>/dev/null)" || return 1
  case "$out" in *[![:space:]]*) ;; *) return 1 ;; esac
  printf '%s\n' "$out" | tr ' ' '\n' | sed '/^$/d'
}

# hp_argv_script <argv…> — the orchestration script a process is executing, or nothing. ⛔ THE FIRST
# TOKEN THAT NAMES A SCRIPT, not `$2`: `ps` renders argv joined, and `env VAR=… bash …`, a `-c`
# wrapper and a path with a space all shift the field. Only the filenames the harness's own processes
# execute are candidates, so a shell whose ARGV merely MENTIONS one is not read as running it (the
# same ARGV-shape rule `hu_pids` applies, one level up).
hp_argv_script() {
  local tok
  for tok in "$@"; do
    case "$tok" in */orch-loop.sh) printf '%s' "$tok"; return 0 ;; esac
  done
  return 1
}

# hp_launchd_loaded <label> — macOS: is the job LOADED, and does it HAVE A PROCESS?
# rc: 0 loaded AND running · 1 loaded with NO process (crashed / never started) · 2 NOT LOADED
#     · 3 no launchctl on this box · 4 not a macOS box · 5 cannot-verify (the read failed in a way that
#     says NOTHING about the job) · 142 the bound fired · 125 no usable bound.
#
# ⛔ "LOADED, NO PROCESS" IS NOT A DIAGNOSIS — and on this platform it hid a dead controller for a
# whole night. The brief that produced this row reported `com.eldato.orchestrator-loop` LAST EXIT
# **128** (a fork/spawn failure: `spawn /bin/bash EAGAIN` is rc 128, measured on this box in #2293)
# while the row could only say `LOADED-NO-PROCESS … it is crashing or was never kicked`. Those are
# two different facts with two different responses (NEVER KICKED: kick it · EXITED: read the cause),
# and launchd ALREADY publishes the discriminator in the block this function has in hand:
# `last exit code = N`, plus the launch count `runs = N`.
#
# So the rc=1 arm PARSES those fields out of the SAME read (never a second `launchctl print`: the
# header's own rule) into HP_LAUNCHD_LAST_EXIT / HP_LAUNCHD_RUNS, and the row NAMES the state. The
# parser idiom and the `runs =` field are `launchd-cycle.sh`'s `lc_runs` (:494-504) — this file
# consumes that shape rather than inventing a second one.
#
# ⛔ AND `runs` IS CUMULATIVE, SO IT CANNOT PROVE PERSISTENCE (2026-10-22, review). `lc_runs` calls
# it the job's "cumulative RELAUNCH counter", counted since the job was LOADED — so `runs = 3` is
# equally consistent with "restarted twice, running normally since, then one transient `spawn …
# EAGAIN` now" and with a genuine crash loop. It is therefore REPORTED as evidence and never turned
# into a verdict: the persistence claim is stated CONDITIONALLY ("if it stays in this state every
# attempt is failing"), which follows from `KeepAlive` + `ThrottleInterval` alone. The predicate that
# can actually prove a repeat is `launchd-cycle.sh`'s `lc_assert_stable` — a DELTA over a window —
# and it is deliberately not run here: it costs a throttle-length wait on the `status` path.
# ⛔ THE rc IS NOT THE VERDICT — THE TEXT IS, AND THAT RULE IS NOT THIS FILE'S. Two authorities already
# own "is this launchd job there", and both refuse rc-as-verdict explicitly:
#   * `launchd-cycle.sh`'s `lc_probe`: "ONLY launchd's own SERVICE-level 'no such service' answer counts
#     as ABSENT", and it returns 2 for a read that "FAILED in a way that says nothing about whether the
#     job exists" — because `launchctl print gui/<uid>/<label>` exits non-zero for a DOMAIN-level
#     rejection too (`Bad request.` + `Could not find domain for user gui: <uid>`, e.g. `gui/0` under
#     root or an SSH context with no gui domain);
#   * `orchestrator-bringup.sh`'s `launchd_job_state`: "rc is NOT the verdict", and it leaves
#     JOB_STATE=unknown for anything that is neither rc=0 nor a text-matched not-found.
# A third classifier that read rc as the verdict would answer a confident `NOT LOADED … run install.sh
# --start` about a question nobody answered, with a re-install remedy — the false-PASS shape inverted
# (review round 4). So the SAME text rule is applied here: absence only on launchd's own service-level
# sentence, and everything else non-zero is cannot-verify. (`launchctl list` is not used: its columns are
# `PID STATUS LABEL`, and a `-` PID is a state a reader has to remember to catch.)
hp_launchd_loaded() {
  local label="${1:-}" out="" rc=0
  # The reason a job that is loaded has no process. Reset on EVERY call so a caller that reads two
  # jobs can never report the first one's exit code against the second (the stale-global shape).
  HP_LAUNCHD_LAST_EXIT=""
  HP_LAUNCHD_RUNS=""
  [ "$(hp_os)" = Darwin ] || return 4
  command -v launchctl >/dev/null 2>&1 || return 3
  out="$(hu_bounded "${HU_LAUNCHCTL_TIMEOUT:-10}" launchctl print "gui/$(id -u)/$label" 2>&1)"; rc=$?
  case "$rc" in
    0) : ;;
    142) return 142 ;;
    125) return 125 ;;   # NO USABLE BOUND (perl absent) — launchctl may well be present
    127) return 3 ;;
    *)
      # A here-string, never `printf … | grep -q` (#841).
      case "$out" in
        *"Could not find service"*|*"not find service"*|*"service not found"*) return 2 ;;
      esac
      return 5 ;;
  esac
  grep -q '^[[:space:]]*state = running' <<<"$out" && return 0
  grep -Eq '^[[:space:]]*pid = [0-9]+' <<<"$out" && return 0
  # Loaded with NO process: capture launchd's own explanation before returning the verdict. Both
  # fields are absent on some job kinds, and an ABSENT datum is never rendered as a value ("last
  # exit 0" would be a claim launchd did not make).
  HP_LAUNCHD_LAST_EXIT="$(awk '/^[[:space:]]*last exit code = /{ sub(/^[[:space:]]*last exit code = /, ""); print; exit }' <<<"$out")"
  HP_LAUNCHD_RUNS="$(awk '/^[[:space:]]*runs = /{ sub(/^[[:space:]]*runs = /, ""); print; exit }' <<<"$out")"
  return 1
}
# ══ <<< shim ═════════════════════════════════════════════════════════════════════════════════════

# hu_bounded <secs> <cmd…> — run a command under a HARD bound, on macOS and Linux alike.
# ⛔ PERL'S `alarm`, NOT `timeout`. `timeout` is GNU coreutils and macOS ships it nowhere
# (`gtimeout` only with Homebrew coreutils), so a `timeout` call is rc=127 on the Mac half of the
# fleet. `perl alarm shift; exec @ARGV` re-execs in-place (no extra shell in the tree), and the
# alarm kills the process it was set in — the child — with SIGALRM, so the caller sees 142
# (128+14). Same idiom as `scripts/admin-merge.sh`'s reproduction bound.
# ⛔ NO PERL = NO BOUND = FAIL CLOSED (125). Falling through to an unbounded run would turn "the
# bound is unavailable" into "the thing that was supposed to be bounded is now unlimited", which is
# the fail-open shape this whole file exists against.
# rc: the command's own status · 142 the bound fired · 125 no usable bound.
hu_bounded() { # <secs> <cmd...>
  local s="${1:-}"; shift || true
  command -v perl >/dev/null 2>&1 || return 125
  case "$s" in ''|*[!0-9]*) s="$HU_BOUND_DEFAULT" ;; esac
  [ "$s" -gt 0 ] 2>/dev/null || s="$HU_BOUND_DEFAULT"
  perl -e 'alarm shift; exec @ARGV' "$s" "$@"
}
hu_bound_explain() { # <rc> <secs> — one line naming what the status means
  case "${1:-}" in
    142) printf 'timed out after %ss' "$2" ;;
    125) printf 'NOT RUN — no usable bound (perl is absent), and an unbounded run is not a pass' ;;
    127) printf 'NOT RUN — command not found' ;;
    *)   printf 'exit %s' "${1:-?}" ;;
  esac
}

# hu_pids <exact-script-path>… — pids whose ARGV is `<interpreter> <path>`, one per line.
# ⛔ `ps`, NOT `pgrep`: BSD `pgrep` has no `-c`, and a bare `pgrep -f orch-loop.sh` matches any
# shell running TEXT that mentions the script (measured 2026-10-15: an unscoped read matched four
# controllers on one box). Matching the ARGV SHAPE — the script as its own token — is what makes the
# read mean "a process running THIS file".
# rc=1 when the process table could not be read (and an unreadable read is never "no pids").
hu_pids() { # <path>...
  [ "$#" -gt 0 ] || return 0
  local table
  # `HU_PS` is a seam for the same reason `DRIFT_PS`/`FLEET_PS` are: a test cannot make this box's live
  # controllers disappear, so a suite asserting on the census must be able to SUPPLY the table.
  table="$(${HU_PS:-ps} -eo pid=,command= 2>/dev/null)" || return 1
  case "$table" in *[![:space:]]*) ;; *) return 1 ;; esac
  printf '%s\n' "$table" | HU_WANT="$*" awk '
    BEGIN { n = split(ENVIRON["HU_WANT"], w, " "); for (i = 1; i <= n; i++) want[w[i]] = 1 }
    { pid = $1; cmd = $0; sub(/^[[:space:]]*[0-9]+[[:space:]]+/, "", cmd)
      n = split(cmd, tok, " ")
      if (n >= 2 && (tok[2] in want) && tok[1] ~ /(bash|sh|dash|zsh|ksh)$/) print pid }'
}

# hu_gh_probe — is BOTH "gh present" and "gh authenticated", under a bound.
# ⛔ NEVER `gh auth token`. Measured on these images: it can block until the caller is killed
# (rc=142), and it PRINTS the credential — a probe must not be able to leak one. `gh auth status`
# answers the same question, and `hu_bounded` is what stops it hanging.
# rc: 0 authenticated · 1 present but not authenticated · 3 gh absent · 142 the bound fired.
hu_gh_probe() { # [secs]
  command -v gh >/dev/null 2>&1 || return 3
  hu_bounded "${1:-${HU_GH_TIMEOUT:-20}}" gh auth status >/dev/null 2>&1
}
# Age of a file, in seconds. The two `stat` dialects are `hp_stat_mtime`'s problem, not this one's:
# one implementation of "what is this file's mtime" for the whole file (the shim's rule).
hu_file_age() { # <file> — seconds since mtime; rc=1 when the mtime cannot be read
  local f="${1:-}" t=""
  [ -n "$f" ] && [ -e "$f" ] || return 1
  t="$(hp_stat_mtime "$f")" || return 1
  case "$t" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$(( $(date +%s) - t ))"
}
hu_age_txt() { # <seconds> -> "3s" / "12m" / "2h" / "?"
  case "${1:-}" in ''|*[!0-9]*) printf '?' ;; *) if [ "$1" -lt 90 ]; then printf '%ss' "$1"; elif [ "$1" -lt 5400 ]; then printf '%sm' "$(( $1 / 60 ))"; else printf '%sh' "$(( $1 / 3600 ))"; fi ;; esac
}
# ⛔ `-e`/`-f`/`-L` CANNOT TELL "ABSENT" FROM "I MAY NOT LOOK", and the difference decides whether a start
# is refused or waved through: a pin record behind an unsearchable ancestor, or a mode-000 one, reads
# exactly like a record that was never written — so the pin "resolved" from $REF, the read dir was never
# compared to the pin's tree, and the controller start ran (measured, rounds 8 and 9). The walk below
# names the deepest EXISTING ancestor: searchable ⇒ the path is provably absent, not searchable (or an
# unresolvable link) ⇒ UNEXAMINABLE, which may never be read as absent.
# check-deployed-drift.sh carries the same helper for the same reason: both are deployed SELF-CONTAINED
# (a `lib/` dependency would break $O, which holds only the flat scripts), so the duplication is the
# design, and the two answers must agree — the suite drives both.
#   hu_path_state <path> -> path | absent | unexaminable
hu_path_state() {
  local p="$1" q
  while [ "${#p}" -gt 1 ] && [ "${p%/}" != "$p" ]; do p="${p%/}"; done
  if [ -L "$p" ] && [ ! -e "$p" ]; then printf 'unexaminable'; return 0; fi
  if [ -e "$p" ]; then printf 'path'; return 0; fi
  q="$(dirname "$p")"
  while [ "$q" != "/" ] && [ "$q" != "." ] && [ -n "$q" ]; do
    if [ -L "$q" ] && [ ! -e "$q" ]; then printf 'unexaminable'; return 0; fi
    if [ -e "$q" ]; then
      if [ -x "$q" ]; then printf 'absent'; else printf 'unexaminable'; fi
      return 0
    fi
    q="$(dirname "$q")"
  done
  printf 'absent'
}
# <<< helpers
HU_BOUND_DEFAULT="$BOUND"

# ── platform ─────────────────────────────────────────────────────────────────────────────────────
# Two mechanisms, one entry point. Anything else is refused rather than guessed: a third branch would
# have to invent a start mechanism, and a start mechanism nobody validated is how a box ends up with
# a controller nothing can stop (the same rule `orchestrator-bringup.sh` states).
# ⛔ THROUGH THE SHIM. `HARNESS_UP_OS` is what `hp_os` answers with, so a Linux suite can drive the
# macOS arm — the arm that otherwise ships untested until an operator finds it dead.
HU_OS="$(hp_os)"
case "$HU_OS" in
  Darwin) PLATFORM="mac" ;;
  Linux)  PLATFORM="cell" ;;
  *)      die "unsupported platform ${HU_OS:-unknown} — this entry point knows launchd (Darwin) and the tmux cell (Linux)" 2 ;;
esac

# ── configuration: ONE resolution, the child never re-derives it ─────────────────────────────────
CELL_HOME="${CELL_HOME:-}"
[ -n "$CELL_HOME" ] || CELL_HOME="${HOME:-/tmp/cell-home}"
O="${A_O:-${O:-}}"
# ⛔ A TRAILING SLASH IS THE SAME DIRECTORY: one spelling reaches the rows, the delegation and the
# drift check (a spelling difference is not a difference in what the box runs).
while [ "${#O}" -gt 1 ] && [ "${O%/}" != "$O" ]; do O="${O%/}"; done
[ -n "$O" ] || { if [ "$PLATFORM" = "cell" ]; then O="$CELL_HOME/orchestrator"; else O="$HOME/orchestrator"; fi; }
ENV_FILE="${ENV_FILE:-}"
[ -n "$ENV_FILE" ] || { if [ "$PLATFORM" = "cell" ]; then ENV_FILE="$CELL_HOME/keys.env"; else ENV_FILE="$HOME/.config/orchestrator/bringup.env"; fi; }
REF="$A_REF"
[ -n "$REF" ] || REF="${HARNESS_REF:-origin/main}"

# A `VAR=value` from THIS machine's config file, evaluated so fifty other lines cannot reach us and a
# trailing `exit 0` cannot end the bring-up (the failure `load_config_file` documents).
cfg_value() { # <key> <file>
  local k="${1:?}" f="${2:-}"
  [ -n "$f" ] && [ -f "$f" ] || return 0
  bash -c 'set -a; . "$1" >/dev/null 2>&1; printf "%s" "${!2:-}"' _ "$f" "$k" 2>/dev/null || true
}

# ── TWO repos, because they are two different things ─────────────────────────────────────────────
# HREPO is THE HARNESS CHECKOUT: the repo the pin commit and $REF are commits OF, and the repo whose
# per-commit worktrees are materialised under PIN_ROOT. REPO is THE WORK REPO: the checkout the
# controller reads its backlog from and whose origin `orch-loop.sh` derives `$OR` from. They are the
# same path on a laptop and DIFFERENT on a cell, where the fleet exports REPO=<the work repo>
# (tortoise) while the harness lives in agent-infra.
# ⛔ CONFLATING THEM BROKE BOTH DIRECTIONS AT ONCE (measured 2026-10-22, cell): the pin commit was
# resolved in the WORK repo, which does not contain it, so `pin: UNRESOLVABLE` REFUSED a pin whose
# record and tree agreed perfectly; and the repair a reader reaches for — `--repo <agent-infra>` —
# then wrote `REPO=<agent-infra>` into the child's environment, silently RETARGETING the controller
# at the harness repo's backlog. One variable can never mean both: the pin is a harness-repo commit,
# and REPO is what the lanes work on.
# ⛔ NAME THE VALUE, AND SEPARATE THE TWO WAYS IT CAN BE WRONG. `--repo` is an operator's assertion
# about THIS run, so a mistyped one is REFUSED and NAMED — never silently replaced by a different
# checkout, which is how the pre-split launcher lost the harness/ work distinction in the first place.
# An INHERITED candidate (`HARNESS_REPO`, the config file, the launcher's own checkout) is not an
# assertion about this run: the supervisor PRUNES pin worktrees, so a candidate that has since moved is
# ordinary wear, and the pre-split launcher skipped such a candidate. Refusing EVERY verb on it —
# `down` included — would leave a live controller with no sanctioned way to stop it, which is a worse
# answer than resolving the harness from the next candidate. So: explicit → refuse; inherited → skip,
# SAY SO on stderr, and continue.
HREPO=""
HREPO_BAD=""
# ⛔ `--repo ""` IS AN OPERATOR ASSERTION THAT NAMES NOTHING, so it is REFUSED like any other unusable
# assertion — never read as "no flag". `[ -n "$A_REPO" ]` treated an empty value as absent and then
# resolved the harness from HARNESS_REPO / the launcher's own checkout, i.e. the run answered about a
# checkout the operator never named — the silent-substitution class this block exists to remove. It is
# reachable in the ordinary way (`--repo "$SOME_UNSET_VAR"`). (#2351 review)
if [ "${A_REPO_SEEN:-0}" = 1 ] && [ -z "${A_REPO:-}" ]; then
  die "--repo '' is empty — it must name the HARNESS checkout (the repo the pin commit and --ref are commits OF); an empty value is refused, never read as 'no flag'" 2
fi
if [ -n "${A_REPO:-}" ]; then
  HREPO="$A_REPO"
  [ -d "$HREPO" ] || die "--repo $HREPO is not a directory — --repo names the HARNESS checkout, the repo the pin commit and --ref are commits OF (on a cell that is agent-infra, not the repo the controller drains)" 2
  git -C "$HREPO" rev-parse --git-dir >/dev/null 2>&1 || die "--repo $HREPO is not a git checkout — the pin commit and --ref must be commits OF it" 2
  # ⛔ THE ROOT RULE APPLIES TO THE FLAG TOO: `git -C` WALKS UP, so `--repo <a subdir of a checkout>`
  # would satisfy both guards above and then resolve the pin in the ENCLOSING object DB — the same
  # wrong-repo resolution the inherited candidates are refused for, on the path an operator asserts.
  [ "$(git -C "$HREPO" rev-parse --show-toplevel 2>/dev/null)" = "$(cd "$HREPO" && pwd -P)" ] \
    || die "--repo $HREPO is inside another checkout, not the checkout root — the pin commit and --ref are commits OF the harness repo ROOT" 2
else
  # The candidates, in order: the environment, this machine's config file, then the launcher's OWN
  # checkout — the operative cell path, because a cell's `keys.env` carries `REPO`/`OR` but NOT
  # `HARNESS_REPO` (docs/ops/fleet-harness-baseline.md), so the fallback is what resolves it there.
  # ⛔ `--harness` IS NOT A SOURCE FOR THIS — and never was. It names the DIR the controller reads (on a
  # cell, a pin worktree under PIN_ROOT), not the repo whose object DB the pin is resolved in, and
  # `origin/main` did not accept it either (its candidates were HARNESS_REPO, the config file, the own
  # checkout). Adding it here would silently change which repo answers the pin question on every cell.
  # ⛔ THE CONFIG KEY IS `HARNESS_REPO`, NEVER `REPO`: `REPO` is the WORK repo (read below), and taking
  # it here is precisely the conflation this block removes — the flat-copy layout (a deployed copy
  # outside any checkout) still has a way to name its harness, under a key that means one thing.
  for cand in "${HARNESS_REPO:-}" "$(cfg_value HARNESS_REPO "$ENV_FILE")" \
              "$(git -C "$SELF_PATH" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0,10); exit}')"; do
    [ -n "$cand" ] || continue
    [ -d "$cand" ] || { warn "harness: ignoring '$cand' (not a directory) — trying the next candidate"; continue; }
    git -C "$cand" rev-parse --git-dir >/dev/null 2>&1 \
      || { warn "harness: ignoring '$cand' (not a git checkout) — trying the next candidate"; continue; }
    # ⛔ `rev-parse --git-dir` WALKS UP, so it answers "is this inside some repo", not "is this the repo".
    # A pruned or mistyped path that now sits INSIDE another checkout (the ordinary way a stale path comes
    # to exist) would be accepted and the pin resolved in that foreign object DB — the #2356 symptom, one
    # inherited candidate further in. Require the candidate to BE a toplevel.
    if [ "$(git -C "$cand" rev-parse --show-toplevel 2>/dev/null)" != "$(cd "$cand" && pwd -P)" ]; then
      warn "harness: ignoring '$cand' (inside another checkout, not a checkout root) — trying the next candidate"
      continue
    fi
    HREPO="$cand"; break
  done
  # ⛔ UNRESOLVABLE IS A HELD VERDICT TOO, NOT A UNIVERSAL REFUSAL (review P1): `down` reads no harness at
  # all — it delegates to the authority's own `stop` — so a box that names its work repo but not a harness
  # (the flat-copy layout, or a cell whose agent-infra main worktree was pruned) must still be stoppable.
  # on `origin/main` that invocation REACHED cmd_down; dying here would have removed it one verb at a time.
  [ -n "$HREPO" ] || HREPO_BAD="no agent-infra checkout resolved — pass --repo <path>, set HARNESS_REPO, or run from a checkout"
fi
# The WORK repo: the caller's REPO first (a lane's own checkout), then this machine's config file, and
# only then the harness checkout — the pre-split behaviour for a box that configures neither.
# ⛔ NAME WHERE THE REFUSED VALUE CAME FROM. `--repo` sets the HARNESS and can no longer change REPO, and
# when the value came from the config file `unset REPO` is not even a change — the next run re-reads the
# same value. Both remedies in the old text were INERT for the value it refused (measured: `--repo
# <harness>` on a REPO from `ENV_FILE` gives the identical rc 2), which is the same "a refusal that steers
# the reader somewhere unhelpful" class this block exists to remove.
REPO_SRC=""
if [ -n "${REPO:-}" ]; then
  REPO_SRC="the environment"
else
  REPO="$(cfg_value REPO "$ENV_FILE")"
  if [ -n "$REPO" ]; then REPO_SRC="the config file $ENV_FILE"; fi
fi
# ⛔ UNSET AND SET-BUT-WRONG ARE NOT THE SAME STATE. Unset legitimately falls back to the harness checkout
# (a box that configures neither — the pre-split behaviour). A REPO that is SET and is not a directory is a
# CONFIGURATION ERROR and is refused, because substituting the harness here would export
# `REPO=<agent-infra>` to the controller and `orch-loop.sh` would derive `$OR` from agent-infra's origin —
# the silent wrong-backlog retarget this whole block exists to prevent, one case further down.
REPO_BAD=""
if [ -z "$REPO" ]; then REPO="$HREPO"
elif [ ! -d "$REPO" ]; then REPO_BAD="REPO=$REPO is set (by $REPO_SRC) but is not a directory — REPO names the WORK repo the controller drains, not the harness; --repo sets the HARNESS checkout and cannot change REPO — set REPO to a work-repo checkout, or remove it from $REPO_SRC to fall back to the harness"
# ⛔ A DIRECTORY IS NOT A CHECKOUT. The controller derives its owner/repo from `$REPO`'s ORIGIN
# (`orch-loop.sh` `derive_or`); handed a directory that is not a repo it WARNS and falls back to a
# hardcoded literal — a controller grading a repo nobody named, while this launcher reports it started.
# The pre-split code validated this (it was the only repo it had); the split must not lose it.
elif ! git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then REPO_BAD="REPO=$REPO is set (by $REPO_SRC) but is not a git checkout — the controller derives the repo it drains from that checkout's origin, so a plain directory would silently grade a different repo — set REPO to a work-repo checkout, or remove it from $REPO_SRC to fall back to the harness"
fi
# ⛔ THE VERDICT IS HELD HERE AND APPLIED BY THE VERB — a refusal is not a universal verb policy.
# `up` STARTS a controller that would drain a repo nobody named, so it REFUSES (nothing is started).
# Every OTHER verb must stay answerable: `down`/`status` are what an operator reaches for on a machine
# that is wrong, and that is the authority's own stated rule (`orchestrator-bringup.sh` `cmd_stop`:
# "REPORT, never die: `stop` is the verb an operator reaches for on a machine that is wrong, and it must
# stay answerable"). It also closes an escape this split would otherwise remove: `--repo` no longer sets
# REPO, so a launcher that died for every verb would leave a box with a stale REPO unstoppable until the
# operator edited their shell.
# ⛔ AND THE BAD VALUE IS NOT SUBSTITUTED for the non-`up` verbs: exporting the harness as REPO is the
# silent wrong-backlog retarget this whole block exists to prevent, so it is passed through and NAMED.

# The pin records. Both are CELL concepts; a Mac's `$O` is operator-synced and has neither.
PIN_ROOT="${A_PINDIR:-${HARNESS_PIN_DIR:-}}"
PIN_FILE="${A_PIN:-${HARNESS_PIN_FILE:-}}"
PIN_SHA_FILE="${HARNESS_PIN:-${CELL_HOME}/.pi/agent/state/HARNESS-PIN}"
PIN_PRESENT=0
[ -n "$PIN_ROOT" ] || PIN_ROOT="$CELL_HOME/harness"
[ -n "$PIN_FILE" ] || PIN_FILE="$CELL_HOME/.harness-path"
# "This box has pin machinery" = someone configured it, or the records exist. ⛔ NOT "the defaults
# exist": the defaults are what create the nobody-reads-it worktree, so they must not be what makes a
# Mac look like a cell.
if [ -n "${HARNESS_PIN_FILE:-}${HARNESS_PIN_DIR:-}${A_PIN:-}${A_PINDIR:-}" ] \
   || [ -f "$PIN_FILE" ] || [ -f "$PIN_SHA_FILE" ] \
   || [ "$(hu_path_state "$PIN_FILE")" = unexaminable ] \
   || [ "$(hu_path_state "$PIN_SHA_FILE")" = unexaminable ]; then PIN_PRESENT=1; fi

# The harness dir the controller will actually READ. ⛔ Order matters: an explicit --harness, then
# the DIR record, then `$HARNESS`, then this checkout's sibling. The pin DIR record beats a bare
# directory guess because it is what the supervisor's own `start` execs.
HARNESS="${A_HARNESS:-${HARNESS:-}}"
HARNESS_SRC="--harness/\$HARNESS"
# ⛔ THE DIR RECORD IS READ THROUGH THE STATE HELPER, and a record that cannot be read REFUSES the run:
# falling back to this checkout would run a tree the record may not name, which is the #2216 shape with
# the sign flipped. `absent` is the normal pre-install state and still falls back.
case "$(hu_path_state "$PIN_FILE")" in
  path)
    if [ -r "$PIN_FILE" ] && [ -z "$HARNESS" ]; then HARNESS="$(head -1 "$PIN_FILE" 2>/dev/null)"; HARNESS_SRC="$PIN_FILE"
    elif [ ! -r "$PIN_FILE" ]; then die "the harness DIR record $PIN_FILE exists but cannot be read, so the tree this box reads cannot be identified — nothing was started" 3; fi ;;
  unexaminable) die "the harness DIR record $PIN_FILE cannot be examined (an unsearchable ancestor or an unresolvable link) — nothing was started" 3 ;;
esac
if [ -z "$HARNESS" ]; then HARNESS="$SELF_PATH/orchestrator-harness"; HARNESS_SRC="this checkout"; fi
HARNESS="${HARNESS%/}"

# The environment every delegation carries. ⛔ Built ONCE, here, and exported INTO the child by
# `hu_run` (below): a tmux server does not inherit caller exports, and a child that re-derives a
# default is exactly how a re-pin lands in a worktree nobody reads (#2216).
HU_ENV=()
hu_env_add() { HU_ENV+=("$1=$2"); }
hu_env_add CELL_HOME "$CELL_HOME"
hu_env_add O "$O"
hu_env_add REPO "$REPO"
hu_env_add HARNESS_REPO "$HREPO"
hu_env_add HARNESS_REF "$REF"
hu_env_add ENV_FILE "$ENV_FILE"
# ⛔ HARNESS IS UNCONDITIONAL. It used to be added only on a box with pin machinery, so on a PIN-LESS
# box (every laptop) the delegated `check-deployed-drift.sh --surface` received an EMPTY HARNESS and
# never compared the tree this launcher prints it is about to run — the self-test gate passed over a dir
# it had not examined (measured, round 5). The pin records are the conditional part; the harness is not.
hu_env_add HARNESS "$HARNESS"
[ "$PIN_PRESENT" -eq 1 ] && { hu_env_add HARNESS_PIN_DIR "$PIN_ROOT"; hu_env_add HARNESS_PIN_FILE "$PIN_FILE"; }
# HOME on a cell is the cell home (measured: `cmux vm exec` runs as a user whose $HOME does not
# exist, so gh's credentials at $HOME/.config/gh are not reachable and every gh call fails).
[ "$PLATFORM" = "cell" ] && hu_env_add HOME "$CELL_HOME"
# hu_run <secs> <cmd…> — run a delegation WITH this box's configuration inside the process.
# ⛔ NOT `env VAR=… hu_bounded …`: `env` execs a PROGRAM, and `hu_bounded` is a shell FUNCTION — so the
# `env` form dies with `env: 'hu_bounded': No such file or directory` (rc=127) and every delegation
# that used it silently started nothing. Measured by this suite: the controller authority was never
# invoked while `up` still printed its banner. The configuration is exported inside a SUBSHELL, so it
# reaches the child (a tmux server does not inherit caller exports — that is why it is passed at all)
# and this shell is left unchanged.
hu_run() { # <secs> <cmd…>
  local s="$1"; shift
  (
    local _kv
    for _kv in "${HU_ENV[@]}"; do export "$_kv"; done
    hu_bounded "$s" "$@"
  )
}

# ── the self-test gate ───────────────────────────────────────────────────────────────────────────
# The suites that already exist. Each is the shipped instrument for its own question, and this is the
# only place that runs them TOGETHER before a start.
# ⛔ A FAILING SELF-TEST REFUSES THE START, and the refusal NAMES the test. The alternative — start
# anyway and hope — is what put a controller on a tree whose own suite was red, and the operator only
# found out from the work that did not happen.
SELFTESTS="${HARNESS_UP_SELFTESTS:-check-single-source.sh selftest.sh check-deployed-drift.sh}"
selftest_args() { # <script> -> extra argv (a literal list; never caller input)
  case "$1" in
    check-deployed-drift.sh) printf '%s' '--surface --no-fetch' ;;
    *) : ;;
  esac
}
hu_run_selftests() { # rc=0 all passed · 1 a test failed (named on stdout/stderr)
  local t args rc failed=0
  for t in $SELFTESTS; do
    [ -f "$HARNESS/$t" ] || { warn "SELFTEST MISSING: $HARNESS/$t — cannot verify this tree, so nothing starts (fail closed)"; failed=1; continue; }
    args="$(selftest_args "$t")"
    log_line "selftest: $t${args:+ $args}"
    # The extra argv is a WORD SPLIT on purpose: it is a literal list above, never caller input.
    # shellcheck disable=SC2086
    hu_run "$BOUND" bash "$HARNESS/$t" $args >"$HU_TMP/selftest.log" 2>&1
    rc=$?
    # ⛔ DRIFT DOES NOT REFUSE — A RECORDED DECISION, NOT A CONVENIENCE. `orchestrator-bringup.sh:563-567`
    # measured it: `start` DEPLOYS the harness into $O before it launches, so "the deployed copy differs
    # from the ref" is precisely the state `start` exists to repair, and refusing it here would
    # false-block the one command that fixes it. Exit 1 (DRIFT) is reported and the start continues;
    # exit 2 (BROKEN / cannot-verify) still refuses, because that is "I could not look".
    if [ "$t" = "check-deployed-drift.sh" ] && [ "$rc" -eq 1 ]; then
      warn "selftest: $t reports DRIFT (exit 1) — reported, not refused: a start repairs the deployed copy"
      tail -n 8 "$HU_TMP/selftest.log" 2>/dev/null | sed 's/^/    /'
      continue
    fi
    if [ "$rc" -ne 0 ]; then
      failed=1
      log_line "selftest FAILED: $t — $(hu_bound_explain "$rc" "$BOUND")"
      tail -n 12 "$HU_TMP/selftest.log" 2>/dev/null | sed 's/^/    /'
    else
      log_line "selftest ok: $t"
    fi
  done
  return "$failed"
}

# ── the pin identity check ───────────────────────────────────────────────────────────────────────
# Answers ONE question: is the dir the pin NAMES the dir the controller READS?
# rc: 0 ok (or legitimately one launch behind) · 1 MISMATCH (refused) · 2 cannot-verify (refused)
#     · 4 not applicable on this box. HU_PIN_PENDING=1 means "the pin advanced, this launch has not
#     moved yet" — which the start MUST resolve by materialising the pin, so `up` re-verifies after it.
#
# ⛔ THE ONE-LAUNCH-BEHIND CASE IS NOT A MISMATCH, AND CONFLATING THEM IS A FALSE BLOCK. #2216's own
# contract: `--pin-only` advances the pin and deliberately leaves the running tree alone, so between a
# re-pin and the next `start` the two records legitimately disagree. That is `restart-pending`, and the
# start is what closes it. What is NOT legitimate — and is the defect this check exists for — is a pin
# whose tree lives somewhere the runtime never reads (#2216: a refresh run under the default
# `$CELL_HOME/harness` created a worktree nobody read, reported success, and advanced nothing).
# So: same tree = OK · a tree UNDER the pin root that is an ancestor of the pin = restart-pending ·
# anything else = MISMATCH.
HU_PIN_PENDING=0
hu_real() { ( cd "${1:-/nonexistent}" 2>/dev/null && pwd -P ); }
# ⛔ TWO PATHS ARE THE SAME REPO ONLY WHEN BOTH RESOLVE AND THE RESULTS MATCH. `hu_real` prints NOTHING
# for a path that does not exist, so a bare `[ "$(hu_real a)" = "$(hu_real b)" ]` declares two MISSING
# paths EQUAL — and in the claims row that means a record about a repo this box does not drain is reused
# as an answer (`OK (refs/claims reachable)`) with no probe run, which is the exact false PASS that row
# exists to prevent. An EMPTY resolution is the ABSENCE of an identity, never an identity shared by two
# paths (#2351 review, reproduced: both-missing read OK and the record was left untouched).
hu_same_repo() { # <a> <b> — resolved equality; an empty resolution on either side is NOT equality
  local ra rb
  ra="$(hu_real "${1:-}")"; rb="$(hu_real "${2:-}")"
  [ -n "$ra" ] && [ -n "$rb" ] && [ "$ra" = "$rb" ]
}
# ⛔ THE PATH IS NOT THE FACT. `refs/claims` reachability is a property of the checkout's ORIGIN, so a
# checkout re-cloned or repurposed AT THE SAME PATH keeps the previous repo's answer: `$O/state` lives
# OUTSIDE the checkout, so it survives the re-clone, and a path-only record then reads `OK (refs/claims
# reachable)` for a repo nobody probed — for up to HU_CLAIMS_STALE. The record therefore carries the
# origin it probed, and reuse requires that origin to still be this checkout's. An ABSENT `origin=`
# (records written before this field existed, or a checkout with no readable remote) keeps the old
# path-only behaviour, so nothing reds on an old box.
hu_origin() { git -C "${1:-/nonexistent}" remote get-url origin 2>/dev/null || true; }
hu_same_origin() { # <recorded> <live> — empty RECORDED ⇒ legacy path-only ⇒ same
  local a="${1:-}" b="${2:-}"
  [ -z "$a" ] && return 0
  a="${a%/}"; a="${a%.git}"; b="${b%/}"; b="${b%.git}"
  [ -n "$b" ] && [ "$a" = "$b" ]
}
# The record is `claims=<v> repo=<path> [origin=<url>] at=<ts>`; the repo path may contain spaces, so the
# parse is anchored on `at=` and the OPTIONAL field is split from the END of the repo field.
hu_rec_parse() { # <file> — sets HU_REC_REPO / HU_REC_ORIGIN (empty when absent)
  local line rest
  HU_REC_REPO=""; HU_REC_ORIGIN=""
  line="$(sed -n 's/^claims=[^ ]* //p' "$1" 2>/dev/null | head -1)"
  # ⛔ THE REMAINDER MUST *BE* THE REPO FIELD. Without this, the oldest record shape —
  # `claims=reachable at=1`, which a box started by an older launcher still holds — parsed as
  # repo="at=1": a NON-EMPTY, foreign repo, so the row re-probed and a deliberately AGED record read as a
  # fresh OK instead of LATE (caught by harness-cohesion's aged-record arm). No `repo=` ⇒ unattributed.
  case "$line" in repo=*) ;; *) return 1 ;; esac
  rest="${line% at=*}"
  rest="${rest#repo=}"
  case "$rest" in
    *' origin='*) HU_REC_REPO="${rest% origin=*}"; HU_REC_ORIGIN="${rest##* origin=}" ;;
    *)            HU_REC_REPO="$rest" ;;
  esac
  return 0
}
hu_verify_pin() { # [strict] — strict=1 refuses a legitimate restart-pending (used after a start)
  local strict="${1:-0}" sha want got real_want real_got got_head got_root
  HU_PIN_PENDING=0
  if [ "$PIN_PRESENT" -eq 0 ]; then
    log_line "pin: SKIPPED (no pin machinery on this box — HARNESS_PIN_DIR/HARNESS_PIN_FILE are unset and $PIN_FILE does not exist; the controller runs from $HARNESS)"
    return 4
  fi
  # ⛔ AN EMPTY HARNESS IS NOT A BYPASS. `git -C ""` addresses the PROCESS CWD's repo (verified on git
  # 2.43), so a box with no resolvable harness would otherwise answer this row from whatever checkout the
  # operator happens to stand in — `pin: OK` for a repo the launcher never identified, feeding the single
  # verdict. The row is UNRESOLVED (cannot-verify), never a pass.
  [ -n "$HREPO" ] || { log_line "pin: UNRESOLVED — no harness repo resolved (see the harness-up warning above), so the pin cannot be resolved in one"; return 2; }
  # ⛔ AN UNREADABLE RECORD IS NOT AN ABSENT ONE. `head` on a mode-000 file, or on a path behind an
  # unsearchable ancestor, prints nothing — exactly like a record that was never written — so the pin
  # "resolved" from $REF, the read dir was never compared to the pin's tree, and the controller start
  # ran (measured, round 8). The file's CONTENT (when readable) is what refuses that box; a reader that
  # cannot see it must not return a weaker verdict than the one that can.
  case "$(hu_path_state "$PIN_SHA_FILE")" in
    unexaminable)
      log_line "pin: UNEXAMINABLE — $PIN_SHA_FILE cannot be examined (an unsearchable ancestor or an unresolvable link), so the harness this box is pinned to cannot be resolved"
      return 2 ;;
    path)
      if [ ! -r "$PIN_SHA_FILE" ]; then
        log_line "pin: UNREADABLE — $PIN_SHA_FILE exists but cannot be read, so the harness this box is pinned to cannot be resolved"
        return 2
      fi
      # ⛔ `-e` IS TRUE FOR A DIRECTORY, and `head -1 <dir>` yields nothing — which this function then
      # read as "ABSENT, the first start records it" (rc=0), i.e. the gate that authorises `up` passed a
      # record whose commit cannot be read. Same rule install.sh states: an unreadable record is never an
      # absent one.
      if [ ! -f "$PIN_SHA_FILE" ]; then
        log_line "pin: NOT A REGULAR FILE — $PIN_SHA_FILE exists but is not a regular file, so the harness this box is pinned to cannot be read (cannot-verify is never an absent pin)"
        return 2
      fi ;;
  esac
  sha="$(head -1 "$PIN_SHA_FILE" 2>/dev/null | tr -d '[:space:]')"
  if [ -z "$sha" ]; then
    # ⛔ ABSENT IS NOT A REFUSAL. The brief's own resolution order is "HARNESS-PIN, else origin/main":
    # a box that has never been pinned is resolved from the ref it is asked to run, and the FIRST start
    # is what creates the record (harness-refresh's mend, exit 11). Refusing here would make the
    # mender unreachable behind the gate that needs it — a permanent self-inflicted block.
    local tipsha
    tipsha="$(git -C "$HREPO" rev-parse --verify --quiet "$REF^{commit}" 2>/dev/null)" || tipsha=""
    if [ -z "$tipsha" ]; then
      log_line "pin: UNRESOLVABLE — nothing is recorded in $PIN_SHA_FILE and $REF does not resolve in $HREPO"
      return 2
    fi
    log_line "pin: ABSENT — nothing is recorded in $PIN_SHA_FILE; resolved ${tipsha:0:12} from $REF (the first start records it)"
    return 0
  fi
  sha="$(git -C "$HREPO" rev-parse --verify --quiet "${sha}^{commit}" 2>/dev/null)" || sha=""
  if [ -z "$sha" ]; then
    log_line "pin: UNRESOLVABLE — the commit in $PIN_SHA_FILE is not an object in the harness repo $HREPO"
    return 2
  fi
  want="$PIN_ROOT/${sha:0:12}/scripts/orchestrator-harness"
  got="$HARNESS"
  real_want="$(hu_real "$want")"
  real_got="$(hu_real "$got")"
  log_line "pin: commit ${sha:0:12} (from $PIN_SHA_FILE), pin root $PIN_ROOT"
  if [ -z "$real_got" ]; then
    log_line "pin: UNREADABLE — the harness dir ($got, from $HARNESS_SRC) does not exist or cannot be entered"
    return 2
  fi
  if [ ! -r "$real_got/orch-loop.sh" ]; then
    log_line "pin: UNREADABLE — $real_got/orch-loop.sh cannot be read (it is the file the controller execs)"
    return 2
  fi
  if [ -n "$real_want" ] && [ "$real_want" = "$real_got" ]; then
    log_line "pin: OK — the pin, the pin root, and the dir the controller reads are the same tree ($real_got)"
    return 0
  fi
  # ⛔ THE PIN-ROOT SHAPE IS A CONVENTION, NOT THE PROPERTY THAT MATTERS, AND DEMANDING IT FALSE-BLOCKS THE
  # BOX agent-infra#2231 CREATES. `cloud-cell-supervisor.sh apply` answers `unchanged` — and writes NO
  # record — when the box's checkout is ALREADY at the ref, precisely so an operator's checkout is never
  # disturbed; install.sh (the Mac) then records THAT tree. On such a box the pin record, the sha record
  # and the dir the controller execs all agree, and this function still said NOT MATERIALISED/BROKEN and
  # `up` refused it (rc=3) — "installed" meaning "not startable". The shape was standing in for one
  # fact — the dir is a worktree AT THE RECORDED COMMIT — so check that fact directly, and keep every
  # other refusal (missing, unreadable, no orch-loop.sh) exactly as they are.
  local got_head
  got_head="$(git -C "$real_got" rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null)" || got_head=""
  if [ -n "$got_head" ] && [ "$got_head" = "$sha" ]; then
    log_line "pin: OK — the dir the controller reads ($real_got) is a worktree at the pinned commit ${sha:0:12} (it is not under $PIN_ROOT: the materialiser leaves a checkout that already IS the ref where it is)"
    return 0
  fi
  if [ -z "$real_want" ]; then
    # ⛔ TWO DIFFERENT STATES WEAR THE SAME SENTENCE, and conflating them is a permanent false block:
    #  (a) a CELL whose pin root EXISTS and whose pinned tree is missing → the materialisation failed,
    #      and starting would run a tree the pin does not name → refuse (below);
    #  (b) a box with NO PIN MACHINERY MATERIALISED ($PIN_ROOT does not exist at all — a laptop whose
    #      `$O` is operator-synced, or a box whose first refresh just recorded a pin) → there is no
    #      tree to compare against, and refusing would block the very start that has to create it.
    #      Accepted, and SAID, because it is a weaker claim than "the pin and the read dir agree".
    if [ ! -d "$PIN_ROOT" ]; then
      log_line "pin: RECORDED-NOT-MATERIALISED — $PIN_SHA_FILE names ${sha:0:12} but the pin root $PIN_ROOT does not exist on this box, so nothing is pinned to a tree here; starting from $real_got ($HARNESS_SRC)"
      return 0
    fi
    log_line "pin: NOT MATERIALISED — the pin names $want, which does not exist, so a start from $real_got would run code the pin does not name. Remedy: materialise the pin (cloud-cell-supervisor.sh apply)."
    return 1
  fi
  # The dir the controller reads is a PINNED WORKTREE (root = the repo at that commit). Its commit is
  # read from git, never from the path spelling: a directory's name is not evidence of its content.
  got_root="$(git -C "$real_got" rev-parse --show-toplevel 2>/dev/null)"
  got_head=""; [ -n "$got_root" ] && got_head="$(git -C "$got_root" rev-parse --verify --quiet HEAD 2>/dev/null)"
  got_root="$(hu_real "$got_root")"
  if [ -n "$got_head" ] && [ -n "$got_root" ] && [ "$got_root" != "$(hu_real "$PIN_ROOT")" ] \
     && git -C "$HREPO" merge-base --is-ancestor "$got_head" "$sha" 2>/dev/null; then
    HU_PIN_PENDING=1
    if [ "$strict" = 1 ]; then
      log_line "pin: STALE AFTER START — the box still reads ${got_head:0:12} while the pin names ${sha:0:12}; the start did not move it onto the pin"
      return 1
    fi
    log_line "pin: restart-pending — the box reads ${got_head:0:12}, the pin names ${sha:0:12} (an ancestor). This start must materialise the pin; it is re-checked after the components come up."
    return 0
  fi
  # ⛔ THE MEASURED #2216 SHAPE, said with BOTH paths: "they disagree" without them is unactionable.
  log_line "pin: MISMATCH — the pin resolves to $real_want but the controller READS $real_got ($HARNESS_SRC)."
  log_line "      A re-pin would create a worktree nobody reads; refusing rather than starting a tree the pin does not name."
  return 1
}

# ── component rows ──────────────────────────────────────────────────────────────────────────────
# ⛔ WHAT THIS IS AND IS NOT. `orchestrator-bringup.sh status` (over `lib/fleet-inventory.sh`,
# `fleet_row_controller` at :422-479) remains the FLEET inventory of record: it enumerates every
# component the fleet declares and prints COMPONENT | EXPECTED | ACTUAL | STATE. These rows are the
# subset THIS launcher starts, read with the same `ps` ARGV shape and the same DUPLICATE/LATE/MISSING
# vocabulary — including the two rows nothing in the fleet can answer (pin, claims) and the one that
# delegates (drift). It does not replace that inventory and must not grow a second copy of it.
# ONE line per component: NAME | PID | AGE | STATE. PID/age are `-` where the component is data
# rather than a process (the claim registry, the pin), and that is stated rather than faked.
HU_ROWS=""
hu_row() { HU_ROWS="$HU_ROWS$1|$2|$3|$4
"; }

# ── the BOX row: WHICH machine is answering, and WHICH PIN it is on (agent-infra#2231/#2232) ────
# ⛔ "ALL MACHINES AUTONOMOUS" WAS UNANSWERABLE FROM ONE PLACE. Every row below describes a PROCESS on
# this box; none of them names the box, and on a Mac none of them could name a pin at all (the pin
# machinery was cell-only, so `status` printed `pin: SKIPPED (no pin machinery on this box)` and the
# Mac was the one machine whose harness identity had no answer). The fleet is five boxes running the
# same queue, so a status screen that cannot say "this is <host>, pinned to <sha>" forces an operator
# to ssh into each one and hold five answers in their head — which is the shape that let the Mac drift
# for as long as it did. With this row, `harness-status` on each box answers the same question in the
# same shape, and the Mac is one of the boxes rather than the exception.
#
# Columns: PID column = the HOST (this box's identity), AGE column = the PIN (the sha it runs). Both
# are data, not processes — stated in the row rather than faked as a pid/age.
# rc: 0 a pin is named · 1 no pin recorded (the box runs SOMETHING unnamed: a degradation, not a pass)
#     · 2 the pin record exists but cannot be read (cannot-verify, never a pass)
hu_row_box() { # [strict-pin-dir]
  local host sha host_src
  # `scutil --get ComputerName` is macOS's user-visible name and needs no privilege; uname -n is the
  # portable answer and is what the cells have. Neither is required for the verdict, so a failure is
  # not a refusal — it must still be NAMED rather than printed as an empty column.
  host="$(uname -n 2>/dev/null)"; [ -n "$host" ] || host="unknown"
  host_src="uname -n"
  if [ "$PLATFORM" = "mac" ] && command -v scutil >/dev/null 2>&1; then
    local sc; sc="$(scutil --get ComputerName 2>/dev/null)"
    [ -n "$sc" ] && { host="$sc"; host_src="scutil ComputerName"; }
  fi
  case "$(hu_path_state "$PIN_SHA_FILE")" in
    unexaminable) hu_row box "$host" - "BROKEN (the pin record $PIN_SHA_FILE cannot be examined — cannot-verify is never a pass)"; return 2 ;;
    absent)       hu_row box "$host" - "NO PIN (no $PIN_SHA_FILE: this box runs a harness nothing names; the Mac is pinned by install.sh, a cell by cloud-cell-supervisor.sh apply)"; return 1 ;;
  esac
  if [ ! -r "$PIN_SHA_FILE" ]; then
    hu_row box "$host" '?' "BROKEN (the pin record $PIN_SHA_FILE exists but cannot be read)"; return 2
  fi
  # ⛔ `-e` IS TRUE FOR A DIRECTORY, and `head -1 <dir>` reads nothing — which the row below reported as
  # "NO PIN (… is EMPTY)", i.e. it described an EMPTY FILE for a record that is not a file at all. Same
  # rule the rest of this file now applies: an unreadable record is never an absent one.
  if [ ! -f "$PIN_SHA_FILE" ]; then
    hu_row box "$host" '?' "BROKEN (the pin record $PIN_SHA_FILE exists but is NOT A REGULAR FILE — cannot-verify is never an empty pin)"; return 2
  fi
  sha="$(head -1 "$PIN_SHA_FILE" 2>/dev/null | tr -d '[:space:]')"
  if [ -z "$sha" ]; then
    hu_row box "$host" - "NO PIN (the pin record $PIN_SHA_FILE is EMPTY: an empty pin reads as current to nothing, so this is not a pass)"; return 1
  fi
  # ⛔ THE SHA IS SHORTENED HERE FOR THE COLUMN ONLY; the row also prints the HARNESS DIR, because a
  # sha without a path cannot be checked against what the controller execs (that comparison is the
  # `pin:` line, which hu_verify_pin owns — one implementation, not two).
  hu_row box "$host" "${sha:0:12}" "OK ($PLATFORM via $host_src; harness $HARNESS)"
  return 0
}

# controller pids, SCOPED to this state dir AND to the harness path this box runs from. Both are
# required: the cell controller's argv is `<harness>/orch-loop.sh`, not `$O/orch-loop.sh` (measured
# 2026-10-17 — a read scoped to `$O` alone found NO controller over a live loop).
hu_ctrl_pids() {
  local pids table
  pids="$(hu_pids "$HARNESS/orch-loop.sh" "$O/orch-loop.sh" 2>/dev/null)" || return 1
  pids="$(printf '%s\n' "$pids" | sed '/^$/d')"
  [ -n "$pids" ] || return 0
  # ⛔ A CONTROLLER'S OWN DESCENDANT IS NOT A SECOND CONTROLLER (measured on this cell 2026-10-22,
  # while testing the heal path): `orch-loop.sh` re-execs itself for its per-cycle self-refresh
  # (#2215), so the ARGV census legitimately matched the controller AND its short-lived child, and the
  # row said `DUPLICATE (3 live — one controller per repo)` → `VERDICT: BROKEN` on a box with ONE
  # controller. That verdict is not merely wrong, it invites the one action the row exists to forbid:
  # killing a "duplicate" that is the controller's own refresh. The census therefore drops any pid
  # whose ANCESTOR is also in the set — the parent chain, read once, bounded at 40 levels, and only
  # when the ppid table is readable (an unreadable table keeps the raw set, which is what the row
  # reported before, rather than silently deciding the question on no evidence).
  table="$(${HU_PS:-ps} -eo pid=,ppid= 2>/dev/null)" || table=""
  case "$table" in *[![:space:]]*) : ;; *) printf '%s\n' "$pids"; return 0 ;; esac
  printf '%s\n' "$table" | HU_SET="$pids" awk '
    BEGIN { n = split(ENVIRON["HU_SET"], a, "\n"); for (i = 1; i <= n; i++) if (a[i] != "") set[a[i]] = 1 }
    { if ($1 != "") par[$1] = $2 }
    END {
      for (p in set) {
        x = par[p]; d = 0
        while (x != "" && x != "0" && d++ < 40) { if (x in set) { drop[p] = 1; break } x = par[x] }
      }
      for (p in set) if (!(p in drop)) print p
    }' | sort -n
}
# The fresh bound for the controller's own heartbeat: `orch-loop.sh` sleeps CYC (240 s default) and
# rewrites `$O/heartbeat` every cycle, so silence past several cycles is the "alive but wedged" state.
HU_HEARTBEAT_STALE="${HARNESS_UP_HEARTBEAT_STALE:-1800}"
HU_REFRESH_STALE="${HARNESS_UP_REFRESH_STALE:-900}"

hu_row_refresh() {
  local f="$O/state/harness-refresh" age rel="" fet=""
  if [ ! -f "$f" ]; then hu_row refresh - - "MISSING (never ran: $f)"; return 1; fi
  # ⛔ BOTH SPELLINGS, CANONICAL FIRST. The file on a live box is written by `orch-loop.sh` as
  # `relation=…`; the refresh's STDOUT line (`harness relation=…`) is the other spelling. Parsing only
  # the latter reported "UNKNOWN (no relation= record)" — and therefore BROKEN — on every healthy box
  # after the controller's first cycle (measured in review).
  rel="$(sed -n 's/^relation=\([a-z-]*\).*/\1/p' "$f" 2>/dev/null | head -1)"
  [ -n "$rel" ] || rel="$(sed -n 's/^harness relation=\([a-z-]*\).*/\1/p' "$f" 2>/dev/null | head -1)"
  age="$(hu_file_age "$f")" || { hu_row refresh - "?" "UNKNOWN (cannot read $f)"; return 2; }
  if [ "$age" -gt "$HU_REFRESH_STALE" ]; then hu_row refresh - "$(hu_age_txt "$age")" "LATE (relation=${rel:-unknown}, older than ${HU_REFRESH_STALE}s)"; return 1; fi
  # ⛔ THE ROW MUST APPLY THE SAME `fetch=` RULE AS THE TWO READERS OF THAT FIELD. `orch-loop.sh:712`
  # rewrites a non-`ok` fetch into the relation, and `cloud-cell-supervisor.sh:2260-2262` calls it
  # cannot-verify; reading only `relation=` here made the box's verdict depend on WHICH WRITER wrote the
  # record last — the `up`-written record said OK for a `--no-fetch` comparison (measured in review).
  # `fetch=` sits AFTER `relation=` on the one line the controller writes, so the match is on the
  # space-delimited field, not on a line start (an anchored parse read nothing and reported OK).
  fet="$(sed -n 's/.*[[:space:]]fetch=\([^ ]*\).*/\1/p' "$f" 2>/dev/null | head -1)"
  case "$rel" in
    current|repinned|mended|restart-pending|behind)
      if [ -n "$fet" ] && [ "$fet" != ok ]; then
        hu_row refresh - "$(hu_age_txt "$age")" "UNVERIFIED (relation=$rel, but the comparison was NOT fresh: fetch=$fet)"; return 2
      fi
      hu_row refresh - "$(hu_age_txt "$age")" "OK (relation=$rel)"; return 0 ;;
    '') hu_row refresh - "$(hu_age_txt "$age")" "UNKNOWN (no relation= record)"; return 2 ;;
    *)  hu_row refresh - "$(hu_age_txt "$age")" "REFUSING (relation=$rel)"; return 1 ;;
  esac
}

# The claim registry is DATA on the remote (`refs/claims/*`), not a process. Its row is the age of
# the last probe `up` wrote, because a status verb must not spend a network round trip per row.
# ⛔ A BOX STARTED ANY OTHER WAY HAS NO RECORD, AND THAT IS NOT "CANNOT VERIFY". Only `up` wrote the
# probe record, so `status` answered BROKEN on every launchd / cloud-cell-supervisor / bringup start —
# the row could not answer "is this box up?" for the fleet that exists (measured in review). With no
# record the row PROBES (one bounded read per status call, the round trip it would have saved anyway),
# and an AGED record is LATE rather than OK: a stale "reachable" speaks about a probe nobody repeated.
HU_CLAIMS_STALE="${HARNESS_UP_CLAIMS_STALE:-1800}"
hu_row_claims() {
  local f="$O/state/harness-claims" age verdict="" rec_repo="" rec_origin="" why=""
  if [ -f "$f" ]; then
    verdict="$(sed -n 's/^claims=\([a-z-]*\).*/\1/p' "$f" 2>/dev/null | head -1)"
    # ⛔ THE FIELD IS THE REST OF THE LINE, anchored on both sides: a path containing a space is the
    # ordinary macOS shape (`/Users/First Last`), and `[^ ]*` would truncate the launcher's OWN record into
    # a "different repo", turning a healthy box BROKEN for no configuration error.
    hu_rec_parse "$f" || true
    rec_repo="$HU_REC_REPO"; rec_origin="$HU_REC_ORIGIN"
    age="$(hu_file_age "$f")" || { hu_row claims - "?" "UNKNOWN (cannot read $f)"; return 2; }
  fi
  # ⛔ A RECORD ABOUT ANOTHER REPO IS NOT AN ANSWER ABOUT THIS ONE, AND IT IS NOT A PERMANENT VERDICT
  # EITHER: the split makes "which repo did this probe" a question with more than one answer, but a
  # mismatch must RE-PROBE (one bounded read, the round trip the record would have saved) rather than stick
  # on UNKNOWN. `hu_start_claims` is the only writer and `status` only reached it when the file was
  # ABSENT, so a box repurposed to a different work repo — or one whose `keys.env` changed under a
  # launchd/cloud-cell-supervisor restart that never runs `harness-up` — would have read BROKEN forever.
  # ⛔ AND THE COMPARISON IS RESOLVED (hu_real, as every other path compare in this file is): `/var/…` and
  # `/private/var/…`, a trailing slash, or a symlink are the SAME repo, not a repurposed box.
  if [ -n "$rec_repo" ]; then
    if [ -z "$REPO" ]; then
      hu_row claims - "$(hu_age_txt "${age:-0}")" "UNKNOWN (the record probed $rec_repo, and no work repo is resolved to attribute it)"; return 2
    fi
    if ! hu_same_repo "$rec_repo" "$REPO" || ! hu_same_origin "$rec_origin" "$(hu_origin "$REPO")"; then
      # ⛔ NAME THE SIDE THAT FAILED (review P2). The sentence used to say "not the work repo $REPO" for
      # EVERY mismatch, so a work repo that simply does not resolve printed
      # `the record probed /tmp/gone, not the work repo /tmp/gone` — two identical strings, i.e. the row
      # told an operator its own path was a different repo, which is a diagnostic that steers the reader
      # away from the actual fault. Path-identity, origin-identity and unresolvable-work-repo are three
      # different faults and are three different sentences.
      local live_origin
      live_origin="$(hu_origin "$REPO")"
      if [ -z "$(hu_real "$REPO")" ]; then
        why="the work repo $REPO does not resolve to a directory, so the record ($rec_repo${rec_origin:+ at origin $rec_origin}) cannot be attributed to it"
      elif ! hu_same_repo "$rec_repo" "$REPO"; then
        why="the record probed $rec_repo${rec_origin:+ ($rec_origin)}, not the work repo $REPO"
      else
        why="the record probed $rec_repo at origin ${rec_origin}, but $REPO's origin is ${live_origin:-<unreadable>}"
      fi
      # Re-probe and re-read; the row is the FRESH answer, or UNKNOWN with the probe's reason.
      hu_start_claims >/dev/null 2>&1 || { hu_row claims - - "UNKNOWN ($why, and the re-probe could not answer${HU_CLAIMS_WHY:+ — $HU_CLAIMS_WHY})"; return 2; }
      verdict="$(sed -n 's/^claims=\([a-z-]*\).*/\1/p' "$f" 2>/dev/null | head -1)"
      age="$(hu_file_age "$f" 2>/dev/null)" || age="0"
      hu_rec_parse "$f" || true
      rec_repo="$HU_REC_REPO"; rec_origin="$HU_REC_ORIGIN"
      if [ -n "$rec_repo" ] && { ! hu_same_repo "$rec_repo" "$REPO" || ! hu_same_origin "$rec_origin" "$live_origin"; }; then
        hu_row claims - "$(hu_age_txt "${age:-0}")" "UNKNOWN (the re-probe left a record for $rec_repo${rec_origin:+ at origin $rec_origin}, not for $REPO${live_origin:+ at origin $live_origin})"; return 2
      fi
    fi
  elif [ ! -f "$f" ]; then
    hu_start_claims >/dev/null 2>&1 || { hu_row claims - - "UNKNOWN (the registry could not be probed${HU_CLAIMS_WHY:+ — $HU_CLAIMS_WHY}, and there is no record at $f)"; return 2; }
    verdict="$(sed -n 's/^claims=\([a-z-]*\).*/\1/p' "$f" 2>/dev/null | head -1)"
    age="$(hu_file_age "$f" 2>/dev/null)" || age="0"
  fi
  if [ -n "$age" ] && [ "$age" -gt "$HU_CLAIMS_STALE" ]; then
    hu_row claims - "$(hu_age_txt "$age")" "LATE (last probe ${verdict:-none}, older than ${HU_CLAIMS_STALE}s)"; return 1
  fi
  case "$verdict" in
    reachable) hu_row claims - "$(hu_age_txt "${age:-0}")" "OK (refs/claims reachable)"; return 0 ;;
    absent)    hu_row claims - "$(hu_age_txt "${age:-0}")" "OK (registry empty — no claim held right now)"; return 0 ;;
    *)         hu_row claims - "$(hu_age_txt "${age:-0}")" "UNKNOWN (verdict=${verdict:-none})"; return 2 ;;
  esac
}

hu_row_loop() {
  local pids n pid age hb
  pids="$(hu_ctrl_pids)" || { hu_row loop - ? "UNKNOWN (the process table could not be read)"; return 2; }
  n="$(printf '%s\n' "$pids" | sed '/^$/d' | wc -l | tr -d ' ')"
  if [ "$n" -eq 0 ]; then hu_row loop - - "MISSING (no orch-loop.sh for $HARNESS or $O)"; return 1; fi
  if [ "$n" -gt 1 ]; then hu_row loop "$(printf '%s' "$pids" | tr '\n' ' ' | sed 's/ *$//')" - "DUPLICATE ($n live — one controller per repo)"; return 1; fi
  pid="$pids"
  age="$(hu_file_age "$O/heartbeat")" || { hu_row loop "$pid" "?" "UNKNOWN (no readable heartbeat at $O/heartbeat)"; return 2; }
  hb="$(hu_age_txt "$age")"
  if [ "$age" -gt "$HU_HEARTBEAT_STALE" ]; then hu_row loop "$pid" "$hb" "LATE (heartbeat older than ${HU_HEARTBEAT_STALE}s)"; return 1; fi
  hu_row loop "$pid" "$hb" "OK (heartbeat ${hb} ago)"; return 0
}

# ── the EXEC row: what the controller is ACTUALLY EXECUTING, and whether that is the reference ──
# ⛔ THIS IS THE QUESTION NO OTHER ROW ANSWERS, and the brief for this work asks for it by name:
# "what is running vs what the pin says". `hu_verify_pin` compares the two PIN RECORDS against the
# CONFIGURED harness dir; `refresh` reads the last comparison's verdict; `drift` (below) compares a
# DIRECTORY's bytes against `$REF`; `loop` reads a pid and a heartbeat. None of them reads the live
# process's OWN ARGV, so a box whose controller execs a tree no record names — the Mac's
# `~/.cache/orc` copy, a hand-launched cell on an old worktree — reported OK on every row while the
# fix sat merged and inert.
# Resolve the RUNNING process's script path -> the COMMIT of the tree that path lives in -> compare it
# to the reference (the pin, else the harness dir this box resolved, else the ref).
# ⛔ IT IS NOT check-deployed-drift.sh, and it does not grow a second copy of it: that instrument
# answers "do these directories match $REF" and stays the authority for it. A tree can be
# byte-identical to main and still not be the pinned commit, and a pin can name a tree no process
# runs — both are invisible to a directory comparison and both are this row's whole subject.
# rc: 0 the executing tree IS the reference · 1 they DISAGREE (both shas named), or nothing is running
#     to read · 2 cannot-verify (unreadable argv / unresolvable path) — never a pass.
hu_exec_path_of() { # <pid> -> the harness script that process executes, resolved; rc=1 when unreadable
  local pid="${1:-}" argv="" tok path="" dir=""
  local -a toks=()
  argv="$(hp_proc_argv "$pid")" || return 1
  [ -n "$argv" ] || return 1
  # Tokens are collected into an ARRAY (one argv element per line) and passed QUOTED: a word-split
  # would both break a path containing a space and glob one containing `*` — the argv is data.
  # ⛔ NOTHING HERE REJECTS A MULTI-LINE VALUE: one token per line is the SHAPE this read produces, and
  # a `[![:print:]]` guard (a newline is not printable) rejected every healthy argv when it was tried.
  while IFS= read -r tok; do [ -n "$tok" ] && toks+=("$tok"); done <<<"$argv"
  path="$(hp_argv_script ${toks[@]+"${toks[@]}"})" || return 1
  [ -n "$path" ] || return 1
  dir="$(hu_real "$(dirname "$path")")"
  [ -n "$dir" ] && [ -d "$dir" ] || return 1
  printf '%s/%s' "$dir" "$(basename "$path")"
}

# hu_any_ctrl_pids — pids running ANY `*/orch-loop.sh`, on THIS box.
# ⛔ WHY THIS IS NOT `hu_ctrl_pids`: the two rows answer different questions, and conflating them is how
# the `exec` row would miss the case it exists for. `loop` (and `up`'s ALREADY-UP arm) ask "is THIS
# deployment running?" — their census is scoped to `$HARNESS` and `$O` on purpose, because a peer tree's
# controller is not this one. The `exec` row asks "WHAT is running, and is it the pin?" — so its census
# must not be pre-filtered to the paths the pin already names, or a controller executing a third tree (a
# hand-launched old worktree, `~/.cache/orc/main-orch-loop.sh`'s shape, a stale second pin) reads as
# `MISSING (no controller)` — "no controller" about wrong code that IS running (found by review round 3).
# The ARGV shape is the same rule `hu_pids` applies: the script must be its OWN token, so a shell whose
# text mentions the path is not a controller.
# ⚠️ STATED LIMIT (review round 4, follow-up rather than a fix): `ps -eo command=` SPACE-JOINS argv, so a
# controller whose own path contains a space (a macOS `$HOME` like `/Users/First Last`) is invisible to
# this census — the same accepted limit `hp_proc_argv` documents for the single-process read, and it
# fails CLOSED (`MISSING`, never a false OK). Closing it means enumerating `/proc/[0-9]*/cmdline` on
# Linux and keeping the `ps` fallback for macOS, i.e. a second census dialect: worth doing beside
# `hu_pids` (which has carried the same limit since #2231), not in this change.
# rc=1 when the process table cannot be read (and an unreadable read is never "no pids").
hu_any_ctrl_pids() {
  local table set
  table="$(${HU_PS:-ps} -eo pid=,command= 2>/dev/null)" || return 1
  case "$table" in *[![:space:]]*) ;; *) return 1 ;; esac
  set="$(printf '%s\n' "$table" | awk '
    { pid = $1; cmd = $0; sub(/^[[:space:]]*[0-9]+[[:space:]]+/, "", cmd)
      n = split(cmd, tok, " ")
      if (n >= 2 && tok[1] ~ /(bash|sh|dash|zsh|ksh)$/ && tok[2] ~ /(^|\/)orch-loop[.]sh$/) print pid }')"
  # ⛔ THE SAME ANCESTOR FILTER AS hu_ctrl_pids, FOR THE SAME MEASURED REASON: `orch-loop.sh` re-execs
  # itself for its per-cycle self-refresh (#2215), so a healthy box's census is the controller PLUS its
  # descendants — measured 2026-10-22 on this cell as `DUPLICATE (5 live controllers — the executing
  # tree is ambiguous)` for ONE controller (a `bash -c` wrapper, the controller, two cycle subshells
  # and a lingering tmux client). Reading a process CHAIN as rival controllers is the "a measurement
  # artifact is not a state" failure, and its remedy (kill the duplicates) is destructive.
  [ -n "$set" ] || return 0
  printf '%s\n' "$(${HU_PS:-ps} -eo pid=,ppid= 2>/dev/null)" | HU_SET="$set" awk '
    BEGIN { n = split(ENVIRON["HU_SET"], a, "\n"); for (i = 1; i <= n; i++) if (a[i] != "") set[a[i]] = 1 }
    { if ($1 != "") par[$1] = $2 }
    END {
      for (p in set) { x = par[p]; d = 0
        while (x != "" && x != "0" && d++ < 40) { if (x in set) { drop[p] = 1; break } x = par[x] } }
      for (p in set) if (!(p in drop)) print p
    }' | sort -n
}

hu_row_exec() {
  local pids n pid path dir head ref name="unknown reference" pinraw="" st="" stnote=""
  pids="$(hu_any_ctrl_pids)" || { hu_row exec - - "UNKNOWN (the process table could not be read, so what the controller executes cannot be named)"; return 2; }
  n="$(printf '%s\n' "$pids" | sed '/^$/d' | wc -l | tr -d ' ')"
  [ "$n" -gt 0 ] || { hu_row exec - - "MISSING (no controller process to read: the pin describes nothing that is RUNNING)"; return 1; }
  # ⛔ TWO CONTROLLERS IS THE STATE, NOT NECESSARILY A FAULT: `orchestrator-bringup.sh` distinguishes
  # OWN from FOREIGN — two repos may legitimately share one harness path on a cell (its `check` splits
  # them; this row cannot, because "which repo owns this pid" is the registry's answer, not the process's).
  # So it names the count and stays DEGRADED rather than picking a tree and blessing it (review round 5).
  [ "$n" -eq 1 ] || { hu_row exec - - "DUPLICATE ($n live controllers — the executing tree is ambiguous; 'loop' is the per-deployment answer, and orchestrator-bringup.sh status splits own/foreign)"; return 1; }
  pid="$pids"
  path="$(hu_exec_path_of "$pid")" || { hu_row exec "$pid" - "UNKNOWN (pid $pid's argv cannot be read, or names no orchestration script, so what it executes cannot be named)"; return 2; }
  dir="$(dirname "$path")"
  # The commit of the tree the process EXECUTES — git's answer about the dir the file lives in, never
  # the directory's NAME (a path spelling is not evidence of its content).
  head="$(git -C "$dir" rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null)" || head=""
  # The reference. ⛔ The PIN first: it is what "which harness is this box on" means. With no pin (a box
  # that has never been installed) the dir this run resolved IS the reference, and SAYING SO is part of
  # the row — an unnamed reference would let a wrong comparison read as a right one.
  # ⛔ THE PIN'S STATE COMES FROM THE STATE HELPER, never `-r` (measured in review): `-r` is false both
  # for an ABSENT record and for a mode-000 one / one behind an unsearchable ancestor, so a pin that
  # could not be READ was silently treated as "no pin" and the comparison fell through to a weaker
  # reference — the fail-open `hu_verify_pin` exists against. Only ABSENT may fall through.
  ref=""
  case "$(hu_path_state "$PIN_SHA_FILE")" in
    unexaminable)
      hu_row exec "$pid" - "UNKNOWN (the pin record $PIN_SHA_FILE cannot be examined, so there is no reference to compare $path against)"
      return 2 ;;
    path)
      if [ ! -r "$PIN_SHA_FILE" ]; then
        hu_row exec "$pid" - "UNKNOWN (the pin record $PIN_SHA_FILE exists but cannot be read, so there is no reference to compare $path against)"
        return 2
      fi
      pinraw="$(head -1 "$PIN_SHA_FILE" 2>/dev/null | tr -d '[:space:]')"
      if [ -n "$pinraw" ]; then
        # ⛔ SAME FAIL-CLOSED RULE AS hu_verify_pin: `git -C ""` is the CWD's repo, so an empty harness
        # would compare the running tree against the operator's own checkout and could print OK.
        [ -n "$HREPO" ] || { hu_row exec "$pid" - "UNRESOLVED (no harness repo resolved, so the pin record ${pinraw:0:12} cannot be compared with $path)"; return 2; }
        ref="$(git -C "$HREPO" rev-parse --verify --quiet "${pinraw}^{commit}" 2>/dev/null)" || ref=""
        # ⛔ A PIN THAT DOES NOT RESOLVE IS NOT "NO PIN", AND NOT A LICENCE TO FALL THROUGH: falling
        # through printed `OK` about the harness dir while the pin named a commit nothing could read
        # (measured in review). Naming it is the only honest answer.
        [ -n "$ref" ] || { hu_row exec "$pid" - "UNRESOLVABLE (the pin record $PIN_SHA_FILE names ${pinraw:0:12}, which is not a commit in the harness repo $HREPO, so $path cannot be compared with it)"; return 2; }
        name="the pin ($PIN_SHA_FILE)"
      fi ;;
  esac
  if [ -z "$ref" ]; then
    ref="$(git -C "$HARNESS" rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null)" || ref=""
    [ -n "$ref" ] && name="the harness dir this box resolved ($HARNESS_SRC)"
  fi
  if [ -z "$ref" ]; then
    hu_row exec "$pid" - "NO REFERENCE (executing $path${head:+ @ ${head:0:12}}, but neither a pin nor a git tree is readable — nothing can say whether it is right)"
    return 2
  fi
  if [ -z "$head" ]; then
    # ⛔ A FLAT-COPY $O IS A NAMED LAYOUT, NOT A VERDICT AND NOT A BROKEN BOX. Before install.sh records
    # a pin (agent-infra#2271's whole subject) a Mac's controller runs `$O/orch-loop.sh` — a COPY with
    # no `.git` — so no commit can be resolved for it, before or after a successful start. Three
    # wrong answers were tried and rejected: `DIFFERS` asserts the code IS different (nobody
    # established that, and a healthy Mac then reads DEGRADED forever — review round 1); `BROKEN`(2)
    # is honest about the reading but makes `up` exit 2 AFTER a successful start on the owner's own
    # machine, which both mis-reports the start and teaches an operator to ignore a genuine
    # cannot-verify (review round 2); `SKIPPED` would hide the very state #2271 exists to fix.
    # So: DEGRADED, with the layout, the box's own record and the remedy all named — red enough to act
    # on, distinguishable from an instrument failure, and never a false pass.
    st=""
    if [ -f "$O/.agent-infra-stamp.json" ]; then
      st="$(sed -n 's/.*"commit"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$O/.agent-infra-stamp.json" 2>/dev/null | head -1)"
    fi
    case "$st" in ''|UNKNOWN) st="" ;; esac
    stnote=""
    [ -n "$st" ] && stnote="; the box's record for $O names ${st:0:12}, which describes a COPY of that directory and not this process"
    hu_row exec "$pid" - "UNIDENTIFIED (executing $path, a flat copy with NO git identity, so no commit can be proven${stnote}. The reference is ${ref:0:12} from $name. This is the pre-pin layout: give the box pin records (install.sh --start / harness-refresh) and this row becomes a real comparison)"
    return 1
  fi

  if [ "$head" = "$ref" ]; then
    hu_row exec "$pid" - "OK (executing $path @ ${head:0:12} — the reference: $name)"; return 0
  fi
  # Ancestry changes the REMEDY, not the verdict: BEHIND is one restart away (the pin advanced and the
  # running controller was deliberately left alone — #2216/#2278), while anything else is a tree the
  # reference does not describe at all. Each is named, because "they disagree" without both shas is not
  # actionable.
  # ⛔ AND THE ANCESTRY QUESTION IS A HARNESS QUESTION — `git -C ""` is the CWD's repo (git 2.43), so an
  # unresolved harness would answer "is this an ancestor" about whatever checkout the operator stands in,
  # flipping the REMEDY per CWD. No harness, no lineage claim.
  if [ -n "$HREPO" ] && git -C "$HREPO" merge-base --is-ancestor "$head" "$ref" 2>/dev/null; then
    hu_row exec "$pid" - "DIFFERS (executing $path @ ${head:0:12}, which is BEHIND the reference ${ref:0:12} from $name — the pin moved and this process was never restarted onto it)"
    return 1
  fi
  if [ -z "$HREPO" ]; then
    hu_row exec "$pid" - "DIFFERS (executing $path @ ${head:0:12} vs the reference ${ref:0:12} from $name — and no harness repo is resolved, so whether one is an ancestor of the other is NOT established)"
    return 1
  fi
  hu_row exec "$pid" - "DIFFERS (executing $path @ ${head:0:12}, which is NOT on the reference's line (${ref:0:12} from $name) — the running code is not the referenced code)"
  return 1
}

# hp_launchd_dead_text <label> — NAME the state of a loaded job that has NO process.
#
# ⛔ FOUR FACTS, FOUR REMEDIES — and the exit CODE is what separates the first two:
#   EXITED-CLEAN      last exit = 0. NOT a crash: the job ran and returned success. Reachable on
#                     THIS job whenever a second controller holds the lock — `orch-loop.sh`'s
#                     `acq()` failure path prints "already running" and `exit 0` — and because
#                     KeepAlive keeps relaunching, the row would otherwise read "every attempt is
#                     failing" about a job that is exiting IMMEDIATELY and cleanly. It also points
#                     at `launchd.out`, where that message actually goes (`echo`, not stderr).
#   DIED              a NON-ZERO exit status: launchd retries it on its ThrottleInterval, so a job
#                     that STAYS here is failing on every attempt. The launch count is printed as
#                     EVIDENCE of how many times it has been started since load — never as proof
#                     that the failure is persistent (see the note on `runs` above).
#   NEVER-STARTED     no process, no exit code, and `runs = 0`: launchd has never launched it.
#   LOADED-NO-PROCESS anything else launchd would not explain. The row says what it actually knows.
#
# ⛔ WHY THE EXIT CODE IS PRINTED: on the Mac this row is the only place an operator meets launchd's
# judgement, and `LAST EXIT 128` is what a fork/spawn failure looks like (`spawn … EAGAIN` is 128 —
# #2293). Dropping it forces a human to run `launchctl print` themselves, which is the "silent until
# you already suspect" shape this file exists against.
# ⛔ AND AN ABSENT DATUM IS NEVER RENDERED AS A VALUE: no exit code means no code is printed (never
# "last exit 0"), and no `runs` means no count is printed (never "0 launches"). A garbled field is
# dropped rather than echoed.
hp_launchd_dead_text() { # <label>
  local label="${1:-}" runs="${HP_LAUNCHD_RUNS:-}" lexit="${HP_LAUNCHD_LAST_EXIT:-}" seen=""
  # ⛔ THE PATTERNS ARE EXACT, NOT LAX (2026-10-22, review round 4). `[0-9]*` accepts `128x` and
  # `00`, and `-0` then reads as a crash and `00` defeats the `runs = 0` test below -- i.e. the
  # stated invariants ("a garbled field is dropped", "runs = 0 wins") were asserted in prose and
  # not enforced. A SIGNED code is kept (a signal death can be reported negative) but only its
  # canonical form; anything else is treated as absent, which is the honest reading of a field
  # launchd never emits.
  case "$lexit" in
    ''|-) lexit="" ;;
    -*) case "${lexit#-}" in ''|*[!0-9]*) lexit="" ;; *) lexit=$(( -10#${lexit#-} )) ;; esac ;;
    *) case "$lexit" in *[!0-9]*) lexit="" ;; *) lexit=$(( 10#$lexit )) ;; esac ;;
  esac
  case "$runs" in
    ''|*[!0-9]*) runs="" ;;
    *) runs=$(( 10#$runs )) ;;
  esac
  [ -n "$runs" ] && seen="; launchd reports $runs launch(es) since it was loaded"
  # ⛔ `runs = 0` IS DECISIVE AND IS TESTED FIRST (2026-10-22, review round 3). launchd's
  # `last_exit_status` is CALLOC'd to 0 and is only overwritten when a run is REAPED, so a job that
  # has never been launched reports `last exit code = 0` -- the one datum here that cannot prove
  # anything. Branching on the exit code first made such a job read EXITED-CLEAN and handed the
  # operator the "second controller holds the lock" remedy instead of `kickstart`, for a job that had
  # never run at all.
  if [ "$runs" = "0" ]; then
    printf 'NEVER-STARTED (%s is loaded with NO process and launchd reports 0 launches — it has never been kicked; start it: launchctl kickstart -k gui/%s/%s)' \
      "$label" "$(id -u)" "$label"
  elif [ "$lexit" = "0" ]; then
    printf 'EXITED-CLEAN (last exit 0%s — a KeepAlive job is relaunched on its ThrottleInterval, so a job that STAYS here is exiting IMMEDIATELY rather than crashing. For the fleet loop the usual cause is a second controller holding %s/.orch.lock ("already running", orch-loop.sh) — read %s/logs/launchd.out)' \
      "$seen" "$O" "$O"
  elif [ -n "$lexit" ]; then
    printf 'DIED (last exit %s%s; launchd retries a failing KeepAlive job on its ThrottleInterval, so if it STAYS here every attempt is failing; read %s/logs/launchd.err)' \
      "$lexit" "$seen" "$O"
  else
    printf 'LOADED-NO-PROCESS (%s is loaded but has NO process%s, and launchd published no exit code to tell why; check: launchctl print gui/%s/%s)' \
      "$label" "$seen" "$(id -u)" "$label"
  fi
}

# ── the LAUNCHD row: on the Mac, is the job LOADED, and does it HAVE a PROCESS? ─────────────────
# The remedy text below assumes the SHIPPED template (`KeepAlive`=true, `ThrottleInterval`=10). That
# holds for the only production caller; a different `HU_LAUNCHD_LABEL` makes "launchd relaunches it"
# an assumption rather than a fact, so the wording says "a KeepAlive job" instead of asserting it.
# ⛔ `ps` ALONE CANNOT ANSWER THIS, and the states have different remedies: NOT LOADED (load it —
# `launchctl load`), EXITED-CLEAN / DIED / NEVER-STARTED / LOADED-NO-PROCESS with no process (the job
# is installed and nothing is running: `hp_launchd_dead_text` names which). The `loop` row collapses
# them into `MISSING`, which is how a job that was never loaded reads exactly like one that is loaded
# and dead
# — and on the Mac the whole stack is ONE launchd job (`com.eldato.orchestrator-loop`, install.sh:131),
# so this row is "which components are loaded" for that platform.
# On a cell there is no launchd and the row says SKIPPED WITH ITS REASON, never OK (fleet-inventory's
# rule: not-applicable is a pass, and it is never rendered as a pass that was measured).
hu_row_launchd() {
  local label="${HU_LAUNCHD_LABEL:-com.eldato.orchestrator-loop}" rc=0 why=""
  if [ "$PLATFORM" != "mac" ]; then
    hu_row launchd - - "SKIPPED (no launchd on this platform; the cell's session is the 'supervisor' row)"; return 4
  fi
  hp_launchd_loaded "$label"; rc=$?
  case "$rc" in
    0) hu_row launchd - - "OK ($label is loaded and has a process)"; return 0 ;;
    1) hu_row launchd - - "$(hp_launchd_dead_text "$label")"; return 1 ;;
    2) hu_row launchd - - "NOT LOADED ($label is not in this user's launchd domain — nothing on this box starts the controller: O=$O bash scripts/orchestrator-harness/install.sh --start)"; return 1 ;;
    3) hu_row launchd - - "UNKNOWN (no launchctl on PATH, so the job's state cannot be read)"; return 2 ;;
    4) hu_row launchd - - "SKIPPED (not a macOS box)"; return 4 ;;
    # ⛔ THE READ FAILED WITHOUT SAYING ANYTHING ABOUT THE JOB (a domain-level rejection: `Bad request.`
    # from `gui/0` under root, an SSH context with no gui domain). NOT LOADED would be a confident answer
    # to a question nobody answered, and its remedy (re-install) is wrong.
    5) hu_row launchd - - "UNKNOWN (launchctl print failed in a way that says NOTHING about the job — a domain-level rejection, not a missing service; cannot-verify is never a pass)"; return 2 ;;
    142) why="$(hu_bound_explain 142 "${HU_LAUNCHCTL_TIMEOUT:-10}")"; hu_row launchd - - "UNKNOWN (launchctl print $why, so the job's state cannot be read)"; return 2 ;;
    # ⛔ 125 IS NOT "launchctl IS ABSENT" (review round 2): it is "nothing could be BOUND" (perl is
    # missing), and reporting it as an absent tool sends the operator after a binary that is already
    # there while the real defect goes unstated.
    125) why="$(hu_bound_explain 125 "${HU_LAUNCHCTL_TIMEOUT:-10}")"; hu_row launchd - - "UNKNOWN ($why — the job's state cannot be read)"; return 2 ;;
    *) hu_row launchd - - "UNKNOWN (launchctl print answered $rc — not a state this reader knows)"; return 2 ;;
  esac
}

# ── capacity: the lane ceiling is MEASURED, never a constant ────────────────────────────────────
# ⛔ THE HOUSE RULE, and it is a rule about where a NUMBER may come from: a box carries many times
# its CPU count in lanes, and what stops it is LOAD and DISK read AT THE MOMENT OF THE DECISION — not
# a constant like `max_lanes=8` (README §5's MAX_LANES row records the measured cost: a flat 4, and
# one box's pinned 8, closed the lane gate while the load and memory gates still had headroom).
# ⛔ AND THE PROBE IS NOT THIS FILE'S EITHER. `scripts/orchestrator-harness/capacity.sh` IS the
# fleet's measured instrument (agent-infra#2252/#2253): one implementation of "what is this box
# doing", the same bytes on whichever box you are standing on. So this decision CONSUMES its record
# (`capacity.sh probe`) rather than growing a second probe — the record says which one answered
# (`probe=capacity.sh` / `probe=shim`), because a fallback that answered silently would be a second
# instrument wearing the first one's name. The shim probes are the fallback for a box that has the
# launcher but no harness dir beside it (a bootstrap, a fixture).
# What this file supplies is the DERIVATION and the REFUSAL:
#   load ceiling   = ncpu × HU_LOAD_PER_CPU (default 800 = 8.00 load per cpu) — `capacity.sh`'s own
#                    `CAP_LPC_CEILING`, the fleet's measured "DO NOT PLACE HERE" line (its header:
#                    the saturation point is 8-10× cpu, and the controller's local hard gate is
#                    ncpu × 10). The default is PINNED EQUAL to that file's by
#                    scripts/harness-surface.test.sh, so the two cannot drift apart silently.
#   load per lane  = HU_LOAD_PER_LANE (default 400 = 4.00 load units) — not invented: it is the same
#                    ratio the shipped constants already carry (MAX_LANES ncpu × 5/2 against MAX_LOAD
#                    ncpu × 10), and it is `capacity.sh`'s "PREFER ELSEWHERE" line as one lane's worth.
#   disk per lane  = HU_DISK_PER_LANE_MB (default 1100) — `capacity.sh`'s measured ~1.1 GB per live
#                    worktree (#2159), above the dispatch floor the spawn gate already uses
#                    (spawn-gate.sh:152's 500 MB, whose probe hp_disk_free_mb reproduces verbatim so
#                    the instruments read the disk alike). A repo whose PROVISIONING is heavier (a
#                    Python lane costs ~3.0 GB — agent-infra#1852) sets the knob: it is a measurement
#                    of THAT workload, not a cap.
# `HARNESS_UP_MAX_LANES` is REPORTED AND IGNORED: a fixed number is not a reading, and using it as
# the ceiling is the defect this function exists to remove.
# rc: 0 a measured answer (one machine-readable record on stdout) · 3 REFUSED: the box could not be
#     measured, and a fixed cap is not a substitute for a measurement.
hu_capacity() {
  local load1="" ncpu="" dfree="" probe="shim" rec="" capsh="$SELF_PATH/orchestrator-harness/capacity.sh"
  local ceil percpu perlanes loadlanes dpath diskfloor diskcost avail disklen lanes now fixed="none"
  local forkhead="" forksrc="" forkreserve="" forklane="" forkavail="" forklanes="" forkbound=1 binding="" fr=""
  local fmin="" frh="" frc=0 forklanes_txt=""
  # ── FORK HEADROOM IS READ **FIRST**, BEFORE ANY PROBE THAT MUST FORK TO ANSWER ────────────────
  # (#2293, and the same ordering lesson `capacity.sh:477-481` records for itself.) This dimension is
  # the one whose failure is TOTAL — a box at 0.32x load, or one whose cgroup pids ceiling is 4x
  # tighter than RLIMIT_NPROC, can fork nothing while load and disk both read comfortable. So it is
  # measured before `capacity.sh probe` and before `hp_load1_c`/`hp_ncpu`, because EVERY one of those
  # forks: on a box that cannot fork they fail too, and the earlier refusals would then report
  # `load_unreadable` — naming the loadavg and pointing the operator at the wrong fault — before the
  # fork read was ever attempted. The true answer on such a box is "this box cannot fork".
  # ⛔ capacity.sh IS THE ONE INSTRUMENT, AND ITS `fork` VERB IS THE READING ALONE. The #2552 batch
  # landed the fork read on main while this branch was in review, under a DIFFERENT record schema
  # (`procs=`/`procs_max=`/`fork=`/`src=`) than this branch had invented (`fork_headroom=`). A branch
  # cannot win that: two publishers under one `refs/boxes` namespace is the defect, not the field name,
  # so the RECORD is main's and this launcher CONSUMES it. Deriving `procs_max − procs` here would be a
  # second implementation of `cap_h_for`'s arithmetic, so the verb answers with `headroom=` already
  # computed there — and `min_fork_headroom=` carries the fleet's declared margin, so this file cannot
  # invent a second one either.
  if [ -f "$capsh" ]; then
    fr="$(hu_bounded "${HU_CAPACITY_TIMEOUT:-20}" bash "$capsh" fork 2>/dev/null)"; frc=$?
    # 254 is capacity.sh's own "THE READ COULD NOT FORK" (bash terminates on a failed fork): the box
    # is out of pids, which is the TOTAL failure this dimension exists for. Name it, do not retry.
    [ "$frc" -eq 254 ] && { printf 'capacity_refused reason=fork_exhausted probe=capacity.sh\n'; return 3; }
  fi
  # ── fork headroom: THE FIRST DIMENSION, because it is the one whose failure is TOTAL ───────────
  # (READ HERE, before the load/ncpu/disk probes below: those fork to answer, so their refusals would
  # otherwise fire first on the very box this dimension exists for.) The shim is the fallback for a
  # box with no capacity.sh beside the launcher — the record names which answered, so a fallback can
  # never pass as the fleet instrument.
  case "$fr" in
    *[[:space:]]headroom=*)
      frh="$(printf '%s' "$fr" | sed -n 's/.*[[:space:]]headroom=\([^ ]*\).*/\1/p' | head -1)"
      fmin="$(printf '%s' "$fr" | sed -n 's/.*[[:space:]]min_fork_headroom=\([0-9][0-9]*\).*/\1/p' | head -1)"
      forksrc="$(printf '%s' "$fr" | sed -n 's/.*[[:space:]]src=\([^ ]*\).*/\1/p' | head -1)"
      # `min_fork_headroom=` contains the substring `headroom=` but never after a SPACE, so the two
      # extractions cannot collide.
      case "$frh" in
        unbounded)  forkhead=unbounded; forksrc="capacity.sh:${forksrc:-no-ceiling}" ;;
        ''|*[!0-9]*) : ;;
        *)          forkhead="$frh"; forksrc="capacity.sh:${forksrc:-unknown}" ;;
      esac ;;
  esac
  if [ -z "$forkhead" ]; then
    fr="$(hp_fork_headroom 2>/dev/null)" || fr=""
    forkhead="$(printf '%s' "$fr" | sed -n 's/.*headroom=\([0-9][0-9]*\).*/\1/p' | head -1)"
    forksrc="$(printf '%s' "$fr" | sed -n 's/.*source=\([^ ]*\).*/\1/p' | head -1)"
    [ -n "$forkhead" ] && forksrc="shim:${forksrc:-unknown}"
  fi
  # ⛔ AN UNMEASURABLE FORK LIMIT IS NOT UNLIMITED HEADROOM. `ulimit -u` is a shell builtin and exists
  # everywhere these boxes run, so this refusal is rare — but "I could not look" must never be spent
  # as "there is room", which is the whole class #1745/#2293 record. `up` refuses on it like load/disk.
  # ⛔ AND `unbounded` IS NOT UNMEASURABLE — IT IS THE OPPOSITE. `procs_max=0` means NO CEILING WAS
  # FOUND, so `cap_h_for` answers `unbounded`, and a box no process limit bounds cannot be bound by
  # one. It is kept as a distinct WORD so the arithmetic below skips the dimension; collapsing it into
  # a number would either refuse every healthy unbounded box (read as 0 headroom) or pretend a ceiling
  # exists (read as a huge one, which then divides into a fabricated lane count).
  # ⛔ AND IT REFUSES **HERE**, BEFORE THE LOAD REFUSAL, ON BOTH PATHS. The fork read above the.
  # capacity.sh call was only half the ordering: the shim's own fork read sat below the
  # `load_unreadable`/`ncpu_unreadable` refusals, so on a box with no capacity.sh beside the launcher
  # (the documented fallback) an unforkable box still reported `load_unreadable` and pointed the
  # operator at the loadavg — the exact misdiagnosis the ordering comment above claims to prevent
  # (review round 1). The `probe=` field names the instrument that WOULD have answered.
  [ -n "$forkhead" ] || { printf 'capacity_refused reason=fork_unreadable probe=%s\n' "$([ -f "$capsh" ] && echo capacity.sh || echo shim)"; return 3; }
  # ── the reading: capacity.sh's record first, the shim probes as the fallback ────────────────────
  if [ -f "$capsh" ]; then
    # ⛔ BOUNDED, and a FAILED probe is not a reading: a `capacity.sh` that cannot answer leaves the
    # shim fallback to try — and if that cannot answer either, the decision refuses below.
    # ⛔ THE PATH ARGUMENT IS LOAD-BEARING: `capacity.sh probe <repo>` measures the volume that path
    # lives on, and with no argument it measures the CALLER's CURRENT DIRECTORY. On a box whose cwd is
    # on another volume than the repo (where lane worktrees are created) that over-reports free disk —
    # i.e. it errs in the exact direction this decision exists to prevent. `$O` is this launcher's
    # state dir and the volume it fills; `orch-loop.sh` passes its `$REPO` for the same reason.
    rec="$(hu_bounded "${HU_CAPACITY_TIMEOUT:-20}" bash "$capsh" probe "$O" 2>/dev/null)" || rec=""
    case "$rec" in
      host=*ncpu=*load1=*disk_free_mb=*)
        load1="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]load1=\([0-9][0-9]*\).*/\1/p' | head -1)"
        ncpu="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]ncpu=\([0-9][0-9]*\).*/\1/p' | head -1)"
        dfree="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]disk_free_mb=\([0-9][0-9]*\).*/\1/p' | head -1)"
        [ -n "$load1" ] && [ -n "$ncpu" ] && [ -n "$dfree" ] && probe="capacity.sh" ;;
    esac
  fi
  if [ "$probe" = shim ]; then
    load1="$(hp_load1_c)" || load1=""
    ncpu="$(hp_ncpu)" || ncpu=""
  fi
  [ -n "$load1" ] || { printf 'capacity_refused reason=load_unreadable probe=%s\n' "$probe"; return 3; }
  [ -n "$ncpu" ]  || { printf 'capacity_refused reason=ncpu_unreadable probe=%s\n' "$probe"; return 3; }
  # ⛔ BASE 10 EXPLICITLY, EVERYWHERE A KNOB REACHES `$(( ))`. The digit check above rejects
  # non-numbers but ACCEPTS a leading zero, and bash reads `0400` as OCTAL 256 — so
  # `HU_LOAD_PER_LANE=0400` silently divided by 256 and reported 10 lanes where the reading supports 7
  # (a 43% over-report, in the direction that over-places work), and `HU_LOAD_PER_CPU=0800` did not
  # even parse ("value too great for base"). Same class as the `10#` normalisations `orch-loop.sh`
  # carries; found by review round 3.
  percpu="${HU_LOAD_PER_CPU:-800}";   case "$percpu" in ''|*[!0-9]*) percpu=800 ;; esac
  perlanes="${HU_LOAD_PER_LANE:-400}"; case "$perlanes" in ''|*[!0-9]*) perlanes=400 ;; esac
  [ "$perlanes" -ge 1 ] 2>/dev/null || perlanes=400
  ceil=$(( 10#$ncpu * 10#$percpu ))
  loadlanes=$(( (ceil - 10#$load1) / 10#$perlanes ))
  [ "$loadlanes" -ge 0 ] 2>/dev/null || loadlanes=0
  if [ "$probe" = shim ]; then
    # The volume that fills is the one the STATE DIR lives on, so the probe takes the nearest EXISTING
    # ancestor: a first start has no $O yet, and "df: /x/orchestrator: No such file" is not a disk
    # reading (the same walk hu_path_state does, for the same reason).
    dpath="$O"
    while [ -n "$dpath" ] && [ ! -d "$dpath" ] && [ "$dpath" != "/" ]; do dpath="$(dirname "$dpath")"; done
    [ -d "$dpath" ] || dpath="/"
    dfree="$(hp_disk_free_mb "$dpath")" || { printf 'capacity_refused reason=disk_unreadable probe=shim path=%s\n' "$dpath"; return 3; }
  fi
  diskfloor="${HU_DISK_FLOOR_MB:-500}";   case "$diskfloor" in ''|*[!0-9]*) diskfloor=500 ;; esac
  diskcost="${HU_DISK_PER_LANE_MB:-1100}"; case "$diskcost" in ''|*[!0-9]*) diskcost=1100 ;; esac
  [ "$diskcost" -ge 1 ] 2>/dev/null || diskcost=1100
  avail=$(( 10#$dfree > 10#$diskfloor ? 10#$dfree - 10#$diskfloor : 0 ))
  disklen=$(( avail / 10#$diskcost ))
  # A lane's process tree, and the tasks a box must keep for itself. 40 is a MEASUREMENT-shaped
  # default, not a round number: one `pi` holds 11 threads on this Linux box (`ps -eo comm,nlwp`), and
  # a lane adds its shell, the worker terminal, `gh`/`git` calls and — for a test lane — a pytest or
  # `uv sync` tree. Both are knobs because both are measurements of a WORKLOAD, not caps — but only
  # `HU_FORK_PER_LANE` is a workload number here: the reserve is the fleet's declared margin (below).
  # ⛔ THE RESERVE IS THE FLEET'S DECLARED MARGIN, NOT A SECOND ONE. `min_fork_headroom` IS
  # `CAP_MIN_FORK_HEADROOM` in capacity.sh (200) — the number the fleet's own placement gate refuses
  # on. This launcher defaulting to its own 800 would mean two readers disagree about one reading, so
  # the default comes FROM the instrument, and 200 is only the fallback for a box with no capacity.sh.
  # `HU_FORK_PER_LANE` stays a workload measurement, not a cap: one `pi` holds ~11 threads and a lane
  # adds its shell, the worker terminal, git/gh calls and (for a test lane) a pytest or `uv sync` tree.
  forkreserve="${HU_FORK_RESERVE:-${fmin:-200}}"; case "$forkreserve" in ''|*[!0-9]*) forkreserve=200 ;; esac
  forklane="${HU_FORK_PER_LANE:-40}";     case "$forklane" in ''|*[!0-9]*) forklane=40 ;; esac
  [ "$forklane" -ge 1 ] 2>/dev/null || forklane=40
  if [ "$forkhead" = unbounded ]; then
    # No ceiling found => this dimension cannot bind. `forkbound=0` is what the derivation reads; the
    # numbers are left at 0 and are NEVER compared, so an unbounded box cannot read as "0 lanes".
    # ⛔ AND THE ROW MUST NOT PRINT THAT 0 EITHER: `lanes_by_fork=0` renders as `by fork=0`, which to a
    # reader says the box with NO process ceiling can place zero lanes — a fabricated number in the
    # one place this file forbids them. The word rides in its own field so the reader can tell "not a
    # constraint" from "a constraint with no room".
    forkbound=0; forkavail=0; forklanes=0; forklanes_txt="unbounded"
  else
    forkavail=$(( 10#$forkhead > 10#$forkreserve ? 10#$forkhead - 10#$forkreserve : 0 ))
    forklanes=$(( forkavail / 10#$forklane )); forklanes_txt="$forklanes"
  fi
  # ── the derivation, IN THE ORDER THE DIMENSIONS FAIL: fork (total), disk (total, and the one that
  # breaks a box first in practice), load (soft). `binding=` names WHICH one produced the number, so a
  # reader can tell "the box is full" from "the box could not fork" from "this is just busy" — three
  # states that used to print as one lane count.
  lanes=$(( loadlanes < disklen ? loadlanes : disklen ))
  binding=disk; [ "$loadlanes" -lt "$disklen" ] && binding=load
  if [ "$forkbound" -eq 1 ] && [ "$forklanes" -lt "$lanes" ]; then lanes=$forklanes; binding=fork; fi
  [ -n "${HARNESS_UP_MAX_LANES:-}" ] && fixed="$HARNESS_UP_MAX_LANES"
  now="$(date +%s 2>/dev/null)"
  printf 'capacity host=%s load1=%s ncpu=%s ceiling_load=%s disk_free_mb=%s lanes_by_load=%s lanes_by_disk=%s lanes_by_fork=%s fork_headroom=%s fork_source=%s binding=%s lanes=%s fixed_ignored=%s probe=%s at=%s\n' \
    "$(uname -n 2>/dev/null || printf 'unknown')" \
    "$(awk -v c="$load1" 'BEGIN{printf "%.2f", c/100}')" "$ncpu" \
    "$(awk -v c="$ceil" 'BEGIN{printf "%.2f", c/100}')" \
    "$dfree" "$loadlanes" "$disklen" "$forklanes_txt" "$forkhead" "${forksrc:-unknown}" "$binding" "$lanes" "$fixed" "$probe" "${now:-0}"
  return 0
}

hu_row_capacity() {
  local rec="" rc=0 lanes="" load="" dfree="" ncpu="" fixed="none" probe="" why=""
  local forkhead="" forksrc="" binding="" lb_load="" lb_disk="" lb_fork=""
  rec="$(hu_capacity 2>&1)"; rc=$?
  case "$rc" in
    0) : ;;
    3)  why="$(printf '%s' "$rec" | sed -n 's/^capacity_refused reason=\([a-z_]*\).*/\1/p' | head -1)"
        hu_row capacity - - "REFUSED ($(hu_cap_reason_txt "${why:-unmeasurable}"))"; return 2 ;;
    *) hu_row capacity - - "UNKNOWN (the capacity decision answered $rc — not a reading this reader knows)"; return 2 ;;
  esac
  lanes="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]lanes=\([0-9]*\).*/\1/p' | head -1)"
  load="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]load1=\([0-9.]*\).*/\1/p' | head -1)"
  ncpu="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]ncpu=\([0-9]*\).*/\1/p' | head -1)"
  dfree="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]disk_free_mb=\([0-9]*\).*/\1/p' | head -1)"
  fixed="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]fixed_ignored=\([^ ]*\).*/\1/p' | head -1)"
  probe="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]probe=\([^ ]*\).*/\1/p' | head -1)"
  # `[^ ]*`, not `[0-9]*`: `unbounded` is a legitimate reading and must print as itself rather than
  # as `?`, which is how an absent datum is rendered.
  forkhead="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]fork_headroom=\([^ ]*\).*/\1/p' | head -1)"
  forksrc="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]fork_source=\([^ ]*\).*/\1/p' | head -1)"
  binding="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]binding=\([a-z]*\).*/\1/p' | head -1)"
  lb_load="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]lanes_by_load=\([0-9]*\).*/\1/p' | head -1)"
  lb_disk="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]lanes_by_disk=\([0-9]*\).*/\1/p' | head -1)"
  # `[^ ]*`, not `[0-9]*`: `unbounded` is a legitimate reading and must print as itself — the same
  # rule the `fork_headroom=` parse beside it already follows.
  lb_fork="$(printf '%s' "$rec" | sed -n 's/.*[[:space:]]lanes_by_fork=\([^ ]*\).*/\1/p' | head -1)"
  case "$lanes" in ''|*[!0-9]*) hu_row capacity - - "UNKNOWN (the decision ran but its lane count cannot be parsed: $rec)"; return 2 ;; esac
  # The reading rides IN THE ROW: a lane count with no fork/disk/load beside it is the tidy display
  # this rule forbids, and a reader could not tell a measured 12 from a pinned 8. The dimensions are
  # printed in the order they FAIL (fork → disk → load), each with the number it contributed, and
  # `via=` names WHICH probe answered so the shim fallback can never pass as the fleet instrument.
  local dims="fork headroom=${forkhead:-?} (${forksrc:-unknown}) → disk free=${dfree:-?}MB → load=${load:-?} ncpu=${ncpu:-?}"
  local cap_note=""
  [ "$fixed" != none ] && cap_note=" — the fixed cap '$fixed' is IGNORED as a ceiling"
  # ⛔ `lanes=<n> ` KEEPS ITS EXACT SHAPE (a space follows the number) — the existing suite asserts on
  # it, and an assertion that has to be rewritten to fit a new sentence is how a check drifts from the
  # thing it checked. The new dimensions ride INSIDE the parentheses beside it.
  if [ "$lanes" -eq 0 ] 2>/dev/null; then
    hu_row capacity - - "DEGRADED (no room: $dims → lanes=0 (binding=${binding:-?}; by fork=${lb_fork:-?} disk=${lb_disk:-?} load=${lb_load:-?}; via=${probe:-unknown})$cap_note)"; return 1
  fi
  hu_row capacity - - "OK (placement $dims → lanes=$lanes (binding=${binding:-?}; by fork=${lb_fork:-?} disk=${lb_disk:-?} load=${lb_load:-?}; via=${probe:-unknown} — measured, not a cap$cap_note))"; return 0
}

# What a refusal's reason MEANS, in the operator's terms. A bare `reason=disk_unreadable` is a token
# that names a probe, not a remedy; the sentence says what is missing and that a cap is not the answer.
hu_cap_reason_txt() {
  case "${1:-}" in
    fork_exhausted) printf 'this box COULD NOT FORK AT ALL (capacity.sh answered 254 — EAGAIN) — the remedy is EXTERNAL: restart or drain it; nothing inside it can be cleaned up, and a fixed lane cap is not a measurement' ;;
    fork_unreadable) printf 'the fork/task headroom could not be measured (ulimit -u, /proc/sys/kernel/threads-max, cgroup pids.max, kern.maxproc all unreadable) — a box that cannot prove it can fork must not be given lanes, and a fixed lane cap is not a measurement' ;;
    load_unreadable) printf 'the 1-min load average could not be read (/proc/loadavg and sysctl vm.loadavg both failed) — a fixed lane cap is not a measurement' ;;
    ncpu_unreadable) printf 'the CPU count could not be read (nproc, sysctl hw.ncpu and getconf all failed) — a fixed lane cap is not a measurement' ;;
    disk_unreadable) printf 'free disk could not be read for the state dir — a full disk is what breaks a box first, and a fixed lane cap is not a measurement' ;;
    *) printf '%s — the ceiling is a MEASUREMENT of this box (fork headroom, disk, load) and a fixed cap is not one' "${1:-unmeasurable}" ;;
  esac
}

# The cell supervisor / doctor loop. On a Mac there is no such component and the row says SKIPPED with
# its reason — "not applicable" is a PASS, and it is never rendered as OK (fleet-inventory's rule).
hu_row_supervisor() {
  local sess="${SESSION:-}" pids n
  [ "$PLATFORM" = "cell" ] || { hu_row supervisor - - "SKIPPED (no cell supervisor on macOS; launchd owns the controller)"; return 4; }
  sess="${SESSION:-orch}"
  if command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$sess" 2>/dev/null; then
    # ⛔ A FAILED READ IS NOT AN ABSENT PROCESS: "no doctor loop" about a table nobody could read is a
    # claim about a measurement that did not happen (the loop row already returns 2 at that point).
    pids="$(hu_pids "$HARNESS/cloud-cell-doctor.sh" "$O/cloud-cell-doctor.sh" 2>/dev/null)" \
      || { hu_row supervisor - '?' "UNKNOWN (the process table could not be read, so the doctor loop is unverifiable)"; return 2; }
    n="$(printf '%s\n' "$pids" | sed '/^$/d' | wc -l | tr -d ' ')"
    if [ "$n" -ge 1 ]; then hu_row supervisor "$(printf '%s' "$pids" | tr '\n' ' ' | sed 's/ *$//')" - "OK (controller session '$sess' + doctor)"; return 0; fi
    hu_row supervisor - - "DEGRADED (controller session '$sess' is up, no doctor loop)"; return 1
  fi
  hu_row supervisor - - "MISSING (no tmux session '$sess')"; return 1
}

# The LANES row: how many lanes are live, and whether they are ADVANCING.
# ⛔ A COUNT ALONE IS THE DEFECT THIS ROW EXISTS AGAINST. Five lanes whose last log write was four
# hours ago and five lanes merging PRs read identically as `lanes: 5`, and the operator's next move
# (wait / intervene) is opposite in the two cases. Advancement is read from the ONE artefact the
# worker launcher itself writes — `$O/logs/<worker>.log`, whose mtime `orch-loop.sh`'s own stale-worker
# reaper reads (STALE_MIN, 40 min) — so "advancing" here and "hung" there cannot disagree.
# ⛔ IT IS NOT A RESTART SIGNAL: a silent lane past the bound is REPAIRED by the controller's own
# reaper, and this row only reports it. Killing lanes is never a status verb's business.
# ⛔ COERCED, LIKE EVERY OTHER KNOB IN THIS FILE. An invalid bound is not a small typo here: with a
# non-numeric `HU_LANE_SILENT`, `[ "$age" -le "$HU_LANE_SILENT" ]` exits 2, the `if` takes the ELSE
# branch, and EVERY live lane reads SILENT (the row then prints `past abcs`) — the row fails in the
# direction that invents a problem. Same class, worse direction, for the NEXT bound below (a stale
# `[select]` line printed as `OK`), which is why both are normalised rather than trusted.
HU_LANE_SILENT="${HARNESS_UP_LANE_SILENT:-2400}"   # 40 min = orch-loop.sh's own STALE_MIN
case "$HU_LANE_SILENT" in ''|*[!0-9]*) HU_LANE_SILENT=2400 ;; esac
hu_row_lanes() {
  local d="$O/state" f name age n=0 adv=0 sil="" worst=0 retired=0 logs=0
  # ⛔ NO `$O/state` IS NOT "NO LANES": SKIPPED with its reason (not-applicable is a pass and is never
  # rendered as OK — the rule the launchd and supervisor rows follow).
  [ -d "$d" ] || { hu_row lanes - - "SKIPPED (no worker records under $O/state yet — no lane has run here)"; return 4; }
  # ⛔ LIVE LANES COME FROM THE LAUNCHER'S OWN WORKER RECORDS (`$O/state/run-<name>.sh`, written at
  # spawn and REMOVED by wt_close), NOT from the log directory. Measured on this cell 2026-10-22: the
  # first version enumerated `$O/logs/*.log` and reported `0/159 advancing` on a box with FIVE live
  # lanes — 259 log files is what a week of work leaves behind, and counting retired logs as silent
  # lanes is precisely the "a stale flag read as present-tense" defect this row exists to prevent.
  # The same records `worker-terminal.sh` uses are the only population the controller itself counts,
  # so "what the controller counts", "what it reaps" and "what this row names" cannot disagree.
  for f in "$d"/run-*.sh; do
    [ -f "$f" ] || continue
    name="$(basename "$f" .sh)"; name="${name#run-}"
    case "$name" in lane-*|merge-*|fix-*|chain-*) : ;; *) continue ;; esac
    n=$((n + 1))
    if age="$(hu_file_age "$O/logs/$name.log")"; then
      if [ "$age" -le "$HU_LANE_SILENT" ]; then adv=$((adv + 1))
      else sil="$sil $name"; [ "$age" -gt "$worst" ] && worst="$age"; fi
    else
      # A live worker record with no log at all: the lane exists and has written nothing, which is
      # silence — but its AGE is unknown, and unknown is not "fresh".
      sil="$sil $name(no log)"
    fi
  done
  # Retired logs are COUNTED AND NAMED as retired, never judged. They are the durable trace of work
  # that finished; a box that has run for a week has hundreds and they are not a health signal.
  for f in "$O/logs"/*.log; do
    [ -f "$f" ] || continue
    name="$(basename "$f" .log)"
    case "$name" in lane-*|merge-*|fix-*|chain-*) : ;; *) continue ;; esac
    logs=$((logs + 1))
    [ -f "$d/run-$name.sh" ] || retired=$((retired + 1))
  done
  if [ "$n" -eq 0 ]; then
    hu_row lanes 0 - "OK (no lane is live — 0 worker records; $retired finished log(s) on disk, none judged)"; return 0
  fi
  # The bound is printed whenever it is used, because "silent" is meaningless without the number it
  # was measured against — and that number is the controller's, not this row's invention.
  if [ -n "$sil" ]; then hu_row lanes "$n" "$(hu_age_txt "$worst")" "DEGRADED ($adv/$n live and advancing; SILENT past ${HU_LANE_SILENT}s:$sil — the controller's own reaper closes these; $retired finished log(s) ignored)"; return 1; fi
  hu_row lanes "$n" - "OK ($adv/$n live and advancing — every live lane wrote within ${HU_LANE_SILENT}s; $retired finished log(s) ignored)"; return 0
}

# ⛔ `chain-*` IS IN THIS POPULATION BECAUSE THE CONTROLLER COUNTS IT. `dispatch-merge.sh:217` spawns
# its review→record→merge workers as `chain-<N>` through `wt_spawn`, and `wt_count lane- chain-` is the
# census the controller itself takes — so leaving them out of this row made a LIVE chain worker read as
# `OK (no lane is live — 0 worker records …)`, the false pass this row exists against. The population
# is the launcher's own worker records because it is the one the controller counts and reaps; a
# record kept after a kill it could not prove (worker-terminal.sh's documented `record kept, retried
# next cycle`) is the residual this population shares with the controller, and is tracked on #2653.
# The NEXT row: what the controller would do on its next pass, read from the line it PRINTED for that
# decision. ⛔ THIS IS NOT A PREDICTION. `orch-loop.sh` writes one `[select]` line per cycle (the
# owner's funnel ruling, 2026-10-18) precisely so "nothing to do" and "blocked" stop looking alike;
# this row surfaces the last one, with its age, instead of re-deriving a second opinion that could
# disagree with the controller's. A stale line is LATE, never "the current plan".
HU_NEXT_STALE="${HARNESS_UP_NEXT_STALE:-900}"
# ⛔ COERCED (see HU_LANE_SILENT). Unvalidated, this bound inverts the row's polarity in the FAIL-OPEN
# direction: `[ "$age" -gt abc ]` exits 2, the `if` takes its ELSE branch, and a five-hour-old
# `[select]` line prints `OK` — the row's contribution drops from DEGRADED to HEALTHY exactly when it
# should red (measured: HARNESS_UP_NEXT_STALE=abc on a 5h log → `next|-|5h|OK: [select] …`).
case "$HU_NEXT_STALE" in ''|*[!0-9]*) HU_NEXT_STALE=900 ;; esac
hu_row_next() {
  local log="$O/logs/orch-loop.log" line age
  # Same rule as the lanes row: an ABSENT log is "no cycle has been recorded here", which is
  # not-applicable (and a PASS), not cannot-verify. An EXISTING log with no decision line IS a real
  # cannot-verify — a cycle ran and the operator still cannot be told what it decided.
  [ -r "$log" ] || { hu_row next - - "SKIPPED (no cycle recorded under $O/logs yet — there is no decision line to quote)"; return 4; }
  line="$(grep '^\[select\]' "$log" 2>/dev/null | tail -1)"
  [ -n "$line" ] || line="$(grep '^\[dispatch\]' "$log" 2>/dev/null | tail -1)"
  # ⛔ A LOG WITH NO DECISION LINE YET IS NOT CANNOT-VERIFY — it is a controller that has not finished
  # its FIRST cycle. `orch-loop.sh:334` appends `[startup] worker launcher=…` to this log at boot, 240 s
  # (CYC) before the first `[select]` line exists, so the comment this branch first shipped here
  # ("an existing log with no decision line IS a real cannot-verify — a cycle ran") described a case
  # that a FRESH box never reaches: it described the SECOND cycle. Returning 2 there made `up` exit 2
  # AFTER A SUCCESSFUL START on a healthy box — the exact failure `hu_row_exec`'s own comment rejects
  # ("teaches an operator to ignore a genuine cannot-verify"); measured on a log holding one
  # `[startup]` line with every other row green: `VERDICT: BROKEN (rc=2)`.
  # So the answer is bounded by the row's own staleness rule: younger than one bound is STARTING (not
  # applicable, a pass), older than it is a controller that SHOULD have decided and has not.
  if [ -z "$line" ]; then
    if age="$(hu_file_age "$log")" && [ "$age" -le "$HU_NEXT_STALE" ]; then
      hu_row next - "$(hu_age_txt "$age")" "STARTING (no [select]/[dispatch] line yet — the log is younger than ${HU_NEXT_STALE}s, i.e. the first cycle has not reached its decision; the startup line is above)"; return 4
    fi
    hu_row next - - "UNKNOWN (the log is older than ${HU_NEXT_STALE}s and still carries no [select] or [dispatch] line — a cycle should have decided by now)"; return 2
  fi
  # A log line has no timestamp of its own; the LOG's mtime is when any cycle last wrote, which bounds
  # the line's age from above (the line cannot be older than the file it was appended to last).
  age="$(hu_file_age "$log")" || { hu_row next - - "? ${line}"; return 2; }
  line="$(printf '%s' "$line" | cut -c1-320)"
  if [ "$age" -gt "$HU_NEXT_STALE" ]; then hu_row next - "$(hu_age_txt "$age")" "LATE (log older than ${HU_NEXT_STALE}s, so this is the last decision and not the next): $line"; return 1; fi
  hu_row next - "$(hu_age_txt "$age")" "OK: $line"; return 0
}

# The SELF-TEST row: the checks that make this a healtH CHECK and not a memory. ⛔ A HEALTH CHECK THAT
# ONLY PASSES BY REMEMBERING IS A DEFECT (the brief's rule), so every probe below is taken NOW and
# reads a LIVE artefact: the scripts the box would EXECUTE are syntax-parsed where they are, and each
# platform probe in the shim is called and must answer. A remembered "last run: ok" file is
# deliberately absent — that is exactly the record this row refuses to trust.
#
# ⛔ #2930 — A TEST SUITE'S PARSE ERROR IS NOT A BOX-LEVEL BREAK, AND THIS ROW MADE IT ONE. `up`
# REFUSES TO START on a failed self-test, so a `*.test.sh` that cannot parse on THIS host (macOS is
# bash 3.2.57; CI is bash 5) turned a healthy controller into `selftest BROKEN` that could not be
# started — the same catch-22 `install.sh` had, at the one place that decides whether the box runs at
# all (`merge-reminder.test.sh` was that file). A `*.test.sh` is never executed by the controller, so
# it joins no `bad` list: it is NAMED in the OK row instead, because the operator still needs to know
# the suite cannot run HERE. Runtime scripts keep the refusal. The class is gated before merge by
# scripts/check-bash32-parse.sh (a real bash 3.2 over every shipped `*.sh`, in both CI lanes).
hu_row_selftest() {
  local f bad="" nb=0 probes="" tb=""
  [ -d "$HARNESS" ] || { hu_row selftest - - "BROKEN (the harness dir $HARNESS does not exist — nothing was parsed)"; return 2; }
  for f in "$HARNESS"/*.sh; do
    [ -f "$f" ] || continue
    nb=$((nb + 1))
    if bash -n "$f" 2>/dev/null; then continue; fi
    case "$(basename "$f")" in
      *.test.sh) tb="$tb $(basename "$f")" ;;
      *) bad="$bad $(basename "$f")" ;;
    esac
  done
  [ "$nb" -gt 0 ] || { hu_row selftest - - "BROKEN (0 scripts found in $HARNESS — a check over nothing is not a pass)"; return 2; }
  # Each platform question, asked rather than assumed. The NAME goes in the row so a Mac operator can
  # see the Darwin probe answered and a cell operator the Linux one.
  _p() { if "$1" >/dev/null 2>&1; then probes="$probes $2"; else bad="$bad $2"; fi; }
  _p hp_ncpu ncpu; _p hp_load1_c load; _p hp_fork_headroom fork; _p hp_disk_free_mb disk
  if hp_stat_mtime "$0" >/dev/null 2>&1; then probes="$probes mtime"; else bad="$bad mtime"; fi
  if _t="$(hp_mktemp_d)" && [ -n "$_t" ]; then rmdir "$_t" 2>/dev/null; probes="$probes tmp"; else bad="$bad tmp"; fi
  if [ -n "$bad" ]; then hu_row selftest - - "BROKEN (failed:${bad}; parsed $nb script(s) in $HARNESS)"; return 2; fi
  # `tb` is REPORTED, never fatal — see the #2930 block above the loop.
  hu_row selftest - - "OK (bash -n on $nb live script(s) in $HARNESS${tb:+; test suite(s) that do NOT parse here (#2930, reported not fatal):${tb}}; shim probes answered:${probes})"; return 0
}

# ── self-heal: the two repairs that are SAFE WHILE LANES WORK ───────────────────────────────────
# ⛔ WHAT MAY BE HEALED, AND WHAT MAY NOT, IS THE WHOLE DESIGN. Both arms below are non-destructive by
# construction:
#   (1) A controller that is NOT RUNNING is started. Nothing live is interrupted — the lanes are
#       separate worker processes that the start does not touch — and `orchestrator-bringup.sh start`
#       owns the duplicate refusal, so a second `harness-status` cannot start a second controller.
#   (2) A pin that is BEHIND the ref is re-pinned. `harness-refresh.sh`'s advance is explicitly
#       non-destructive (#2278: "the pin advance kills nothing") and leaves the running controller on
#       its own tree, so lanes keep working across it.
# ⛔ WHAT IS NEVER HEALED HERE: a DUPLICATE controller (killing one is a P0 action and belongs to a
# human), a controller that is LATE (alive but quiet — cycling a healthy supervisor would drop
# in-flight lanes; the controller's own watchdog owns that call), and `restart-pending` (the pin is
# AHEAD of the running tree: closing it REQUIRES dropping the running controller, which is the
# operator's deliberate `harness-down` then `harness-up`, never a side effect of asking for status).
HU_HEAL_NOTE=""
hu_heal() {
  local st rel started=0 foreign="" rel_age=""
  st="$(hu_row_state loop)"
  case "$st" in
    MISSING*)
      # ⛔ THE LOOP ROW'S CENSUS IS SCOPED; THE EXEC ROW'S IS NOT — AND ONLY THE SCOPED ONE IS CONSULTED
      # HERE. `hu_ctrl_pids` matches this box's state dir and harness path; `hu_any_ctrl_pids` (what the
      # exec row reads) matches ANY `orch-loop.sh` on the box, precisely because a controller can be
      # executing code the records never named — `~/.cache/orc/main-orch-loop.sh`, a hand-launched old
      # worktree, a stale second pin. `orchestrator-bringup.sh`'s registry claim cannot refuse that
      # controller either: a hand-launched one never registered there. So starting on the MISSING arm
      # alone MANUFACTURES the duplicate this verb explicitly refuses to heal — two controllers
      # draining one repo, two lanes on one PR — from the operator's own "just tell me the state" call.
      # The unsafe direction is the start, so an unreadable ANY-census also declines: cannot-tell is
      # never "nothing else is running" (measured in review round 1 of this change).
      if foreign="$(hu_any_ctrl_pids)"; then
        if [ -n "$foreign" ]; then
          HU_HEAL_NOTE="$HU_HEAL_NOTE
NOT HEALED: $st, but a controller process is live that this box's records do not name (pid(s) $(printf '%s' "$foreign" | tr '\n' ' ')— see the exec row). Starting another would DUPLICATE it, and which controller to stop is a human decision — inspect the exec row, then stop one deliberately"
          return 0
        fi
      else
        HU_HEAL_NOTE="$HU_HEAL_NOTE
NOT HEALED: $st, and whether another controller is live could not be read (the process table was unreadable) — starting on cannot-tell risks duplicating one; run 'harness-up' if you know the box is clear"
        return 0
      fi
      log_line "heal: the controller is NOT running — starting it (nothing live is interrupted; lanes are separate workers)"
      if hu_start_loop; then HU_HEAL_NOTE="$HU_HEAL_NOTE
HEAL: started a controller that was not running"; started=1
      else HU_HEAL_NOTE="$HU_HEAL_NOTE
HEAL FAILED: the controller still is not running (see above)"; fi ;;
    DUPLICATE*)
      HU_HEAL_NOTE="$HU_HEAL_NOTE
NOT HEALED: $st — choosing which controller to kill is a human decision, not a status verb's" ;;
    LATE*)
      HU_HEAL_NOTE="$HU_HEAL_NOTE
NOT HEALED: $st — a live-but-quiet controller is never cycled by status (that would drop in-flight lanes)" ;;
  esac
  rel="$(sed -n 's/^relation=\([a-z-]*\).*/\1/p' "$O/state/harness-refresh" 2>/dev/null | head -1)"
  [ -n "$rel" ] || rel="$(sed -n 's/.*[[:space:]]relation=\([a-z-]*\).*/\1/p' "$O/state/harness-refresh" 2>/dev/null | head -1)"
  # ⛔ A RECORDED RELATION IS NOT A LIVE STATE, AND AN AGED ONE IS NOT EVIDENCE FOR A REPAIR. The
  # refresh row treats this same record as LATE past `HU_REFRESH_STALE` and refuses to judge on it;
  # the heal must apply the SAME test before it ACTS on it — otherwise a days-old `relation=behind`
  # still triggers a fetch and a pin advance, i.e. a stale flag that records a past state is spent as
  # present-tense evidence, with the record's own row simultaneously calling it LATE.
  rel_age="$(hu_file_age "$O/state/harness-refresh" 2>/dev/null)" || rel_age=""
  case "${rel:-}" in
    behind)
      if [ -z "$rel_age" ] || [ "$rel_age" -gt "$HU_REFRESH_STALE" ]; then
        HU_HEAL_NOTE="$HU_HEAL_NOTE
NOT HEALED: the refresh record says relation=behind but it is ${rel_age:+older than ${HU_REFRESH_STALE}s}${rel_age:-unreadable} — a recorded relation is not a live state, so no pin advance was run on it; re-read with 'harness status' after the controller refreshes"
        return 0
      fi
      log_line "heal: the pin is BEHIND $REF — re-pinning (harness-refresh advances the pin and kills nothing, #2278)"
      if hu_start_refresh; then HU_HEAL_NOTE="$HU_HEAL_NOTE
HEAL: re-pinned a stale harness (relation was behind)"
      else HU_HEAL_NOTE="$HU_HEAL_NOTE
HEAL FAILED: the pin is still behind (see above)"; fi ;;
    restart-pending)
      # ⛔ A RECORDED RELATION IS NOT A LIVE STATE (measured on this cell 2026-10-22): the record said
      # `restart-pending` while NO controller was running at all, so the remedy it printed (drop the
      # running controller) pointed at a process that did not exist. The recorded relation describes the
      # last controller that wrote it; whether a restart is pending is only meaningful when one is
      # RUNNING, and the live answer to that is the loop row.
      case "$(hu_row_state loop)" in
        OK*) HU_HEAL_NOTE="$HU_HEAL_NOTE
NOT HEALED: the pin is AHEAD of the running tree (restart-pending) — closing it requires dropping the running controller; run 'harness-down' then 'harness-up', deliberately" ;;
        # ⛔ THE ROWS ARE THE PRE-HEAL SET, so "nothing is running" may already be false BY THIS PASS's
        # OWN ACTION: if the MISSING arm above started a controller, the pending restart was closed by
        # that start, and repeating "no controller is running now" would contradict the note printed a
        # few lines earlier — the "a recorded relation is not a live state" inversion this block exists
        # to close, re-introduced by reading a stale row set.
        *)   if [ "$started" -eq 1 ]; then HU_HEAL_NOTE="$HU_HEAL_NOTE
STALE RECORD CLEARED: relation=restart-pending described the controller that had STOPPED; this pass started one, so the pending restart is closed by that start (re-read the table above for the live row)"
             else HU_HEAL_NOTE="$HU_HEAL_NOTE
STALE RECORD: relation=restart-pending describes the LAST controller, and no controller is running now — the loop row is the live answer"; fi ;;
      esac ;;
  esac
  HU_HEAL_NOTE="$(printf '%s' "$HU_HEAL_NOTE" | sed '/^$/d')"
  return 0
}

# The state text of one collected row (`hu_row` wrote NAME|PID|AGE|STATE).
hu_row_state() { printf '%s' "$HU_ROWS" | awk -F'|' -v n="${1:-}" '$1==n {print $4; exit}'; }


# The divergence row delegates to the ONE instrument that owns that question (agent-infra#1745's
# check-deployed-drift.sh). This file never grows a second copy of it.
hu_row_drift() {
  local rc log="$HU_TMP/drift.log"
  [ -f "$HARNESS/check-deployed-drift.sh" ] || { hu_row drift - - "BROKEN (check-deployed-drift.sh is missing from $HARNESS)"; return 2; }
  # ⛔ OUTPUT VIA A FILE, not `out=$(…)`: (a) a captured substitution cannot be shown to a human when
  # the tool is bounded and killed mid-write, and (b) `x="$(bash <script>)"` is refused outright by the
  # hub-state gate's indirection arm, which cannot verify a substituted invocation per-invocation.
  hu_run "$BOUND" bash "$HARNESS/check-deployed-drift.sh" --surface --no-fetch >"$log" 2>&1
  rc=$?
  case "$rc" in
    0) hu_row drift - - "OK (no divergence against $REF)"; return 0 ;;
    1) hu_row drift - - "DRIFT (see: $HARNESS/check-deployed-drift.sh --surface)"; sed -n 's/^\(DRIFT.*\)/    \1/p' "$log" | head -8; return 1 ;;
    2) hu_row drift - - "BROKEN (unverifiable — see $HARNESS/check-deployed-drift.sh --surface)"; sed -n 's/^\(UNKNOWN.*\)/    \1/p' "$log" | head -8; return 2 ;;
    # ⛔ ANY OTHER STATUS IS CANNOT-VERIFY, AND CANNOT-VERIFY IS BROKEN. 142 is the bound firing,
    # 125 is "no usable bound" (this file's own fail-closed answer), 127 is "not run". Returning the
    # status unchanged let the status verb read a row that says UNKNOWN as a healthy component —
    # measured by the verifier: `VERDICT: HEALTHY` over an unrun drift comparison (#2231).
    *) hu_row drift - - "BROKEN (the comparison did not run: $(hu_bound_explain "$rc" "$BOUND"))"; sed -n '1,6p' "$log" | sed 's/^/    /'; return 2 ;;
  esac
}

# ── the components, in DEPENDENCY ORDER ─────────────────────────────────────────────────────────
# The order is declared here and nowhere else: the pin truth first (a start from an unknown tree is
# the defect), then the registry the controller needs, then the controller, then the role that
# repairs it. This is the same shape the field converged on — a declarative component list with a
# declared start order, kept separate from "is this component required on this box" (systemd's
# ordering dependencies vs requirement dependencies; supervisord's `priority`) — and the component
# each step delegates to stays the authority for its own mechanism.
HU_COMPONENTS="refresh claims loop supervisor"

# ⛔ THE RECORD HAS ONE SHAPE, AND IT IS THE CONTROLLER'S. `orch-loop.sh:717-718` writes
# `relation=… running=… ref=… pin=… action=… fetch=… rc=… at=…` and `cloud-cell-supervisor.sh:2260-2262`
# READS `fetch=` to decide whether the comparison was fresh ("a `current` against a comparison that is
# not `ok` is cannot-verify"). Writing the refresh's STDOUT line (`harness relation=… at=…`) here lost
# `fetch=`, so the reader defaulted it to `ok` and a `--no-fetch` comparison was reported as fresh —
# the exact false PASS that field exists to prevent (measured in review). Staged-and-renamed, like every
# other record in this repo: an in-place write can leave a truncated file mid-read.
hu_write_refresh_record() { # <rc> <relation> <log>
  local rc="$1" rel="$2" log="$3" run ref pin act fet tmp
  _f() { sed -n "s/.*[[:space:]]$1=\([^ ]*\).*/\1/p" "$log" 2>/dev/null | head -1; }
  run="$(_f running)"; ref="$(_f ref)"; pin="$(_f pin)"; act="$(_f action)"; fet="$(_f fetch)"
  [ -n "$fet" ] || { [ "$FETCH" -eq 1 ] && fet="ok" || fet="notfetched"; }
  mkdir -p "$O/state" 2>/dev/null || { warn "refresh: cannot create $O/state — the record is not written"; return 1; }
  tmp="$O/state/.harness-refresh.tmp.$$"
  printf 'relation=%s running=%s ref=%s pin=%s action=%s fetch=%s rc=%s at=%s\n' \
    "${rel:-unknown}" "${run:-unknown}" "${ref:-unknown}" "${pin:-none}" "${act:-none}" "$fet" "$rc" "$(date +%s)" \
    > "$tmp" 2>/dev/null && mv -f "$tmp" "$O/state/harness-refresh" 2>/dev/null \
    || { rm -f "$tmp" 2>/dev/null; warn "refresh: cannot write $O/state/harness-refresh — the row will read whatever the controller last wrote"; return 1; }
  return 0
}

hu_start_refresh() {
  local rc args rel log="$HU_TMP/refresh.log"
  # ⛔ `--pin` ONLY WHEN THIS BOX OWNS PIN MACHINERY. Handing the refresh an explicit pin path on a box
  # that has none makes it record one where nothing will ever materialise it, and (before the split in
  # hu_verify_pin) the next `up` then refused for the life of the box. With no flag the refresh's own
  # default governs, which is the same file but is the refresh's decision, not ours.
  args=(--repo "$HREPO" --ref "$REF")
  [ "$PIN_PRESENT" -eq 1 ] && args+=(--pin "$PIN_SHA_FILE")
  [ "$FETCH" -eq 1 ] || args+=(--no-fetch)
  hu_run "$BOUND" bash "$HARNESS/harness-refresh.sh" "${args[@]}" >"$log" 2>&1
  rc=$?
  sed 's/^/    /' "$log"
  rel=$(sed -n 's/^harness relation=\([a-z-]*\).*/\1/p' "$log" | head -1)
  case "$rc" in
    0|10|11)
      # The row reads THIS record, and until now only `orch-loop.sh` wrote it — so a box whose controller
      # had not completed a cycle yet reported "refresh: never ran" seconds after `up` had run it.
      hu_write_refresh_record "$rc" "$rel" "$log"
      log_line "refresh: ok (relation=${rel:-current})"; return 0 ;;
    # ⛔ 25 IS TRUTH, NOT A FAILURE — but it must be SAID, not swallowed: this box is on the ref's
    # line and OLDER, and has no materialiser, so the pin did not advance. Starting is still allowed
    # (the deployed $O may be legitimately operator-synced) and the verdict carries it.
    25) hu_write_refresh_record "$rc" "${rel:-behind}" "$log"
        warn "refresh: BEHIND (relation=${rel:-behind}) — this box is on $REF's line but older and has no materialiser to advance it"; return 0 ;;
    # ⛔ A REFUSAL IS NOT A WARNING. `dirty`/`ahead`/`diverged`/`unknown` means the pin does not
    # describe a tree this box may run, and starting anyway would run code nobody chose.
    *) warn "refresh REFUSED (relation=${rel:-unknown}) — not starting"; return 1 ;;
  esac
}

# The cross-box claim registry. It is DATA on the remote (`refs/claims/*`), not a process, so "starting"
# it means ONE bounded read: can this box see the namespace the fleet latches on? An unreadable
# namespace is not cosmetic — with it unreadable every box silently falls back to per-box locks, which
# is exactly the duplicate-work class the registry exists to remove. The verdict is RECORDED so
# `status` can answer without paying a network round trip per row.
hu_start_claims() {
  local rc verdict=absent tmo="${HU_CLAIMS_TIMEOUT:-25}" log="$HU_TMP/claims.log"
  HU_CLAIMS_WHY=""
  command -v git >/dev/null 2>&1 || { warn "claims: git is absent — the registry cannot be probed, and cannot-verify is not a pass"; return 1; }
  # ⛔ THE SAME EMPTY-VALUE TRAP, ONE NAMESPACE OVER: `git -C "" ls-remote origin` reads the CWD's repo —
  # a NETWORK probe against an unnamed repo — and then this function PERSISTS `claims=reachable` for it,
  # which every later `status` reads as an answer without probing. No work repo, no probe.
  [ -n "$REPO" ] || { HU_CLAIMS_WHY="no work repo resolved"; warn "claims: no work repo resolved (see the harness-up warning above) — the registry cannot be probed"; return 1; }
  # ⛔ NO `--heads`: it restricts the query to `refs/heads/*`, so `refs/claims/*` (a different
  # namespace) never matches and the probe could only ever answer "absent" — a row reporting an empty
  # registry on every box, whatever it holds. Measured in review; the fixture now carries a claim ref.
  hu_run "$tmo" git -C "$REPO" ls-remote origin 'refs/claims/*' >"$log" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ]; then
    warn "claims: could not read refs/claims from origin ($(hu_bound_explain "$rc" "$tmo")) — a box with an unreadable registry silently falls back to per-box locks"
    return 1
  fi
  verdict=absent
  grep -q 'refs/claims/' "$log" 2>/dev/null && verdict=reachable
  mkdir -p "$O/state" 2>/dev/null || { warn "claims: cannot create $O/state — the probe cannot be recorded"; return 1; }
  # ⛔ THE RECORD NAMES THE REPO IT PROBED, AND THE ORIGIN THAT MAKES IT TRUE. `refs/claims` is a fact
  # about ONE repo's origin, so neither a record written when the box drained a different repo, nor one
  # left behind at a path that was re-cloned from a DIFFERENT origin (the cell-recycling shape — `$O/state`
  # outlives the checkout), is an answer about this one. A box repurposed, or a pre-split run (where `REPO`
  # could be the harness checkout), leaves exactly such a record behind for up to HU_CLAIMS_STALE. Records
  # from before these fields existed keep working (empty `repo=`/`origin=` means "unattributed"), so
  # nothing reds on an old box, but every NEW record is attributable down to the origin it probed.
  printf 'claims=%s repo=%s origin=%s at=%s\n' "$verdict" "$REPO" "$(hu_origin "$REPO")" "$(date +%s)" \
    > "$O/state/harness-claims" 2>/dev/null \
    || { warn "claims: $O/state is not writable — the probe cannot be recorded"; return 1; }
  log_line "claims: ok (refs/claims $verdict)"
  return 0
}

# The controller. DELEGATED to the fleet entry point, which already owns the platform verbs: it claims
# the (machine, repo) registry, runs its own `check`, starts the controller the platform's way, and
# then makes every MISSING fleet component present from the one declared inventory.
hu_start_loop() {
  local rc gh_rc live n pid path herd
  # ⛔ ALREADY-UP IS THE IDEMPOTENT ANSWER, AND IT IS NOT A RESTART. `orchestrator-bringup.sh start`
  # REFUSES a second controller for the same repo+state dir (`registry_claim_or_refuse`, exit 1), so a
  # SECOND `harness-up` on a healthy box reported FAILED — an operator's second run looked like a
  # defect on a box that was perfectly up, and "run it twice" is the one thing a launcher must make
  # safe. The tempting repair — stop then start — is the one this file must NOT make: a healthy
  # launchd/cell supervisor is deliberately never cycled (bringup's own ADOPT arm: "cycling a healthy
  # supervisor would only drop supervision"), and a pin advance is explicitly NOT a reason to kill a
  # running controller (#2216, #2278: the advance leaves the running tree alone and only the RESTART
  # is deferred). So a live controller that executes THE TREE THIS RUN RESOLVED is left alone and
  # named; one executing a DIFFERENT tree is named and FAILS this step, still untouched — moving it is
  # the operator's deliberate `down` then `up`, never a side effect of `up`.
  if ! live="$(hu_ctrl_pids)"; then
    # ⛔ AN UNREADABLE CENSUS WARNS AND DELEGATES — it does not refuse here. The duplicate this check
    # exists to avoid is ALSO refused, mechanically and authoritatively, by `orchestrator-bringup.sh`'s
    # registry claim (an EXCLUSIVE CREATE: two starts cannot both win it). Refusing on an unreadable
    # table instead would make `up` unable to start a controller on any box whose `ps` is restricted —
    # turning "I could not look" into "this command does not start things", which is the availability
    # failure a launcher exists to avoid. The census has one job here (name an ALREADY-UP box so a
    # second `up` is a no-op); the duplicate guard does not depend on it.
    warn "loop: cannot read the process table, so whether a controller is already running is UNKNOWN — delegating to the authority (its registry claim refuses a duplicate by construction)"
    live=""
  fi
  live="$(printf '%s\n' "$live" | sed '/^$/d')"
  if [ -n "$live" ]; then
    n="$(printf '%s\n' "$live" | wc -l | tr -d ' ')"
    if [ "$n" -eq 1 ]; then
      pid="$live"
      path="$(hu_exec_path_of "$pid" 2>/dev/null)" || path=""
      # ⛔ TWO LOCATIONS ARE "THIS RUN'S TREE", and the second is the Mac's: `install.sh` deploys the
      # flat copy into `$O` and the plist execs `__O__/orch-loop.sh` (launchd.plist.template:10,
      # install.sh:26), so on a Mac `HARNESS` (a checkout) and `$O` (the deployed copy) are DIFFERENT
      # paths for the SAME deployment. Comparing against `$HARNESS` alone reported a healthy Mac's
      # second `up` as a failed start — the exact defect this arm removes (measured in review).
      if [ -n "$path" ] && { [ "$(hu_real "$(dirname "$path")")" = "$(hu_real "$HARNESS")" ] || [ "$(hu_real "$(dirname "$path")")" = "$(hu_real "$O")" ]; }; then
        log_line "loop: ALREADY UP (pid $pid executing $path) — left alone: one controller per state dir, and a healthy one is never cycled (that would drop in-flight lanes)"
        return 0
      fi
      # ⛔ AN UNREADABLE PATH IS NOT A FOREIGN ONE (review round 5). `[ -n "$path" ]` being false is
      # evidence that the read FAILED (a pid that exited between the census and this read, a restricted
      # /proc) — asserting "NOT from this run's harness" from it claimed a fact nobody established, and
      # its remedy (`down` then `up`) is one an operator should not follow on a healthy box. Say only
      # what is known, and fail closed either way.
      if [ -z "$path" ]; then
        warn "loop: a controller is already running (pid $pid) but THIS RUN CANNOT TELL whether it executes this run's harness ($HARNESS) — its argv could not be read. Left alone (a start must not cycle a live controller); check: ps -p $pid -o command="
        return 1
      fi
      warn "loop: a controller is already running (pid $pid, executing $path) but NOT from this run's harness ($HARNESS) — left alone, and this start cannot move it: a pin advance needs a deliberate '$0 down' then '$0 up', never a kill"
      return 1
    fi
    herd="$(printf '%s' "$live" | tr '\n' ' ' | sed 's/ *$//')"
    warn "loop: $n controllers are already live for this harness ($herd) — one controller per repo; nothing was started, and nothing was killed"
    return 1
  fi
  # `gh` is the controller's hands (open/merge). A bounded probe says so BEFORE it runs: not a refusal
  # (a box may legitimately queue work offline), but never silent — and never `gh auth token`, which
  # hangs for the life of the shell (rc=142 measured).
  # ⛔ FOUR ANSWERS, NOT TWO. The probe returns the BOUND's status when it fires (142) or when no bound
  # is usable (125); folding those into "NOT authenticated" reports a state nobody measured. Only 1 is
  # the measured "installed but not signed in" answer from `gh auth status`.
  gh_rc="$(hu_gh_probe)"; case "$gh_rc" in
    0) : ;;
    3) warn "gh: not installed — the controller can run but cannot open or merge a PR" ;;
    1) warn "gh: installed but NOT authenticated (bounded probe) — the controller's PR flow will stall" ;;
    *) warn "gh: could not be verified ($(hu_bound_explain "$gh_rc" "${HU_GH_TIMEOUT:-20}")) — not treated as authenticated, and not as absent" ;;
  esac
  [ -f "$SELF_PATH/orchestrator-bringup.sh" ] || { warn "loop: no orchestrator-bringup.sh beside $SELF — cannot start the controller this way"; return 1; }
  # ⛔ `ORCH_FOREGROUND=0` IS PINNED, NOT INHERITED (review P2 round 17, #2402). A service-managed
  # controller exports `ORCH_FOREGROUND=1` into its WHOLE process tree, and a tmux server that controller
  # started carries it into every lane shell — so this delegation, run from such a shell, would take
  # `start`'s FOREGROUND branch, `exec` the loop inside the CALLER and leave the enabled unit unsupervised
  # (the surface reads supervised while the controller dies with the shell). The value describes the
  # CALLER, so the caller pins it.
  ORCH_FOREGROUND=0 hu_run "$BOUND" bash "$SELF_PATH/orchestrator-bringup.sh" start >"$HU_TMP/loop.log" 2>&1; rc=$?
  sed 's/^/    /' "$HU_TMP/loop.log" | tail -n 40
  if [ "$rc" -eq 0 ]; then log_line "loop: ok"; return 0; fi
  warn "loop: start failed ($(hu_bound_explain "$rc" "$BOUND")) — see the output above"
  return 1
}

# The repairing role. On a cell the controller's own `start` brings the doctor up; this VERIFIES it and
# only calls the supervisor directly when the session is genuinely absent.
hu_start_supervisor() {
  local sess="${SESSION:-orch}" rc
  if [ "$PLATFORM" != "cell" ]; then log_line "supervisor: SKIPPED (no cell supervisor on macOS; launchd owns the controller)"; return 0; fi
  if command -v tmux >/dev/null 2>&1 && tmux has-session -t "=$sess" 2>/dev/null; then log_line "supervisor: ok (session '$sess' is up)"; return 0; fi
  [ -f "$SELF_PATH/cloud-cell-supervisor.sh" ] || { warn "supervisor: no cloud-cell-supervisor.sh beside $SELF, and no session '$sess'"; return 1; }
  # ⛔ same inheritance fence as the loop arm above (review P2 round 17, #2402): inside a service-managed
  # controller's tree, an inherited `ORCH_FOREGROUND=1` would re-parent the controller into THIS shell.
  ORCH_FOREGROUND=0 hu_run "$BOUND" bash "$SELF_PATH/cloud-cell-supervisor.sh" start >"$HU_TMP/sup.log" 2>&1; rc=$?
  sed 's/^/    /' "$HU_TMP/sup.log" | tail -n 30
  [ "$rc" -eq 0 ] || { warn "supervisor: start failed ($(hu_bound_explain "$rc" "$BOUND"))"; return 1; }
  log_line "supervisor: ok"; return 0
}

hu_start_component() { # <name>
  case "$1" in
    refresh)    hu_start_refresh ;;
    claims)     hu_start_claims ;;
    loop)       hu_start_loop ;;
    supervisor) hu_start_supervisor ;;
    *) die "internal: unknown component '$1'" ;;
  esac
}

# ── verbs ────────────────────────────────────────────────────────────────────────────────────────
cmd_up() {
  local c rc pin_rc=0 bad=0 cap="" cap_rc=0 cap_lanes="" cap_fixed="none"
  # ⛔ THE ONE VERB THAT REFUSES ON A BAD `REPO`: it would START a controller that drains a repo nobody
  # named. Nothing is started, so the refusal is safe here and nowhere else (see the REPO_BAD block).
  [ -z "$REPO_BAD" ] || die "$REPO_BAD — and 'up' STARTS a controller that would drain it. Nothing was started." 2
  [ -z "$HREPO_BAD" ] || die "$HREPO_BAD — and 'up' needs the harness repo to resolve the pin. Nothing was started." 2
  # ⛔ NAME WHERE `REPO` CAME FROM. `--repo` can no longer set it, so the only ways to have a wrong
  # work repo are INHERITED ones (a shell export, the config file) — and an inherited value that is
  # valid-but-unintended is accepted silently. Naming its source is what makes that visible on the
  # screen instead of implied by a path the reader must recognise.
  log_line "==> harness-up ($PLATFORM) — repo $REPO (${REPO_SRC:-fallback: the harness checkout}), harness repo $HREPO, ref $REF"
  log_line "    state dir : $O"
  log_line "    harness   : $HARNESS (from $HARNESS_SRC)"

  log_line ""
  log_line "==> 1/4 the pin, and whether it is the dir the controller READS"
  hu_verify_pin; pin_rc=$?
  case "$pin_rc" in
    0|4) : ;;
    *) die "REFUSED: the resolved pin is not the tree the controller would read (see pin: above). Nothing was started." 3 ;;
  esac

  log_line ""
  log_line "==> 2/4 capacity: what THIS box may carry, measured now (never a fixed cap)"
  cap="$(hu_capacity 2>&1)"; cap_rc=$?
  if [ "$cap_rc" -ne 0 ]; then
    # ⛔ A FIXED CAP IS NOT A FALLBACK. When the box cannot be MEASURED the decision refuses, and so
    # does the start: launching a controller whose capacity nobody could read is the "looks up" state
    # this whole surface exists against (cannot-verify is never a pass).
    log_line "    $(printf '%s' "$cap" | head -1)"
    die "REFUSED: this box's capacity could not be MEASURED (above), and a fixed lane cap is not a measurement. Nothing was started." 3
  fi
  log_line "    $(printf '%s' "$cap" | sed -n 's/^capacity //p')"
  cap_lanes="$(printf '%s' "$cap" | sed -n 's/.*[[:space:]]lanes=\([0-9]*\).*/\1/p' | head -1)"
  cap_fixed="$(printf '%s' "$cap" | sed -n 's/.*[[:space:]]fixed_ignored=\([^ ]*\).*/\1/p' | head -1)"
  log_line "    this box may carry ${cap_lanes:-?} lane(s) at the load and disk it just reported"
  # ⛔ REPORTED, NEVER USED. An operator (or a plist) may still carry a fixed `max_lanes`; saying so is
  # the difference between "the number I read" and "the number I was told", and only the first may
  # decide placement.
  if [ -n "$cap_fixed" ] && [ "$cap_fixed" != none ]; then
    warn "capacity: a FIXED lane cap is configured ($cap_fixed) — IGNORED as a ceiling: the ceiling here is load and disk, measured, and a constant cannot be a measurement"
  fi

  log_line ""
  log_line "==> 3/4 self-tests (a failure here refuses the start)"
  if [ "$SELFTEST" -eq 1 ]; then
    hu_run_selftests || die "REFUSED: a self-test failed (named above). Nothing was started — a red tree must not be started by the thing that is supposed to notice." 3
  else
    # Loud, because the operator just removed the only thing that checked this tree.
    warn "⛔ SELFTESTS SKIPPED BY REQUEST (--skip-selftest) — nothing verified this tree before the start"
  fi

  log_line ""
  log_line "==> roles: preflight + install (refuse before writing; idempotent)"
  if hr_available; then
    hr_install_roster || die "REFUSED: a role this box is configured to run could not be installed (named above) — nothing was started" 3
  else
    hr_missing_note
  fi

  log_line ""
  log_line "==> 4/4 components, in dependency order: $HU_COMPONENTS"
  for c in $HU_COMPONENTS; do
    # ⛔ `down` must not be undone by a partial `up`: each step is attempted, a failure stops the
    # walk (a later component depends on the earlier one), and everything already up is left up.
    if ! hu_start_component "$c"; then bad=1; log_line "    $c: FAILED — stopping the walk here (later components depend on it)"; break; fi
  done

  log_line ""
  [ "$bad" -eq 0 ] || die "started with failures — see the component lines above; nothing already up was stopped" 1
  # ⛔ RE-VERIFY THE PIN AFTER the components are up. A `restart-pending` above is closed by the start
  # materialising the pin; if it did not, the box is running code the pin does not name and saying
  # "up" would be the false success this whole check exists against.
  if [ "${HU_PIN_PENDING:-0}" = 1 ]; then
    log_line ""
    log_line "==> post-start pin check (the pin advanced before this launch)"
    hu_verify_pin 1 || die "DEGRADED: the pin still does not name the tree this box reads after the start — re-run after '$0 up', or check the materialiser" 1
  fi
  # ⛔ NO HEAL HERE: this start just brought every component up, so a heal pass could only re-invoke the
  # authority that just answered — and a second `start` is exactly the duplicate this file refuses.
  local _heal="$HEAL"; HEAL=0
  cmd_status; local _rc=$?
  HEAL="$_heal"
  return "$_rc"
}

cmd_down() {
  local rc=0
  log_line "==> harness-down ($PLATFORM) — stopping via the platform authority"
  if [ -f "$SELF_PATH/orchestrator-bringup.sh" ]; then
    hu_run "$BOUND" bash "$SELF_PATH/orchestrator-bringup.sh" stop || rc=$?
  else
    warn "no orchestrator-bringup.sh beside $SELF — falling back to the cell supervisor"
    [ "$PLATFORM" = cell ] && [ -f "$SELF_PATH/cloud-cell-supervisor.sh" ] && { hu_run "$BOUND" bash "$SELF_PATH/cloud-cell-supervisor.sh" stop || rc=$?; } || rc=1
  fi
  [ "$rc" -eq 0 ] || die "stop reported a problem (exit $rc) — read the output above" "$rc"
  log_line "down: ok"
  return 0
}

# ══ THE ROLE REGISTRY — installed, measured, healed, dispatched from HERE ═════════════════════════
# WHY (the owner's night, 2026-10-25): every piece of the harness existed and each looked fine, and
# three silent failures followed — the merge role was INSTALLED AND NEVER STARTED; a unit pointed at a
# `/tmp` cwd DIED EVERY TEN MINUTES for as long as a reclaim stood; and `status` read "installed" as
# if it were "ok" on three components that were dead. The five roles, their units on each platform,
# and their MEASURED-state readers live in ONE file (`harness-roles.sh`), sourced here, so this stays
# the entry point and there is still exactly one role registry.
# ⛔ RESOLUTION ORDER = WHERE THE BOX ACTUALLY RUNS, first: the harness the controller executes
# (`$HARNESS`), then the checkout beside this launcher, then `$O`. A cell runs the FARMED copy; reading
# the checkout's instead would measure (and install) a tree the box does not run.
# ⛔ AN ABSENT MODULE IS REPORTED, NEVER SILENTLY DEGRADED. A pre-registry `$O` (the state every
# deployed box is in until it is re-seeded) prints one named line telling the operator to re-seed, and
# nothing else changes — the verbs that need the registry refuse by name rather than pretending.
HARNESS_UP_OS="${HARNESS_UP_OS:-$(hp_os)}"
HR_MOD=""
for _hr_d in "$HARNESS" "$SELF_PATH/orchestrator-harness" "$O"; do
  [ -n "$_hr_d" ] || continue
  [ -f "$_hr_d/harness-roles.sh" ] && { HR_MOD="$_hr_d/harness-roles.sh"; break; }
done
if [ -n "$HR_MOD" ]; then
  # shellcheck source=/dev/null
  . "$HR_MOD"
fi
declare -f hr_status >/dev/null 2>&1 || HR_MOD=""

hr_available() { [ -n "${HR_MOD:-}" ]; }
hr_missing_note() {
  log_line "roles: SKIPPED (no harness-roles.sh in \$HARNESS, beside this launcher, or \$O — the ROLE registry is what installs, measures and heals them; re-seed with: bash scripts/orchestrator-harness/deploy-harness.sh --repo . --o $O)"
}
hr_need() { # <verb>
  hr_available && return 0
  hr_missing_note
  die "'$1' needs the role registry (harness-roles.sh) and it is not on this box — refusing rather than answering nothing" 2
}

# _hr_status_verb — the READ-ONLY role table (`roles`). `status` prints the same table and also heals,
# which is why this verb exists separately: `harness-status` promises a read.
_hr_status_verb() {
  hr_need roles
  log_line "roles (measured — a unit file is never evidence that a role runs; config: $(hr_roles))"
  hr_status
  return $?
}

_hr_logs_verb() { # <role> [n]
  hr_need logs
  hr_role_known "${1:-}" || die "logs: unknown role '${1:-}' (known: $(hr_all_roles))" 2
  hr_logs "$1" "${2:-40}"
  return $?
}

_hr_dispatch_verb() { # <role> [args…]
  hr_need dispatch
  hr_dispatch "$@"
}

# cmd_heal — re-drive what is dead. ⛔ THE EXIT CODE IS THE RE-READ, never the repair's: a start that
# returned 0 and left the role dead is exactly the class this verb exists to end.
cmd_heal() {
  local rrc=0 hr_rc=0
  hu_collect_rows
  hu_heal
  if [ -n "${HU_HEAL_NOTE:-}" ]; then
    log_line ""
    printf '%s\n' "$HU_HEAL_NOTE" | sed 's/^/    /'
    case "$HU_HEAL_NOTE" in *"HEAL FAILED"*|*"NOT HEALED"*) hr_rc=1 ;; esac
  fi
  log_line ""
  if hr_available; then
    log_line "roles: re-driving what is dead (config: $(hr_roles))"
    hr_heal || rrc=1
  else
    hr_missing_note
  fi
  log_line ""
  if [ "$rrc" -eq 0 ] && [ "$hr_rc" -eq 0 ]; then
    log_line "HEAL: every configured role is running, or is not applicable on this box"
    return 0
  fi
  log_line "HEAL INCOMPLETE — see NOT HEALED above; this exit is not a pass"
  return 1
}

# ONE row pass. ⛔ NOT IN A COMMAND SUBSTITUTION: every `hu_row*` appends to `$HU_ROWS`, so
# `HU_ROWS="$(hu_collect_rows)"` would drop every row into a subshell that ends immediately — the
# table would print while the verdict was lost (the class this file's own `lo_select` comment names).
ROW_VERDICT=0
_hu_take() { # <rc>
  case "${1:-0}" in
    2) ROW_VERDICT=2 ;;
    1) [ "$ROW_VERDICT" -lt 2 ] && ROW_VERDICT=1 ;;
  esac
}
hu_collect_rows() {
  local rc
  HU_ROWS=""; ROW_VERDICT=0
  # ── THE BRIEF'S FIVE QUESTIONS, IN ITS OWN ORDER ──────────────────────────────────────────────
  # 1 which sha is EXECUTING (not which is pinned); 2 is the loop alive; 3 is PLACEMENT healthy
  # (fork headroom → disk → load); 4 how many lanes and are they advancing; and the fifth — what it
  # would do next — is a row too, because prose beside the table is the thing operators stop reading.
  # ⛔ THE BOX ROW FIRST (from main): it says WHICH machine this answer is about and which PIN it is on.
  # A box with no pin is DEGRADED, so its verdict joins the same ONE verdict line as every other row.
  hu_row_box;        rc=$?; _hu_take "$rc"
  hu_row_exec;       rc=$?; _hu_take "$rc"
  hu_row_loop;       rc=$?; _hu_take "$rc"
  hu_row_capacity;   rc=$?; _hu_take "$rc"
  hu_row_lanes;      rc=$?; _hu_take "$rc"
  hu_row_selftest;   rc=$?; _hu_take "$rc"
  hu_row_next;       rc=$?; _hu_take "$rc"
  hu_row_launchd;    rc=$?; _hu_take "$rc"
  hu_row_refresh;    rc=$?; _hu_take "$rc"
  hu_row_claims;     rc=$?; _hu_take "$rc"
  hu_row_supervisor; rc=$?; _hu_take "$rc"
  hu_verify_pin >"$HU_TMP/pin.txt" 2>&1; rc=$?
  case "$rc" in 1) [ "$ROW_VERDICT" -lt 1 ] && ROW_VERDICT=1 ;; 2) ROW_VERDICT=2 ;; esac
  hu_row_drift
  rc=$?; _hu_take "$rc"
  return 0
}

cmd_status() {
  local healed=0
  hu_collect_rows
  # ⛔ SELF-TEST AND SELF-HEAL ARE PART OF STATUS, NOT A SEPARATE CEREMONY (the brief: status must
  # notice and heal). Healing runs only on the arms `hu_heal` documents as non-destructive, then the
  # rows are RE-READ so the table an operator reads is the POST-heal state — a table showing the
  # pre-heal state beside a "healed" line would make the reader doubt the one thing that worked.
  if [ "$HEAL" -eq 1 ]; then
    hu_heal
    if [ -n "$HU_HEAL_NOTE" ]; then healed=1; hu_collect_rows; fi
  fi
  sed 's/^/    /' "$HU_TMP/pin.txt"
  log_line ""
  if [ "$PLAIN" -eq 0 ]; then printf '%-12s %-10s %-6s %s\n' COMPONENT PID AGE STATE; fi
  printf '%s' "$HU_ROWS" | while IFS='|' read -r name pid age state; do
    [ -n "$name" ] || continue
    printf '%-12s %-10s %-6s %s\n' "$name" "${pid:--}" "${age:--}" "$state"
  done
  if [ "$healed" -eq 1 ]; then
    log_line ""
    printf '%s\n' "$HU_HEAL_NOTE" | sed 's/^/    /'
  fi
  # ── THE ROLE TABLE (the roles the box is configured to run), MEASURED ────────────────────────
  # ⛔ WHY THIS IS A SECOND TABLE AND NOT ONE MORE ROW. The rows above answer "is the harness
  # dispatching, on which tree, with how much capacity". They cannot answer "would this box ever RUN
  # the merge/apply/watchdog roles at all": a role with NO unit is invisible to every row, which is how
  # three components read installed and were dead. This table answers that, from each role's OWN
  # artefact, and its verdict is folded into the ONE verdict line rather than printed as a second one.
  # A SKIPPED role (no unit on this platform) is a PASS with a reason — never OK.
  log_line ""
  if hr_available; then
    log_line "roles (config: $(hr_roles)):"
    hr_status; _role_rc=$?
    _hu_take "$_role_rc"
  else
    hr_missing_note
  fi
  log_line ""
  case "$ROW_VERDICT" in
    0) log_line "VERDICT: HEALTHY";  return 0 ;;
    1) log_line "VERDICT: DEGRADED — a component is late/absent or the deployed tree has diverged; see the rows above"; return 1 ;;
    *) log_line "VERDICT: BROKEN — something could not be verified, and cannot-verify is never a pass; see the rows above"; return 2 ;;
  esac
}

# ⛔ THROUGH THE SHIM: BSD `mktemp` requires a TEMPLATE (`mktemp -d` alone is a usage error on macOS),
# so the untemplated call was a Mac-only death at the last line of this file.
HU_TMP="$(hp_mktemp_d)" || die "cannot create a temp dir (TMPDIR unset, full or read-only) — nothing is verifiable here" 2
trap 'rm -rf "$HU_TMP"' EXIT

if [ -n "$REPO_BAD" ] && [ "$VERB" != up ]; then
  warn "$REPO_BAD — continuing, because '$VERB' starts nothing (a box with a stale REPO must still be stoppable)"
fi
if [ -n "$HREPO_BAD" ] && [ "$VERB" != up ]; then
  warn "$HREPO_BAD — continuing, because '$VERB' reads no harness (a box with an unresolvable harness must still be stoppable)"
fi
case "$VERB" in
  up)       cmd_up ;;
  down)     cmd_down ;;
  status)   cmd_status ;;
  roles)    _hr_status_verb ;;
  heal)     cmd_heal ;;
  logs)     _hr_logs_verb "$A_ROLE" ;;
  dispatch) _hr_dispatch_verb "$A_ROLE" $REST_ARGS ;;
  *)        die "unknown verb '$VERB'" ;;
esac
