<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- hub-state-check (#1484): every 6h verify the shared main checkout stays
         on main+clean; on FAIL, open/comment one deduped GitHub issue with the
         sanctioned recovery command. Canonical script:
         agent-infra/scripts/checkout-hygiene/hub-state-check.sh (installed to
         ~/.pi/agent/scripts/checkout-hygiene/ — the corruption-canary
         convention). Tortoise only: agent-infra is the #99 in-main-work repo
         and is exempt from the hub discipline (its dirt is normal). -->
    <key>Label</key>
    <string>com.eldato.hub-state-check</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>bash</string>
        <string>/Users/danielospina/.pi/agent/scripts/checkout-hygiene/hub-state-check.sh</string>
        <string>--repo</string>
        <string>/Users/danielospina/Documents/GitHub/tortoise</string>
        <string>--gh-report</string>
    </array>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>StandardOutPath</key>
    <string>/tmp/hub-state-check.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hub-state-check.log</string>
</dict>
</plist>
