{
  "$schema": "loop-enforcer-patterns/1",
  "description": "Union pattern set covering all task types (code, content, research, strategy, design). 8 exit patterns + 5 issues-fixed patterns. Applied to last assistant message in agent_end.",
  "exit": [
    {
      "name": "no-issues-found",
      "pattern": "NO\\s+ISSUES\\s+FOUND",
      "flags": "i",
      "description": "Standard review verdict — clean exit across all task types"
    },
    {
      "name": "clean-verdict",
      "pattern": "verdict[\"'\\s:]*(?:CLEAN|clean)|(?:CLEAN|clean)[\"'\\s:]*verdict",
      "flags": "i",
      "description": "Structured verdict JSON or explicit CLEAN declaration"
    },
    {
      "name": "all-checks-passed",
      "pattern": "all\\s+(?:checks?|tests?|gates?)\\s+(?:pass|passed|green|clean)",
      "flags": "i",
      "description": "Deterministic gate completion across all task types"
    },
    {
      "name": "ready-to-merge",
      "pattern": "ready\\s+to\\s+merge|merge\\s+ready|PR\\s+ready|ready\\s+for\\s+review",
      "flags": "i",
      "description": "Code task completion signal"
    },
    {
      "name": "review-passed",
      "pattern": "review\\s+(?:passed|complete|clean|done)|all\\s+reviewers?\\s+(?:passed|clean|done)",
      "flags": "i",
      "description": "Review cycle completion — all reviewers clean"
    },
    {
      "name": "content-delivered",
      "pattern": "content\\s+(?:is\\s+)?(?:ready|complete|final|delivered)|deliverable\\s+(?:is\\s+)?(?:ready|complete)",
      "flags": "i",
      "description": "Content/research/strategy task completion"
    },
    {
      "name": "task-complete",
      "pattern": "✅|Task complete|Done\\.(?:\\s|$)|File\\s+created\\s+and\\s+verified|goal\\s+(?:achieved|complete|met)",
      "flags": "i",
      "description": "Simple task completion signals — agent claims done with evidence. Placed last so more specific patterns (no-issues-found, clean-verdict) take priority."
    }
  ],
  "issues_fixed": [
    {
      "name": "fixed-n-issues",
      "pattern": "(?:fixed|resolved|addressed|closed)\\s+\\d+\\s+issues?",
      "flags": "i",
      "description": "Explicit issue count fix statement"
    },
    {
      "name": "re-reviewing",
      "pattern": "re-?reviewing|re-?running\\s+review|applying\\s+fixes?\\s+and\\s+re-?",
      "flags": "i",
      "description": "Agent signals it's in another review cycle"
    },
    {
      "name": "issues-addressed",
      "pattern": "issues?\\s+(?:have\\s+been\\s+)?(?:addressed|resolved|fixed|corrected|handled)",
      "flags": "i",
      "description": "Issues addressed statement (possibly without count)"
    },
    {
      "name": "continuing-loop",
      "pattern": "continuing\\s+(?:the\\s+)?loop|next\\s+cycle|another\\s+(?:cycle|iteration|pass)",
      "flags": "i",
      "description": "Loop continuation signal"
    },
    {
      "name": "feedback-applied",
      "pattern": "feedback\\s+(?:applied|incorporated|addressed)|fixes?\\s+(?:applied|committed|pushed)",
      "flags": "i",
      "description": "Feedback application signal"
    }
  ]
}
